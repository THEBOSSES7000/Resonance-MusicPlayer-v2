export function showConfirmDialog({ title = "¿Estás seguro?", message = "", confirmText = "Aceptar", cancelText = "Cancelar", showCancel = true, alternateText = null }) {
  return new Promise((resolve) => {
    confirmModalTitle.textContent = title;
