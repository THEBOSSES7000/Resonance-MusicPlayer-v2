import { state, formatTime, incrementPlayCount, resolveCoverUrl, resolveAudioUrl, getSongByIdOrPath } from './state.js';
import { renderQueue, updateFavIcon, ensureSongMetadata, updateLyricsUI, updateSyncedLyricsProgress, closeLyricsView, renderHistoryUI, syncPlayingUI, renderGrids, showConfirmDialog, navigateToView, persistPlaybackSession } from './ui.js';

const primaryAudio = new Audio();
const secondaryAudio = new Audio();
export let audio = primaryAudio;
const audioDecks = [primaryAudio, secondaryAudio];

// ——— Fase 1: audio nativo (Tauri / Rust) ———
const nativeAudioEnabled = Boolean(window.__TAURI__?.core?.invoke);
let nativeAudioActive = false;
let nativePollTimer = null;
let nativeLastEnded = false;
/** Energía RMS (0–1) recibida desde Rust vía evento `audio-energy` (Visual+). */
let nativeAudioEnergy = 0;
let nativeEnergyUnlisten = null;
let nativeShadow = {
  paused: true,
  currentTime: 0,
  duration: 0,
  path: null
};
/** Reloj de pared del último status nativo (para interpolar posición entre polls). */
let nativePositionSampleMs = 0;

/** Suscribe al evento de energía del motor nativo (una sola vez). */
function ensureNativeEnergyListener() {
  if (nativeEnergyUnlisten || !window.__TAURI__?.event?.listen) return;
  void window.__TAURI__.event.listen('audio-energy', event => {
    const value = Number(event.payload);
    nativeAudioEnergy = Number.isFinite(value) ? Math.max(0, Math.min(1, value)) : 0;
  }).then(unlisten => {
    nativeEnergyUnlisten = unlisten;
  }).catch(() => {});
}
ensureNativeEnergyListener();

function canUseNativeAudio(track) {
  if (!nativeAudioEnabled) return false;
  const path = track?.file?.path || track?.path;
  return Boolean(path && typeof path === 'string' && !path.startsWith('blob:'));
}

async function nativeInvoke(cmd, args = {}) {
  return window.__TAURI__.core.invoke(cmd, args);
}

function stopNativeProgressPoll() {
  if (nativePollTimer) {
    clearInterval(nativePollTimer);
    nativePollTimer = null;
  }
}

function applyNativeStatusToUi(st, { fromEnded = false } = {}) {
  if (!st) return;
  nativeShadow.paused = !st.playing;
  nativeShadow.currentTime = st.positionSeconds || 0;
  nativeShadow.duration = st.durationSeconds || 0;
  nativeShadow.path = st.path || null;
  nativePositionSampleMs = performance.now();

  // Icono de crossfade según el motor nativo
  const wasCrossfading = crossfadeVisualActive;
  if (st.crossfading) {
    crossfadeVisualActive = true;
    crossfadeInProgress = true;
    updateCrossfadeIndicator();
  } else if (wasCrossfading && crossfadeInProgress) {
    // El motor terminó el fundido
    crossfadeVisualActive = false;
    crossfadeInProgress = false;
    updateCrossfadeIndicator();
  }

  if (!isSeeking) {
    updateProgressTimes(nativeShadow.currentTime, nativeShadow.duration || 0);
    if (nativeShadow.duration > 0) {
      const ratio = nativeShadow.currentTime / nativeShadow.duration;
      setProgressVisual(ratio);
      progressContainer?.setAttribute('aria-valuenow', String(Math.round(ratio * 100)));
    }
  }
  if (state.isLyricsOpen) {
    updateSyncedLyricsProgress(nativeShadow.currentTime);
  }
  updateWindowsMediaPlayback(Boolean(st.playing));
  updateWindowsMediaPosition(true);
  notifyDiscordPresence();

  // Disparo automático de crossfade cerca del final (modo nativo)
  if (
    !fromEnded &&
    !st.ended &&
    st.playing &&
    !st.crossfading &&
    !crossfadeInProgress &&
    crossfadeEnabled
  ) {
    maybeStartNativeCrossfade(st);
  }

  if (st.ended && !nativeLastEnded && !fromEnded) {
    nativeLastEnded = true;
    handleNativeTrackEnded();
  } else if (!st.ended) {
    nativeLastEnded = false;
  }
}

/** Si queda poco de la pista y hay siguiente, inicia crossfade nativo (fin natural). */
function maybeStartNativeCrossfade(st) {
  const remaining = (st.durationSeconds || 0) - (st.positionSeconds || 0);
  if (!(remaining > 0) || remaining > crossfadeDuration + 0.05) return;
  const hasQueuedNext =
    state.repeatMode !== 'one' && state.currentTrackIndex + 1 < state.activeQueue.length;
  if (!hasQueuedNext) return;
  // Solo fin natural: always true here (poll near end)
  void crossfadeToNext(state.currentTrackIndex + 1);
}

function startNativeProgressPoll() {
  stopNativeProgressPoll();
  nativePollTimer = setInterval(() => {
    if (!nativeAudioActive) return;
    nativeInvoke('native_audio_status')
      .then(st => applyNativeStatusToUi(st))
      .catch(() => {});
  }, 250);
}

function handleNativeTrackEnded() {
  // No apagar nativeAudioActive todavía: loadSong de la siguiente lo reconfigura
  if (state.currentTrackIndex !== -1 && state.activeQueue[state.currentTrackIndex]) {
    try {
      const currentTrack = state.activeQueue[state.currentTrackIndex];
      incrementPlayCount(currentTrack);
      renderGrids();
    } catch (_) {}
  }
  try {
    if (handleSleepTimerTrackEnd()) return;
  } catch (_) {}
  if (localStorage.getItem('pn_playback_continuous') !== 'false' || state.repeatMode !== 'off') {
    void nextSong(true);
    return;
  }
  stopNativeProgressPoll();
  void nativeInvoke('native_audio_pause').catch(() => {});
  nativeShadow.paused = true;
  playIcon.className = 'ph-fill ph-play';
  syncPlayingUI(false);
  updateWindowsMediaPlayback(false);
}

async function nativeLoadTrack(track, autoPlay) {
  const path = track.file?.path || track.path;
  const vol = typeof masterVolume === 'number' ? masterVolume : 0.8;
  // Silenciar decks HTML para no duplicar audio en el mezclador
  audioDecks.forEach(deck => {
    try {
      deck.pause();
      deck.removeAttribute('src');
      deck.src = '';
      deck.volume = 0;
    } catch (_) {}
  });
  const fadeIn = autoPlay ? nativeFadeInSecs() : 0;
  const st = await nativeInvoke('native_audio_load', {
    path,
    autoPlay: Boolean(autoPlay),
    volume: vol,
    fadeInSecs: fadeIn
  });
  nativeAudioActive = true;
  nativeLastEnded = false;
  applyNativeStatusToUi(st);
  if (autoPlay) startNativeProgressPoll();
  else stopNativeProgressPoll();
  // Duración en la pista
  if (st.durationSeconds > 0) {
    track.duration = st.durationSeconds;
  }
  return st;
}

async function nativeTogglePlay() {
  if (!nativeAudioActive) return false;
  if (nativeShadow.paused) {
    // Reanudar: SIN fade-in (el fade-in solo aplica al cargar pista nueva)
    const st = await nativeInvoke('native_audio_play', { fadeInSecs: 0 });
    applyNativeStatusToUi(st);
    startNativeProgressPoll();
    playIcon.className = 'ph-fill ph-pause';
    syncPlayingUI(true);
  } else {
    if (crossfadeInProgress) cancelCrossfade();
    // Pausar: fade-out solo si el usuario lo activó en ajustes
    const st = await nativeInvoke('native_audio_pause', { fadeOutSecs: 0 });
    applyNativeStatusToUi(st);
    playIcon.className = 'ph-fill ph-play';
    syncPlayingUI(false);
  }
  return true;
}

async function nativeSeek(seconds) {
  if (!nativeAudioActive) return false;
  try {
    const st = await nativeInvoke('native_audio_seek', { positionSeconds: Number(seconds) || 0 });
    applyNativeStatusToUi(st);
    updateWindowsMediaPosition(true);
    return true;
  } catch (error) {
    console.error('nativeSeek:', error);
    return false;
  }
}

async function nativeSetVolume(vol01) {
  if (!nativeAudioEnabled) return;
  try {
    await nativeInvoke('native_audio_set_volume', { volume: Math.max(0, Math.min(1, vol01)) });
  } catch (_) {}
}

function nativeFadeInSecs() {
  if (!playbackFadeInEnabled) return 0;
  const d = Number(playbackFadeInDuration);
  if (!Number.isFinite(d) || d <= 0) return 0;
  return Math.max(0.05, Math.min(5, d));
}

function nativeFadeOutSecs() {
  if (!playbackFadeOutEnabled) return 0;
  const d = Number(playbackFadeOutDuration);
  if (!Number.isFinite(d) || d <= 0) return 0;
  return Math.max(0.05, Math.min(5, d));
}

/** Posición / pausa / duración unificadas (HTML o nativo). */
export function getPlaybackPosition() {
  if (nativeAudioActive) {
    let t = nativeShadow.currentTime || 0;
    // Interpolar entre polls (~250 ms) para que las letras sofisticadas avancen fluido
    if (!nativeShadow.paused && nativePositionSampleMs > 0) {
      t += (performance.now() - nativePositionSampleMs) / 1000;
      const dur = nativeShadow.duration || 0;
      if (dur > 0) t = Math.min(t, dur);
    }
    return Math.max(0, t);
  }
  return Number.isFinite(audio.currentTime) ? audio.currentTime : 0;
}

export function getPlaybackDuration() {
  if (nativeAudioActive) return nativeShadow.duration || 0;
  return Number.isFinite(audio.duration) ? audio.duration : 0;
}

export function isPlaybackPaused() {
  if (nativeAudioActive) return Boolean(nativeShadow.paused);
  return Boolean(audio.paused);
}

/** Seek unificado: barra de progreso, letras, SMTC, atajos. */
export async function seekPlayback(seconds) {
  const dur = getPlaybackDuration();
  let dest = Number(seconds) || 0;
  if (dur > 0) dest = Math.max(0, Math.min(dur, dest));
  else dest = Math.max(0, dest);
  if (nativeAudioActive) {
    await nativeSeek(dest);
    return;
  }
  if (Number.isFinite(audio.duration) && audio.duration > 0) {
    audio.currentTime = dest;
    updateProgressTimes(audio.currentTime, audio.duration);
    setProgressVisual(audio.duration ? audio.currentTime / audio.duration : 0);
    updateWindowsMediaPosition(true);
  }
}

