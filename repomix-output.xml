/**
 * Configura modo de onda (bars | smooth) y tiempos debajo.
 * La resolución es fija (WAVEFORM_PEAK_COUNT); ya no se elige cantidad de barras.
 * Compat: si el 1.er arg es número (API antigua), se ignora.
 */
export function configureProgressWaveform(modeOrCount, modeMaybe, splitTimesMaybe) {
  let mode;
  let splitTimes;
  if (typeof modeOrCount === 'string') {
    mode = modeOrCount;
    splitTimes = modeMaybe;
  } else {
    // Llamadas antiguas: (count, mode, splitTimes)
    mode = modeMaybe;
    splitTimes = splitTimesMaybe;
  }
  waveformBarCount = WAVEFORM_PEAK_COUNT;
  waveformMode = mode === 'smooth' ? 'smooth' : 'bars';
  showRemainingTime = Boolean(splitTimes);
  progressContainer.dataset.waveformMode = waveformMode;
  playbackBar?.classList.toggle(
    'is-waveform-split',
    showRemainingTime && progressContainer.dataset.progressStyle === 'waveform'
  );
  updatePlayerMinimumHeight();
  initializeProgressWaveforms();
  updateProgressTimes();
  const track = state.currentTrackIndex >= 0 ? state.activeQueue[state.currentTrackIndex] : null;
  if (track && progressContainer.dataset.progressStyle === 'waveform') {
    void loadWaveformForTrack(track);
  }
}

export function setProgressStyle(style) {
  progressContainer.dataset.progressStyle = style;
  playbackBar?.classList.toggle('is-waveform-split', showRemainingTime && style === 'waveform');
  updatePlayerMinimumHeight();
  updateProgressTimes();
  if (style === 'waveform') {
    const track = state.currentTrackIndex >= 0 ? state.activeQueue[state.currentTrackIndex] : null;
    if (track) void loadWaveformForTrack(track);
    else initializeProgressWaveforms();
  }
}

function updateSeekPosition(clientX, { commit = false } = {}) {
  const dur = getPlaybackDuration();
  if (!Number.isFinite(dur) || dur <= 0) return;
  const rect = progressContainer.getBoundingClientRect();
  if (rect.width <= 0) return;
  const ratio = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
  const dest = ratio * dur;
  pendingSeekSeconds = dest;
  setProgressVisual(ratio);
  progressContainer.setAttribute('aria-valuenow', String(Math.round(ratio * 100)));
  updateProgressTimes(dest, dur);
  // Solo aplicar el seek real al soltar (commit), no en cada pixel del arrastre
  if (commit) {
    if (nativeAudioActive) {
      void seekPlayback(dest);
    } else if (Number.isFinite(audio.duration) && audio.duration > 0) {
      audio.currentTime = dest;
    }
  }
}


