/** Carga carátulas de filas solo cuando entran al viewport (ahorra RAM al scrollear). */
const lazyCoverObserver = typeof IntersectionObserver === 'function'
  ? new IntersectionObserver((entries) => {
      for (const entry of entries) {
        const img = entry.target;
        if (entry.isIntersecting) {
          const src = img.dataset.coverSrc;
          if (src && !img.hasAttribute('src')) img.src = src;
        } else if (img.hasAttribute('src')) {
          img.removeAttribute('src');
        }
      }
    }, { root: null, rootMargin: '300px 0px', threshold: 0.01 })
  : null;

function bindLazyCover(img, song) {
  if (!img || !song) return;
  const src = resolveCoverUrl(song);
  if (!src) return;
  img.alt = song.title || '';
  if (lazyCoverObserver) {
    img.dataset.coverSrc = src;
    img.loading = 'lazy';
    img.decoding = 'async';
    lazyCoverObserver.observe(img);
  } else {
    img.loading = 'lazy';
    img.decoding = 'async';
    img.src = src;
  }
}

