async function exportCollectionM3U8(collection, filenameOverride = null, showError = true) {
  try {
    const lines = ['#EXTM3U'];
    collection.songs.forEach(song => {
      const fileLocation = song.file?.path || song.file?.webkitRelativePath || song.file?.name;
      if (!fileLocation) return;
      const duration = Number.isFinite(song.duration) && song.duration > 0
        ? Math.round(song.duration)
        : -1;
      const trackName = [song.artist, song.title].filter(Boolean).join(' - ').replace(/[\r\n]/g, ' ');
      lines.push(`#EXTINF:${duration},${trackName}`, fileLocation.replace(/[\r\n]/g, ''));
    });

    if (lines.length === 1) {
      throw new Error('No hay rutas de archivo disponibles para exportar esta lista.');
    }

    const safeName = (filenameOverride || collection.title).replace(/[<>:"/\\|?*\x00-\x1F]/g, '_').trim() || 'playlist';
    const fileName = `${safeName}.m3u8`;
    const contents = `\uFEFF${lines.join('\r\n')}\r\n`;
    const invoke = window.__TAURI__?.core?.invoke;

    if (invoke) {
      return await invoke('save_m3u8_file', { fileName, contents });
    }

    if (typeof window.showSaveFilePicker !== 'function') {
      throw new Error('Este entorno no ofrece un diálogo para elegir dónde guardar archivos.');
    }
    const fileHandle = await window.showSaveFilePicker({
      suggestedName: fileName,
      types: [{
        description: 'Playlist M3U8',
        accept: { 'audio/x-mpegurl': ['.m3u8'] }
      }]
    });
    const writable = await fileHandle.createWritable();
    await writable.write(new TextEncoder().encode(contents));
    await writable.close();
    return true;
  } catch (error) {
    if (error instanceof DOMException && error.name === 'AbortError') return false;
    console.error('No se pudo exportar la lista:', error);
    if (showError) {
      await showConfirmDialog({
        title: 'No se pudo exportar',
        message: error instanceof Error ? error.message : 'Ocurrió un error al crear el archivo de playlist.',
        confirmText: 'Entendido',
        showCancel: false
      });
    }
    return null;
  }
}

export function openPlaylistExportPicker() {
  if (!state.playlists.length) {
    void showConfirmDialog({
      title: 'No hay playlists',
      message: 'Crea una playlist antes de exportar.',
      confirmText: 'Aceptar',
      showCancel: false
    });
    return;
  }

  const modal = document.getElementById('playlist-export-modal');
  const options = document.getElementById('playlist-export-options');
  const selectAllButton = document.getElementById('playlist-export-select-all');
  const exportButton = document.getElementById('playlist-export-confirm');
  const cancelButton = document.getElementById('playlist-export-cancel');
  const closeButton = document.getElementById('playlist-export-close');
  if (!modal || !options || !selectAllButton || !exportButton || !cancelButton || !closeButton) return;

  options.replaceChildren();
  state.playlists.forEach(playlist => {
    const label = document.createElement('label');
    label.className = 'multi-playlist-option';
    const checkbox = document.createElement('input');
    checkbox.type = 'checkbox';
    checkbox.value = String(playlist.id);
    const thumbnail = document.createElement('span');
    thumbnail.className = 'playlist-picker-thumb';
    if (playlist.coverUrl) {
      const image = document.createElement('img');
      image.src = playlist.coverUrl;
      image.alt = '';
      thumbnail.appendChild(image);
    } else {
      const icon = document.createElement('i');
      icon.className = 'ph ph-playlist';
      thumbnail.appendChild(icon);
    }
    const name = document.createElement('span');
    name.className = 'playlist-picker-name';
    name.textContent = playlist.title;
    label.append(checkbox, thumbnail, name);
    options.appendChild(label);
  });

  const selectedCheckboxes = () => [...options.querySelectorAll('input[type="checkbox"]')];
  const updateSelectionControls = () => {
    const checkboxes = selectedCheckboxes();
    const allSelected = checkboxes.length > 0 && checkboxes.every(checkbox => checkbox.checked);
    selectAllButton.textContent = allSelected ? 'Deseleccionar todas' : 'Seleccionar todas';
    exportButton.disabled = !checkboxes.some(checkbox => checkbox.checked);
  };
  const close = () => {
    modal.classList.remove('open');
    selectAllButton.removeEventListener('click', toggleAll);
    exportButton.removeEventListener('click', exportSelected);
    cancelButton.removeEventListener('click', close);
    closeButton.removeEventListener('click', close);
    options.removeEventListener('change', updateSelectionControls);
    modal.removeEventListener('click', onBackdropClick);
    document.removeEventListener('keydown', onKeyDown);
  };
  const toggleAll = () => {
    const checkboxes = selectedCheckboxes();
    const shouldSelectAll = checkboxes.some(checkbox => !checkbox.checked);
    checkboxes.forEach(checkbox => { checkbox.checked = shouldSelectAll; });
    updateSelectionControls();
  };
  const exportSelected = async () => {
    const selectedIds = new Set(
      selectedCheckboxes().filter(checkbox => checkbox.checked).map(checkbox => checkbox.value)
    );
    const selectedPlaylists = state.playlists.filter(playlist => selectedIds.has(String(playlist.id)));
    if (!selectedPlaylists.length) return;
    close();

    const titleCounts = new Map();
    let exportedCount = 0;
    let failedCount = 0;
    let cancelled = false;
    for (const playlist of selectedPlaylists) {
      const baseTitle = playlist.title || 'playlist';
      const occurrence = (titleCounts.get(baseTitle) || 0) + 1;
      titleCounts.set(baseTitle, occurrence);
      const filename = occurrence > 1 ? `${baseTitle} (${occurrence})` : baseTitle;
      const result = await exportCollectionM3U8({
        title: baseTitle,
        songs: playlist.smartFilter ? getSmartPlaylistSongs(playlist) : (playlist.songs || [])
      }, filename, false);
      if (result === true) {
        exportedCount += 1;
      } else if (result === false) {
        cancelled = true;
        break;
      } else {
        failedCount += 1;
      }
    }
    if ((cancelled || failedCount > 0) && (exportedCount > 0 || failedCount > 0)) {
      void showConfirmDialog({
        title: cancelled ? 'Exportación cancelada' : 'Exportación incompleta',
        message: `Se exportaron ${exportedCount} playlists${failedCount ? ` y ${failedCount} no se pudieron exportar` : ''}${cancelled ? '. Se canceló el guardado de las siguientes playlists' : ''}.`,
        confirmText: 'Entendido',
        showCancel: false
      });
    }
  };
  const onBackdropClick = event => {
    if (event.target === modal) close();
  };
  const onKeyDown = event => {
    if (event.key === 'Escape') close();
  };

  selectAllButton.addEventListener('click', toggleAll);
  exportButton.addEventListener('click', exportSelected);
  cancelButton.addEventListener('click', close);
  closeButton.addEventListener('click', close);
  options.addEventListener('change', updateSelectionControls);
  modal.addEventListener('click', onBackdropClick);
  document.addEventListener('keydown', onKeyDown);
  updateSelectionControls();
  modal.classList.add('open');
}

function appendCollectionToQueue(collection) {
  if (state.activeQueue.length === 0 || state.currentTrackIndex === -1) {
    playFromContext(collection.songs, 0, collection.title, true, collection.contextId, true);
    return;
  }
  const tracks = collection.songs.map(song => ({ ...song, isEnqueuedNext: false }));
  state.activeQueue.push(...tracks);
  renderQueue();
}

/* RENDERIZADO DE LAS PLAYLISTS EN LA BARRA LATERAL (ACCESO DIRECTO) */
function quickSongReference(song) {
  return {
    path: song.file?.path || '',
    relativePath: song.file?.webkitRelativePath || '',
    fileName: song.file?.name || '',
    title: song.title || '',
    artist: song.artist || ''
  };
}

function sameQuickSongReference(reference, song) {
  const songReference = quickSongReference(song);
  if (reference.path && songReference.path) {
    return reference.path.replace(/\\/g, '/').toLocaleLowerCase() ===
      songReference.path.replace(/\\/g, '/').toLocaleLowerCase();
  }
  if (reference.relativePath && songReference.relativePath) {
    return reference.relativePath.replace(/\\/g, '/').toLocaleLowerCase() ===
      songReference.relativePath.replace(/\\/g, '/').toLocaleLowerCase();
  }
  return reference.fileName === songReference.fileName &&
    reference.title === songReference.title &&
    reference.artist === songReference.artist;
}

function renderQuickAccessEntries() {
  const entries = Array.isArray(state.quickAccess) ? state.quickAccess : [];
  entries.forEach(entry => {
    let title;
    let subtitle;
    let iconClass;
    let target;

    if (entry.type === 'song') {
      target = state.localMusicFiles.find(song => sameQuickSongReference(entry, song));
      if (!target) return;
      title = target.title || 'Sin título';
      subtitle = target.artist || 'Desconocido';
      iconClass = 'ph ph-music-note';
    } else if (entry.type === 'folder') {
      target = state.configuredFolders?.find(folder => folder.name === entry.name);
      if (!target) return;
      title = target.name;
      subtitle = `${target.count || 0} canciones`;
      iconClass = 'ph ph-folder';
    } else {
      return;
    }

    const el = document.createElement('div');
    el.className = 'playlist-card-left quick-access-item';
    el.dataset.quickType = entry.type;
    el.dataset.quickKey = entry.type === 'folder' ? entry.name : JSON.stringify(entry);
    if (entry.type === 'folder') el.dataset.folderId = target.id;

    const thumb = document.createElement('div');
    thumb.className = 'playlist-thumb-box';
    const icon = document.createElement('i');
    icon.className = iconClass;
    thumb.appendChild(icon);

    const meta = document.createElement('span');
    meta.className = 'playlist-sidebar-title quick-access-title';
    meta.textContent = title;

    const wave = document.createElement('div');
    wave.className = 'sidebar-soundwave-wrap';
    const isPlaying = entry.type === 'song'
      ? state.activeContextId === `quick_song_${target.id}`
      : state.activeContextId === `folder_${target.id}`;
    if (isPlaying) {
      el.classList.add('is-playing-origin');
      wave.innerHTML = getSoundWaveHTML(audio.paused);
    }
    el.append(thumb, meta, wave);
    el.addEventListener('click', () => {
      if (entry.type === 'folder') {
        navigateToView('folder-detail', { folderId: target.id });
        return;
      }
      playFromContext([target], 0, target.title || 'Canción', true, `quick_song_${target.id}`);
    });
    playlistsContainer.appendChild(el);
  });
}

export function renderPlaylistsUI() {
  playlistsContainer.innerHTML = '';

  let list = state.playlists.filter(pl => pl.isPinned !== false);

  if (state.playlistSortMode === 'alpha') {
    list.sort((a, b) => a.title.localeCompare(b.title));
  } else if (state.playlistSortMode === 'count') {
    list.sort((a, b) => getPlaylistSongs(b).length - getPlaylistSongs(a).length);
  } else if (state.playlistSortMode === 'recent') {
    list.sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0));
  }

  list.forEach((pl, index) => {
    const el = document.createElement('div');
    el.className = 'playlist-card-left';
    el.dataset.id = pl.id;
    el.dataset.index = index;

    const isThisPlaylistPlaying = state.activeContextId === ('playlist_' + pl.id);
    if (isThisPlaylistPlaying) {
      el.classList.add('is-playing-origin');
    }

    if (state.playlistSortMode === 'custom') {
      el.draggable = true;

      el.addEventListener('dragstart', (e) => {
        draggedPlaylistId = String(pl.id);
        isDragging = true;
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', draggedPlaylistId);
        requestAnimationFrame(() => {
          el.classList.add('dragging');
        });
      });

      el.addEventListener('dragover', (e) => {
        if (draggedPlaylistId === null) return;
        e.preventDefault();
        e.stopPropagation();
        e.dataTransfer.dropEffect = 'move';

        if (draggedPlaylistId !== String(pl.id)) {
          document.querySelectorAll('.playlist-card-left').forEach(c => {
            if (c !== el) c.classList.remove('drag-over');
          });
          el.classList.add('drag-over');
        }
      });

      el.addEventListener('dragleave', (e) => {
        const rect = el.getBoundingClientRect();
        if (e.clientX <= rect.left || e.clientX >= rect.right || e.clientY <= rect.top || e.clientY >= rect.bottom) {
          el.classList.remove('drag-over');
        }
      });

      el.addEventListener('drop', (e) => {
        e.preventDefault();
        e.stopPropagation();
        el.classList.remove('drag-over');

        if (draggedPlaylistId !== null && draggedPlaylistId !== String(pl.id)) {
          const insertAfter = e.clientY > el.getBoundingClientRect().top + el.offsetHeight / 2;
          reorderPinnedPlaylists(draggedPlaylistId, pl.id, insertAfter);
        }
        cleanupDragState();
      });

      el.addEventListener('dragend', cleanupDragState);
    }

    const thumbHtml = pl.coverUrl
      ? `<img src="${pl.coverUrl}" alt="${pl.title}" class="pl-thumb-img" />`
      : `<i class="ph ph-playlist"></i>`;

    el.innerHTML = `
      <div class="playlist-thumb-box">${thumbHtml}</div>
      <span class="playlist-sidebar-title-row">
        <span class="playlist-sidebar-title">${pl.title}</span>
        ${pl.smartFilter ? '<i class="ph ph-lightning smart-playlist-badge" title="Playlist dinámica" aria-label="Playlist dinámica"></i>' : ''}
      </span>
      <div class="sidebar-soundwave-wrap">
        ${isThisPlaylistPlaying ? getSoundWaveHTML(audio.paused) : ''}
      </div>
    `;

    el.addEventListener('click', (e) => {
      if (isDragging) {
        e.preventDefault();
        return;
      }
      navigateToView('playlist', { playlistId: pl.id });
    });

    playlistsContainer.appendChild(el);
  });
  renderQuickAccessEntries();
}

export function updateLyricsUI() {
  const currentTrack = state.currentTrackIndex >= 0 ? state.activeQueue[state.currentTrackIndex] : null;
  if (currentTrack && !currentTrack.lyricsLoaded) {
    void ensureSongLyrics(currentTrack).then(() => {
      if (state.activeQueue[state.currentTrackIndex] === currentTrack) updateLyricsUI();
    });
  }
  const miniPlayerCover = document.getElementById('lyrics-focus-mini-cover');
  const miniPlayerTitle = document.getElementById('lyrics-focus-mini-title');
  const miniPlayerArtist = document.getElementById('lyrics-focus-mini-artist');
  const miniPlayerAlbum = document.getElementById('lyrics-focus-mini-album');
  const updateMiniPlayer = current => {
    if (!miniPlayerCover || !miniPlayerTitle || !miniPlayerArtist || !miniPlayerAlbum) return;
    miniPlayerTitle.textContent = current?.title || '';
    miniPlayerArtist.textContent = current?.artist || 'Desconocido';
    miniPlayerAlbum.textContent = current?.album || '';
    miniPlayerCover.replaceChildren();
    if (current?.coverUrl) {
      const image = document.createElement('img');
      image.src = current.coverUrl;
      image.alt = `Carátula de ${current.title || 'la canción actual'}`;
      miniPlayerCover.appendChild(image);
    } else {
      const placeholder = document.createElement('i');
      placeholder.className = 'ph ph-music-note';
      placeholder.setAttribute('aria-hidden', 'true');
      miniPlayerCover.appendChild(placeholder);
    }
  };

  if (state.currentTrackIndex === -1 || !state.activeQueue[state.currentTrackIndex]) {
    lyricsSongTitle.textContent = 'Letras';
    lyricsSongArtist.textContent = '';
    updateMiniPlayer(null);
    lyricsLinesBox.replaceChildren();
    activeLyricElement = null;
    document.dispatchEvent(new CustomEvent('pn-lyrics-view-updated', { detail: { isSynced: false, songId: null } }));
    return;
  }
  const current = state.activeQueue[state.currentTrackIndex];

  lyricsSongTitle.textContent = current.title;
  lyricsSongArtist.textContent = current.artist || "Desconocido";
  updateMiniPlayer(current);
  lyricsLinesBox.innerHTML = '';
  activeLyricElement = null;

  if (!current.lyrics || !current.lyrics.lines || current.lyrics.lines.length === 0) {
    lyricsLinesBox.innerHTML = `<div class="lyrics-empty-notice">No hay letras disponibles para este tema.</div>`;
    document.dispatchEvent(new CustomEvent('pn-lyrics-view-updated', { detail: { isSynced: false, songId: current.id } }));
    return;
  }

  if (current.lyrics.isSynced) {
    current.lyrics.lines.forEach(line => {
      const enhancedLyrics = parseInlineLyricWords(line.text);
      const text = enhancedLyrics?.text || line.text || '';
      const wordTimings = Array.isArray(line.words) && line.words.length > 0
        ? line.words
        : enhancedLyrics?.words;
      const p = document.createElement('p');
      p.className = 'lyric-line-sync';
      p.dataset.originalText = text;
      p.dataset.time = (line.time !== null && !isNaN(line.time)) ? line.time : "";
      if (Array.isArray(wordTimings) && wordTimings.length > 0) {
        p.dataset.wordTimings = JSON.stringify(wordTimings);
      }
      const original = document.createElement('span');
      original.className = 'lyric-line-original';
      original.textContent = text || '•••';
      p.appendChild(original);

      p.addEventListener('click', () => {
        if (line.time !== null && !isNaN(line.time)) {
          void seekPlayback(line.time);
        }
      });
      lyricsLinesBox.appendChild(p);
    });
  } else {
    current.lyrics.lines.forEach(text => {
      const p = document.createElement('p');
      p.className = 'lyric-line-plain';
      p.textContent = text;
      lyricsLinesBox.appendChild(p);
    });
  }
  refitActiveLyricLine();
  document.dispatchEvent(new CustomEvent('pn-lyrics-view-updated', {
    detail: { isSynced: Boolean(current.lyrics.isSynced), songId: current.id }
  }));
}

function scrollLyricsLineIntoView(line) {
  const container = line?.closest('.lyrics-scroll-container');
  if (!container || !line.isConnected) return;

  const containerRect = container.getBoundingClientRect();
  const lineRect = line.getBoundingClientRect();
  const topInset = Math.min(96, Math.max(32, container.clientHeight * 0.14));
  const bottomInset = Math.min(72, Math.max(24, container.clientHeight * 0.1));
  const availableHeight = Math.max(1, container.clientHeight - topInset - bottomInset);
  let delta;
  if (lineRect.height > availableHeight) {
    delta = lineRect.top - containerRect.top - topInset;
  } else {
    delta = (lineRect.top + lineRect.bottom - containerRect.top - containerRect.bottom) / 2;
  }
  if (Math.abs(delta) > 1) {
    container.scrollTo({ top: Math.max(0, container.scrollTop + delta), behavior: 'smooth' });
  }
}

function createActiveRowFillOverlay(line, direction, wordTimings = [], sophisticated = false) {
  const original = line.querySelector('.lyric-line-original');
  if (!original) return null;

  line.querySelector('.lyric-active-overlay')?.remove();
  const overlay = document.createElement('span');
  overlay.className = 'lyric-active-overlay';
  overlay.setAttribute('aria-hidden', 'true');
  overlay.dataset.direction = direction;
  overlay.dataset.sourceText = original.textContent || '';

  const clone = original.cloneNode(false);
  const text = original.textContent || '';
  let unitCount = 0;
  if (direction === 'timed-words') {
    wordTimings.forEach(word => {
      const wordText = String(word.text);
      const visibleWord = wordText.trimEnd();
      const trailingSpace = wordText.slice(visibleWord.length);
      if (!visibleWord) {
        clone.appendChild(document.createTextNode(wordText));
        return;
      }
      const unit = document.createElement('span');
      unit.className = 'lyric-fill-unit';
      unit.dataset.wordStart = String(word.time);
      unit.textContent = visibleWord;
      unit.style.opacity = '0.34';
      clone.appendChild(unit);
      if (trailingSpace) clone.appendChild(document.createTextNode(trailingSpace));
      unitCount++;
    });
  } else if (direction === 'horizontal' && sophisticated) {
    text.split(/(\s+)/u).forEach(part => {
      if (!part || /^\s+$/u.test(part)) {
        clone.appendChild(document.createTextNode(part));
        return;
      }
      const unit = document.createElement('span');
      unit.className = 'lyric-fill-unit lyric-fill-word';
      unit.textContent = part;
      unit.style.setProperty('--lyric-unit-fill', '0%');
      clone.appendChild(unit);
      unitCount++;
    });
  } else if (direction === 'letters' || direction === 'words') {
    const parts = text.split(/(\s+)/u);
    parts.forEach(part => {
      if (/^\s+$/u.test(part)) {
        clone.appendChild(document.createTextNode(part));
        return;
      }
      if (direction === 'letters' && sophisticated) {
        const word = document.createElement('span');
        word.className = 'lyric-fill-letter-word';
        const letters = typeof Intl.Segmenter === 'function'
          ? Array.from(new Intl.Segmenter(undefined, { granularity: 'grapheme' }).segment(part), segment => segment.segment)
          : Array.from(part);
        letters.forEach(letter => {
          const unit = document.createElement('span');
          unit.className = 'lyric-fill-unit';
          unit.textContent = letter;
          unit.style.opacity = '0.34';
          word.appendChild(unit);
          unitCount++;
        });
        clone.appendChild(word);
        return;
      }
      const unit = document.createElement('span');
      unit.className = 'lyric-fill-unit';
      unit.textContent = part;
      unit.style.opacity = '0.34';
      clone.appendChild(unit);
      unitCount++;
    });
  } else {
    clone.textContent = text;
  }
  overlay.dataset.unitCount = String(unitCount);
  overlay.appendChild(clone);
  line.appendChild(overlay);
  if (direction === 'horizontal' && sophisticated) {
    updateHorizontalWrappedLineLayout(overlay);
  }
  return overlay;
}

function updateHorizontalWrappedLineLayout(overlay) {
  const units = Array.from(overlay.querySelectorAll('.lyric-fill-word'));
  if (units.length === 0) return;

  const fragments = units.map(unit => {
    const rect = unit.getBoundingClientRect();
    return { unit, rect, rowTop: Math.round(rect.top) };
  }).filter(fragment => fragment.rect.width > 0 && fragment.rect.height > 0);
  const rows = new Map();
  fragments.forEach(fragment => {
    const row = rows.get(fragment.rowTop) || { left: Infinity, right: -Infinity };
    row.left = Math.min(row.left, fragment.rect.left);
    row.right = Math.max(row.right, fragment.rect.right);
    rows.set(fragment.rowTop, row);
  });

  const orderedRows = [...rows.entries()].sort((first, second) => first[0] - second[0]);
  const rowIndexes = new Map(orderedRows.map(([rowTop], index) => [rowTop, index]));
  fragments.forEach(({ unit, rect, rowTop }) => {
    const row = rows.get(rowTop);
    unit.dataset.visualRow = String(rowIndexes.get(rowTop));
    unit.dataset.visualRowLeft = String(row.left);
    unit.dataset.visualRowWidth = String(Math.max(1, row.right - row.left));
    unit.dataset.visualUnitLeft = String(rect.left);
    unit.dataset.visualUnitWidth = String(Math.max(1, rect.width));
  });
  overlay.dataset.visualRowCount = String(Math.max(1, orderedRows.length));
  overlay.dataset.visualLayoutWidth = String(overlay.clientWidth);
  overlay.dataset.visualLayoutHeight = String(overlay.clientHeight);
}

function springResponse(progress, frequency, damping) {
  const phase = Math.max(0, Math.min(1, progress));
  const time = phase * Math.PI * 1.76;
  const decay = Math.exp(-damping * time);
  const ratio = damping / frequency;
  return 1 - decay * (Math.cos(frequency * time) + ratio * Math.sin(frequency * time));
}

function applySophisticatedMotion(element, progress, isEnabled, isLetter = false) {
  if (!element) return;
  if (!isEnabled) {
    element.style.removeProperty('--lyrics-spicy-scale');
    element.style.removeProperty('--lyrics-spicy-y');
    element.style.removeProperty('--lyrics-spicy-glow');
    element.style.removeProperty('--lyrics-spicy-glow-blur');
    return;
  }

  const phase = Math.max(0, Math.min(1, progress));
  const scaleSpring = springResponse(phase, 0.88, 0.64);
  const ySpring = springResponse(phase, 1.45, 0.4);
  const glowSpring = springResponse(phase, 1.18, 0.56);
  const scale = isLetter
    ? Math.max(0.95, Math.min(1.175, 0.95 + scaleSpring * 0.225))
    : Math.max(0.95, Math.min(1.0505, 0.95 + phase * 0.05 + (scaleSpring - phase) * 0.14));
  const offset = Math.max(-0.0167, Math.min(0.01, 0.01 * (1 - phase) - 0.04 * (ySpring - phase)));
  const glowEnvelope = phase < 0.35
    ? phase / 0.35
    : phase < 0.75
      ? 1
      : (1 - phase) / 0.25;
  const glow = Math.max(0, Math.min(1, glowEnvelope * glowSpring));
  element.style.setProperty('--lyrics-spicy-scale', String(scale));
  element.style.setProperty('--lyrics-spicy-y', `${offset}em`);
  element.style.setProperty('--lyrics-spicy-glow', String(glow));
  element.style.setProperty('--lyrics-spicy-glow-blur', `${glow * 12}px`);
}

function updateActiveRowFill(currentTime) {
  const root = document.documentElement;
  const enabled = root.dataset.lyricsActiveRowAnimation === 'true';
  const sophisticated = root.dataset.lyricsSophisticatedLyrics === 'true';
  const selectedDirection = root.dataset.lyricsActiveRowFillDirection || 'horizontal';
  if (!activeLyricElement) return;

  const previousOverlay = activeLyricElement.querySelector('.lyric-active-overlay');
  if (!enabled) {
    activeLyricElement.classList.remove('has-active-row-fill');
    activeLyricElement.classList.remove('has-sophisticated-lyrics');
    activeLyricElement.removeAttribute('data-fill-direction');
    previousOverlay?.remove();
    applySophisticatedMotion(activeLyricElement, 0, false);
    return;
  }

  let wordTimings = [];
  const serializedWordTimings = activeLyricElement.dataset.wordTimings;
  if (root.dataset.lyricsWordTimingAnimation === 'true' && serializedWordTimings) {
    const parsedWordTimings = JSON.parse(serializedWordTimings);
    if (Array.isArray(parsedWordTimings)) {
      wordTimings = parsedWordTimings.filter(word =>
        Number.isFinite(Number(word?.time)) && typeof word?.text === 'string' && word.text.length > 0
      );
    }
  }
  const direction = selectedDirection === 'vertical'
    ? 'vertical'
    : wordTimings.length > 0
      ? 'timed-words'
      : selectedDirection;
  activeLyricElement.classList.add('has-active-row-fill');
  activeLyricElement.classList.toggle('has-sophisticated-lyrics', sophisticated);
  activeLyricElement.dataset.fillDirection = direction;
  let overlay = previousOverlay;
  const originalText = activeLyricElement.querySelector('.lyric-line-original')?.textContent || '';
  const overlayWordTimings = overlay?.dataset.wordTimings || '';
  const nextOverlayWordTimings = direction === 'timed-words' ? JSON.stringify(wordTimings) : '';
  if (!overlay || overlay.dataset.direction !== direction || overlay.dataset.sourceText !== originalText ||
      overlayWordTimings !== nextOverlayWordTimings) {
    overlay = createActiveRowFillOverlay(activeLyricElement, direction, wordTimings, sophisticated);
  } else if (direction === 'horizontal' && sophisticated &&
      (overlay.dataset.visualLayoutWidth !== String(overlay.clientWidth) ||
       overlay.dataset.visualLayoutHeight !== String(overlay.clientHeight))) {
    updateHorizontalWrappedLineLayout(overlay);
  }
  if (!overlay) return;
  overlay.dataset.wordTimings = nextOverlayWordTimings;

  const start = Number.parseFloat(activeLyricElement.dataset.time);
  const lines = Array.from(lyricsLinesBox.querySelectorAll('.lyric-line-sync'));
  const activeIndex = lines.indexOf(activeLyricElement);
  const trackDuration = getPlaybackDuration();
  let end = Number.isFinite(trackDuration) && trackDuration > start ? trackDuration : null;
  for (let i = activeIndex + 1; i < lines.length; i++) {
    const nextTime = Number.parseFloat(lines[i].dataset.time);
    if (Number.isFinite(nextTime) && nextTime > start) {
      end = nextTime;
      break;
    }
  }
  if (end === null || end <= start) {
    for (let i = activeIndex - 1; i >= 0; i--) {
      const previousTime = Number.parseFloat(lines[i].dataset.time);
      if (Number.isFinite(previousTime) && previousTime < start) {
        end = start + (start - previousTime);
        break;
      }
    }
  }
  if (end === null || end <= start) end = start + 4;

  const progress = Math.max(0, Math.min(1, (currentTime - start) / (end - start)));
  overlay.style.setProperty('--lyric-fill-progress', `${progress * 100}%`);
  const isUnitDirection = direction === 'timed-words' || direction === 'letters' || direction === 'words';
  const sophisticatedDirectional = sophisticated &&
    (direction === 'horizontal' || direction === 'vertical');
  applySophisticatedMotion(
    activeLyricElement,
    progress,
    sophisticated && !isUnitDirection && !sophisticatedDirectional
  );
  if (sophisticatedDirectional) {
    const directionalText = overlay.querySelector('.lyric-line-original');
    const gradientPosition = -20 + progress * 120;
    const glowProgress = Math.min(1, progress / 0.35, (1 - progress) / 0.25);
    overlay.style.setProperty('--lyric-gradient-position', `${gradientPosition}%`);
    overlay.style.setProperty('--lyric-text-glow-opacity', String(Math.max(0, glowProgress) * 0.8));
    overlay.style.setProperty('--lyric-text-glow-blur', `${4 + Math.max(0, glowProgress) * 8}px`);
    applySophisticatedMotion(activeLyricElement, 0, false);
    if (directionalText) {
      directionalText.style.setProperty('--lyric-gradient-position', `${gradientPosition}%`);
      directionalText.style.setProperty('--lyric-text-glow-opacity', String(Math.max(0, glowProgress) * 0.8));
      directionalText.style.setProperty('--lyric-text-glow-blur', `${4 + Math.max(0, glowProgress) * 8}px`);
    }
  } else {
    overlay.style.removeProperty('--lyric-gradient-position');
    overlay.style.removeProperty('--lyric-text-glow-opacity');
    overlay.style.removeProperty('--lyric-text-glow-blur');
    const directionalText = overlay.querySelector('.lyric-line-original');
    directionalText?.style.removeProperty('--lyric-gradient-position');
    directionalText?.style.removeProperty('--lyric-text-glow-opacity');
    directionalText?.style.removeProperty('--lyric-text-glow-blur');
  }
  const setUnitProgress = (unit, unitProgress) => {
    const normalizedProgress = Math.max(0, Math.min(1, unitProgress));
    unit.style.setProperty('--lyric-unit-fill', `${normalizedProgress * 100}%`);
    const fillEdge = normalizedProgress * 120 - 20;
    unit.style.setProperty('--lyric-unit-fill-start', `${fillEdge}%`);
    unit.style.setProperty('--lyric-unit-fill-end', `${fillEdge + 20}%`);
    unit.style.opacity = String(0.34 + normalizedProgress * 0.66);
    applySophisticatedMotion(
      unit,
      normalizedProgress,
      sophisticated && direction !== 'horizontal',
      direction === 'letters'
    );
  };
  if (direction === 'timed-words') {
    const timedUnits = Array.from(overlay.querySelectorAll('.lyric-fill-unit'));
    timedUnits.forEach((unit, index) => {
      const wordStart = Number.parseFloat(unit.dataset.wordStart);
      const nextWordStart = Number.parseFloat(timedUnits[index + 1]?.dataset.wordStart);
      const wordEnd = Number.isFinite(nextWordStart) && nextWordStart > wordStart
        ? nextWordStart
        : end;
      const wordProgress = wordEnd > wordStart
        ? Math.max(0, Math.min(1, (currentTime - wordStart) / (wordEnd - wordStart)))
        : 0;
      setUnitProgress(unit, wordProgress);
    });
  } else if (direction === 'letters' || direction === 'words') {
    const count = Number.parseInt(overlay.dataset.unitCount || '0', 10);
    const filledUnits = progress * count;
    overlay.querySelectorAll('.lyric-fill-unit').forEach((unit, index) => {
      const unitProgress = Math.max(0, Math.min(1, filledUnits - index));
      setUnitProgress(unit, unitProgress);
    });
  } else if (direction === 'horizontal' && sophisticated) {
    const rowCount = Number.parseInt(overlay.dataset.visualRowCount || '1', 10);
    const totalRowProgress = progress * rowCount;
    overlay.querySelectorAll('.lyric-fill-word').forEach(unit => {
      const rowIndex = Number.parseInt(unit.dataset.visualRow || '0', 10);
      const rowProgress = Math.max(0, Math.min(1, totalRowProgress - rowIndex));
      const rowLeft = Number.parseFloat(unit.dataset.visualRowLeft) || 0;
      const rowWidth = Number.parseFloat(unit.dataset.visualRowWidth) || 1;
      const unitLeft = Number.parseFloat(unit.dataset.visualUnitLeft) || rowLeft;
      const unitWidth = Number.parseFloat(unit.dataset.visualUnitWidth) || 1;
      const progressAcrossRow = rowProgress * rowWidth;
      const unitProgress = (progressAcrossRow - (unitLeft - rowLeft)) / unitWidth;
      setUnitProgress(unit, unitProgress);
      const glowProgress = Math.min(1, Math.max(0, unitProgress) / 0.35);
      unit.style.setProperty('--lyrics-spicy-glow', String(glowProgress * 0.8));
      unit.style.setProperty('--lyrics-spicy-glow-blur', `${4 + glowProgress * 8}px`);
    });
  }
}

function stopLyricsActiveRowAnimation() {
  if (lyricFillAnimationFrame === null) return;
  cancelAnimationFrame(lyricFillAnimationFrame);
  lyricFillAnimationFrame = null;
}

function animateLyricsActiveRow() {
  lyricFillAnimationFrame = null;
  if (!state.isLyricsOpen || isPlaybackPaused() ||
      document.documentElement.dataset.lyricsActiveRowAnimation !== 'true' ||
      !activeLyricElement) return;
  updateActiveRowFill(getPlaybackPosition());
  lyricFillAnimationFrame = requestAnimationFrame(animateLyricsActiveRow);
}

function syncLyricsActiveRowAnimation() {
  if (state.isLyricsOpen && !isPlaybackPaused() &&
      document.documentElement.dataset.lyricsActiveRowAnimation === 'true' &&
      activeLyricElement && lyricFillAnimationFrame === null) {
    lyricFillAnimationFrame = requestAnimationFrame(animateLyricsActiveRow);
  } else if (document.documentElement.dataset.lyricsActiveRowAnimation !== 'true' || isPlaybackPaused()) {
    stopLyricsActiveRowAnimation();
  }
}

export function updateSyncedLyricsProgress(currentTime) {
  const miniProgress = document.getElementById('lyrics-focus-mini-progress');
  const miniProgressFill = document.getElementById('lyrics-focus-mini-progress-fill');
  if (miniProgress && miniProgressFill) {
    // Usar duración/posición nativa si aplica (audio.duration suele ser 0 con motor Rust)
    const duration = getPlaybackDuration();
    const time = Number.isFinite(currentTime) ? currentTime : getPlaybackPosition();
    const progress = duration > 0 ? Math.max(0, Math.min(100, (time / duration) * 100)) : 0;
    miniProgressFill.style.width = `${progress}%`;
    miniProgress.setAttribute('aria-valuenow', String(Math.round(progress)));
  }

  const lines = lyricsLinesBox.querySelectorAll('.lyric-line-sync');
  if (lines.length === 0) return;

  let currentLineEl = null;

  for (let i = 0; i < lines.length; i++) {
    const timeAttr = lines[i].dataset.time;
    if (!timeAttr || timeAttr === "null") continue;
    const t = parseFloat(timeAttr);
    if (!isNaN(t) && currentTime >= t) {
      currentLineEl = lines[i];
    } else if (!isNaN(t) && currentTime < t) {
      break;
    }
  }

  if (currentLineEl && currentLineEl !== activeLyricElement) {
    const currentIndex = Array.prototype.indexOf.call(lines, currentLineEl);
    const currentTimeValue = Number.parseFloat(currentLineEl.dataset.time);
    const getLineTime = line => {
      const time = Number.parseFloat(line.dataset.time);
      return Number.isFinite(time) ? time : null;
    };
    let interval = null;

    for (let i = currentIndex + 1; i < lines.length; i++) {
      const nextTime = getLineTime(lines[i]);
      if (nextTime !== null && Number.isFinite(currentTimeValue) && nextTime > currentTimeValue) {
        interval = nextTime - currentTimeValue;
        break;
      }
    }
    if (interval === null) {
      for (let i = currentIndex - 1; i >= 0; i--) {
        const previousTime = getLineTime(lines[i]);
        if (previousTime !== null && Number.isFinite(currentTimeValue) && currentTimeValue > previousTime) {
          interval = currentTimeValue - previousTime;
          break;
        }
      }
    }
    const motionDuration = Math.min(12, Math.max(2, (interval || 4) * 1.5));
    currentLineEl.style.setProperty('--lyric-motion-duration', `${motionDuration}s`);
  }

  if (activeLyricElement && activeLyricElement !== currentLineEl) {
    activeLyricElement.classList.remove('active');
    activeLyricElement.classList.remove('has-active-row-fill');
    activeLyricElement.classList.remove('has-sophisticated-lyrics');
    activeLyricElement.querySelector('.lyric-active-overlay')?.remove();
    activeLyricElement.style.removeProperty('--lyric-line-fit-scale');
    activeLyricElement.style.removeProperty('--lyric-motion-duration');
    applySophisticatedMotion(activeLyricElement, 0, false);
  }
  if (currentLineEl && currentLineEl !== activeLyricElement) {
    currentLineEl.classList.add('active');
    activeLyricElement = currentLineEl;

    fitLyricLineToViewport(currentLineEl);
    if (lyricsAutoScrollEnabled) scrollLyricsLineIntoView(currentLineEl);
  }
  if (!currentLineEl) {
    activeLyricElement = null;
  }
  updateActiveRowFill(currentTime);
  syncLyricsActiveRowAnimation();
}

export function suspendLyricsAutoScroll() {
  lyricsAutoScrollEnabled = false;
  document.dispatchEvent(new CustomEvent('pn-lyrics-auto-scroll-changed', {
    detail: { enabled: false }
  }));
}

export function resumeLyricsAutoScrollAtActiveLine() {
  lyricsAutoScrollEnabled = true;
  document.dispatchEvent(new CustomEvent('pn-lyrics-auto-scroll-changed', {
    detail: { enabled: true }
  }));
  if (!activeLyricElement?.isConnected) updateSyncedLyricsProgress(getPlaybackPosition());
  if (activeLyricElement) refitActiveLyricLine();
}
document.addEventListener('pn-lyrics-visual-settings-changed', () => {
  requestAnimationFrame(refitActiveLyricLine);
});
document.addEventListener('pn-lyrics-active-row-animation-changed', () => {
  updateActiveRowFill(audio.currentTime);
  syncLyricsActiveRowAnimation();
});
document.addEventListener('pn-visual-plus-settings-changed', event => {
  if (typeof event.detail?.sophisticatedLyrics !== 'boolean') return;
  document.documentElement.dataset.lyricsSophisticatedLyrics = String(event.detail.sophisticatedLyrics);
  updateActiveRowFill(audio.currentTime);
});
document.addEventListener('pn-lyrics-layers-changed', () => {
  activeLyricElement?.querySelector('.lyric-active-overlay')?.remove();
  updateActiveRowFill(audio.currentTime);
});

export async function showSongDetails(song) {
  if (!song) return;
  await ensureSongMetadata(song);
  await Promise.all([
    ensureSongTechDetails(song).catch(() => {}),
    ensureSongLyrics(song).catch(() => {})
  ]);
  songDetailsTarget = song;
  if (trackMetadataSearchStatus) trackMetadataSearchStatus.textContent = '';
  if (trackMetadataSearchMenu) trackMetadataSearchMenu.hidden = true;
  btnFetchTrackMetadata?.setAttribute('aria-expanded', 'false');

  if (resolveCoverUrl(song)) {
    detailsCoverBox.innerHTML = resolveCoverUrl(song)
      ? `<img src="${resolveCoverUrl(song)}" class="details-cover-img" alt="${song.title}" />`
      : detailsCoverBox.innerHTML;
  } else {
    detailsCoverBox.innerHTML = `<i class="ph ph-waveform"></i>`;
  }

  const durSec = song.duration || (audio.duration && song.id === state.activeQueue[state.currentTrackIndex]?.id ? audio.duration : 0);
  const durFormatted = durSec > 0 ? formatTime(durSec) : "Desconocida";

  const fileName = song.file ? song.file.name : "Desconocido";
  const ext = fileName.includes('.') ? fileName.split('.').pop().toUpperCase() : "AUDIO";
  const fileBytes = Number(song.file?.size);
  let fileSizeStr = "Desconocido";
  if (Number.isFinite(fileBytes) && fileBytes >= 0) {
    if (fileBytes < 1024) {
      fileSizeStr = `${fileBytes} B`;
    } else {
      const units = ['KB', 'MB', 'GB'];
      let size = fileBytes / 1024;
      let unitIndex = 0;
      while (size >= 1024 && unitIndex < units.length - 1) {
        size /= 1024;
        unitIndex++;
      }
      fileSizeStr = `${size.toFixed(1)} ${units[unitIndex]}`;
    }
  }

  detailsMainMeta.innerHTML = `
    <h4 class="details-main-title">${song.title}</h4>
    <div class="details-main-artist">${song.artist || "Desconocido"}</div>
    <div class="details-main-sub">
      <i class="ph ph-disc"></i>
      <span>${song.album || "Sencillo / Desconocido"}</span>
      <span>•</span>
      <i class="ph ph-clock"></i>
      <span>${durFormatted}</span>
    </div>
    <div class="details-main-sub">
      <span>•</span>
      <i class="ph ph-file" aria-label="Tamaño del archivo"></i>
      <span>${fileSizeStr}</span>
    </div>
  `;

  let bitrateStr = "N/D";
  if (durSec > 0 && song.file) {
    const kbps = Math.round((song.file.size * 8) / (durSec * 1000));
    bitrateStr = `${kbps} kbps`;
  } else {
    bitrateStr = ext === 'FLAC' ? "Lossless (Flac)" : "320 kbps";
  }

  const sampleRateStr = song.sampleRate ? `${(song.sampleRate / 1000).toFixed(1)} kHz` : "44.1 kHz";
  const channelsStr = song.channels === 1 ? "Mono (1.0)" : "Estéreo (2.0)";
  const depthStr = song.bitDepth ? `${song.bitDepth}-bit` : "16-bit";
  const codecStr = song.codec || `${ext} Audio`;
  const playsStr = `${song.playCount || 0} reproducciones`;

  detailsTechGrid.innerHTML = `
    <div class="tech-cell">
      <span class="tech-cell-label">Formato / Códec</span>
      <span class="tech-cell-value">${codecStr}</span>
    </div>
    <div class="tech-cell">
      <span class="tech-cell-label">Tasa de Bits</span>
      <span class="tech-cell-value">${bitrateStr}</span>
    </div>
    <div class="tech-cell">
      <span class="tech-cell-label">Frecuencia</span>
      <span class="tech-cell-value">${sampleRateStr}</span>
    </div>
    <div class="tech-cell">
      <span class="tech-cell-label">Profundidad</span>
      <span class="tech-cell-value">${depthStr}</span>
    </div>
    <div class="tech-cell">
      <span class="tech-cell-label">Canales</span>
      <span class="tech-cell-value">${channelsStr}</span>
    </div>
    <div class="tech-cell">
      <span class="tech-cell-label">Reproducciones</span>
      <span class="tech-cell-value" style="color:var(--accent-light);">${playsStr}</span>
    </div>
  `;

  if (song.lyrics && song.lyrics.lines && song.lyrics.lines.length > 0) {
    detailsLyricsBadge.textContent = song.lyrics.isSynced ? "Sincronizadas (LRC)" : "Texto plano";
    detailsLyricsBadge.style.display = "inline-block";

    let lyricsBody = "";
    if (song.lyrics.isSynced) {
      lyricsBody = song.lyrics.lines.map(l => l.text).filter(t => t && t !== "•••").join("\n");
    } else {
      lyricsBody = song.lyrics.lines.join("\n");
    }
    detailsLyricsContent.textContent = lyricsBody || "No hay versos legibles en esta pista.";
  } else {
    detailsLyricsBadge.textContent = "No disponible";
    detailsLyricsContent.innerHTML = `<span style="font-style: italic; opacity: 0.6;">No se encontraron letras incrustadas en los metadatos de este archivo.</span>`;
  }

  songDetailsModal.classList.add('open');
}

export async function refreshSongDetailsIfOpen(song) {
  if (songDetailsTarget?.id === song?.id && songDetailsModal.classList.contains('open')) {
    await showSongDetails(song);
  }
}

function closeMetadataMatchModal() {
  if (metadataApplying) return;
  metadataMatchModal?.classList.remove('open');
  metadataMatchList?.replaceChildren();
  trackMetadataMatches = [];
}

function renderMetadataMatches(matches) {
  if (!metadataMatchList || !metadataMatchModal) return;
  trackMetadataMatches = matches;
  metadataMatchList.replaceChildren();
  matches.forEach((match, index) => {
    const card = document.createElement('article');
    card.className = 'metadata-match-option';
    card.dataset.matchIndex = String(index);
    const summary = document.createElement('div');
    summary.className = 'metadata-match-summary';
    const copyAll = document.createElement('button');
    copyAll.type = 'button';
    copyAll.className = 'metadata-match-summary-copy';
    copyAll.dataset.metadataCopyAll = '';
    const title = document.createElement('strong');
    title.textContent = match.title || 'Título desconocido';
    const info = document.createElement('span');
    info.textContent = [
      match.artist || 'Artista desconocido',
      match.album || 'Álbum desconocido',
      match.date || ''
    ].filter(Boolean).join(' · ');
    copyAll.append(title, info);
    const expand = document.createElement('button');
    expand.type = 'button';
    expand.className = 'metadata-match-expand';
    expand.dataset.metadataExpand = '';
    expand.setAttribute('aria-label', 'Mostrar datos completos de la coincidencia');
    expand.setAttribute('aria-expanded', 'false');
    expand.innerHTML = '<i class="ph ph-caret-down"></i>';
    summary.append(copyAll, expand);

    const details = document.createElement('div');
    details.className = 'metadata-match-details';
    details.hidden = true;
    details.dataset.metadataDetails = '';
    card.append(summary, details);
    metadataMatchList.appendChild(card);
  });
  metadataMatchModal.classList.add('open');
}

const metadataCopyFields = [
  ['title', 'Título'],
  ['artist', 'Artista'],
  ['album', 'Álbum'],
  ['date', 'Año / fecha'],
  ['trackNumber', 'Número de pista'],
  ['discNumber', 'Número de disco'],
  ['genre', 'Género']
];

function addMetadataDetailRow(details, label, value, field = null) {
  const row = document.createElement('div');
  row.className = 'metadata-detail-row';
  if (field) {
    const checkbox = document.createElement('input');
    checkbox.type = 'checkbox';
    checkbox.checked = Boolean(value);
    checkbox.disabled = !value;
    checkbox.dataset.metadataField = field;
    checkbox.setAttribute('aria-label', `Incluir ${label}`);
    row.appendChild(checkbox);
  }
  const name = document.createElement('strong');
  name.textContent = `${label}:`;
  const content = document.createElement('span');
  content.textContent = value || 'No disponible';
  row.append(name, content);
  if (field) {
    const copy = document.createElement('button');
    copy.type = 'button';
    copy.className = 'metadata-field-copy';
    copy.dataset.metadataCopyField = field;
    copy.textContent = 'Usar';
    copy.disabled = !value;
    row.appendChild(copy);
  }
  details.appendChild(row);
}

function renderMetadataMatchDetails(card, match) {
  const details = card.querySelector('[data-metadata-details]');
  if (!details) return;
  details.replaceChildren();

  if (match.coverDataUrl) {
    const image = document.createElement('img');
    image.className = 'metadata-match-cover';
    image.src = match.coverDataUrl;
    image.alt = 'Portada encontrada';
    details.appendChild(image);
    addMetadataDetailRow(details, 'Portada', 'Disponible', 'cover');
  } else if (match.coverError) {
    addMetadataDetailRow(details, 'Portada', 'No se encontró una portada');
  } else if (match.coverLoading) {
    addMetadataDetailRow(details, 'Portada', 'Cargando portada…');
  } else if (match.releaseMbid) {
    addMetadataDetailRow(details, 'Portada', 'Pulsa para cargar portada');
  } else {
    addMetadataDetailRow(details, 'Portada', 'No hay lanzamiento asociado');
  }

  metadataCopyFields.forEach(([field, label]) => {
    addMetadataDetailRow(details, label, match[field] || '', field);
  });
  addMetadataDetailRow(details, 'Recording MBID', match.recordingMbid || '');
  addMetadataDetailRow(details, 'Release MBID', match.releaseMbid || '');
  addMetadataDetailRow(details, 'Grupo del álbum', match.releaseGroup || '');
  addMetadataDetailRow(details, 'País', match.country || '');
  addMetadataDetailRow(details, 'Formato', match.mediaFormat || '');
  addMetadataDetailRow(details, 'Código de barras', match.barcode || '');
  addMetadataDetailRow(details, 'Estado del lanzamiento', match.releaseStatus || '');
  addMetadataDetailRow(details, 'Duración', match.length || '');
  addMetadataDetailRow(details, 'Desambiguación', match.disambiguation || '');

  const applySelected = document.createElement('button');
  applySelected.type = 'button';
  applySelected.className = 'btn-pill-save metadata-match-copy-selected';
  applySelected.dataset.metadataCopySelected = '';
  applySelected.textContent = 'Usar seleccionados';
  details.appendChild(applySelected);
}

async function loadMetadataMatchCover(card, match) {
  if (!match.releaseMbid || match.coverDataUrl || match.coverLoading || !window.__TAURI__?.core?.invoke) return;
  match.coverLoading = true;
  renderMetadataMatchDetails(card, match);
  try {
    match.coverDataUrl = await window.__TAURI__.core.invoke('fetch_cover_art', {
      releaseMbid: match.releaseMbid
    });
  } catch (error) {
    console.warn('No se pudo cargar la portada de Cover Art Archive:', error);
    match.coverError = true;
  } finally {
    match.coverLoading = false;
    renderMetadataMatchDetails(card, match);
  }
}

function setMetadataTextSearchStatus(message, isError = false) {
  if (!metadataTextSearchStatus) return;
  metadataTextSearchStatus.textContent = message;
  metadataTextSearchStatus.classList.toggle('is-error', isError);
}

function openMetadataTextSearch(song) {
  if (!song || !metadataTextSearchModal) return;
  metadataTextSearchSong = song;
  metadataTextSearchContext.textContent = `Buscar metadata para: ${song.title || 'Sin título'} — ${song.artist || 'Desconocido'}`;
  metadataSearchTitle.value = song.title || '';
  metadataSearchArtist.value = song.artist === 'Desconocido' ? '' : (song.artist || '');
  metadataSearchAlbum.value = song.album || '';
  metadataSearchSubmit.disabled = false;
  setMetadataTextSearchStatus('');
  metadataTextSearchModal.classList.add('open');
}

function closeMetadataTextSearch() {
  metadataTextSearchModal?.classList.remove('open');
  metadataTextSearchSong = null;
}

async function searchMetadataByText(title, artist, album, { allowFallback = false } = {}) {
  const targetSong = metadataTextSearchSong || songDetailsTarget;
  const isFallbackSearch = Boolean(metadataTextSearchSong);
  if (!targetSong || !window.__TAURI__?.core?.invoke) {
    throw new Error('La búsqueda en línea está disponible en la aplicación de escritorio.');
  }
  const normalizedTitle = title.trim();
  const normalizedArtist = artist.trim();
  if (!normalizedTitle || !normalizedArtist) {
    if (allowFallback) {
      openMetadataTextSearch(targetSong);
      setMetadataTextSearchStatus('Completa el título y el artista para buscar.', true);
    } else {
      setMetadataTextSearchStatus('Escribe el título y el artista para buscar.', true);
    }
    return;
  }
  metadataSearchSubmit.disabled = true;
  setMetadataTextSearchStatus('Consultando MusicBrainz…');
  try {
    const matches = await window.__TAURI__.core.invoke('fetch_metadata_by_text', {
      title: normalizedTitle,
      artist: normalizedArtist,
      album: album.trim()
    });
    if (!songDetailsModal.classList.contains('open')) return;
    if (isFallbackSearch && !metadataTextSearchModal.classList.contains('open')) return;
    if (metadataTextSearchSong && metadataTextSearchSong.id !== targetSong.id) return;
    if (songDetailsTarget?.id !== targetSong.id) return;
    if (!Array.isArray(matches) || matches.length === 0) {
      if (allowFallback) {
        closeMetadataTextSearch();
        openMetadataTextSearch(targetSong);
      } else {
        setMetadataTextSearchStatus('No se encontraron coincidencias. Prueba con otro título, artista o álbum.', true);
      }
      return;
    }
    closeMetadataTextSearch();
    trackMetadataSearchStatus.textContent = '';
    renderMetadataMatches(matches);
  } catch (error) {
    console.error('No se pudo buscar metadata en MusicBrainz:', error);
    if (allowFallback) {
      openMetadataTextSearch(targetSong);
      setMetadataTextSearchStatus(`No se pudo consultar la base de datos: ${String(error?.message || error)}`, true);
    } else {
      setMetadataTextSearchStatus(`No se pudo buscar: ${String(error?.message || error)}`, true);
    }
  } finally {
    if (metadataSearchSubmit) metadataSearchSubmit.disabled = false;
  }
}

async function searchTrackMetadata(method) {
  if (!songDetailsTarget || !btnFetchTrackMetadata) return;
  const targetSong = songDetailsTarget;
  trackMetadataSearchMenu.hidden = true;
  btnFetchTrackMetadata.setAttribute('aria-expanded', 'false');
  btnFetchTrackMetadata.disabled = true;
  const isFingerprint = method === 'fingerprint';
  trackMetadataSearchStatus.textContent = isFingerprint
    ? 'Analizando audio…'
    : 'Consultando base de datos…';
  try {
    if (!window.__TAURI__?.core?.invoke) {
      throw new Error('La búsqueda en línea está disponible en la aplicación de escritorio.');
    }
    let matches;
    if (isFingerprint) {
      const filePath = targetSong.file?.path;
      if (!filePath) throw new Error('No se encontró la ruta local necesaria para analizar esta pista.');
      matches = await window.__TAURI__.core.invoke('fetch_metadata_by_fingerprint', { filePath });
    } else {
      await searchMetadataByText(
        targetSong.title || '',
        targetSong.artist === 'Desconocido' ? '' : (targetSong.artist || ''),
        targetSong.album || '',
        { allowFallback: true }
      );
      return;
    }
    if (songDetailsTarget?.id !== targetSong.id) return;
    if (!Array.isArray(matches) || matches.length === 0) {
      trackMetadataSearchStatus.textContent = '';
      await showConfirmDialog({
        title: 'Sin coincidencias',
        message: 'No se encontraron coincidencias para esta pista.',
        confirmText: 'Entendido',
        showCancel: false
      });
      return;
    }
    trackMetadataSearchStatus.textContent = '';
    renderMetadataMatches(matches);
  } catch (error) {
    console.error('No se pudo buscar metadata de la pista:', error);
    trackMetadataSearchStatus.textContent = '';
    await showConfirmDialog({
      title: 'Error al buscar metadata',
      message: String(error?.message || error),
      confirmText: 'Entendido',
      showCancel: false
    });
  } finally {
    btnFetchTrackMetadata.disabled = false;
  }
}

async function applyMetadataMatch(index, selectedFields = null) {
  const match = trackMetadataMatches[index];
  if (!match || !songDetailsTarget) return;
  const song = songDetailsTarget;
  const fields = selectedFields || metadataCopyFields
    .filter(([field]) => Boolean(match[field]))
    .map(([field]) => field)
    .concat(match.releaseMbid ? ['cover'] : []);
  metadataApplying = true;
  metadataMatchList?.querySelectorAll('button').forEach(button => {
    button.disabled = true;
  });
  if (metadataMatchClose) metadataMatchClose.disabled = true;
  let coverDataUrl = null;
  if (fields.includes('cover') && match.releaseMbid && window.__TAURI__?.core?.invoke) {
    try {
      coverDataUrl = match.coverDataUrl || await window.__TAURI__.core.invoke(
        'fetch_cover_art',
        { releaseMbid: match.releaseMbid }
      );
    } catch (error) {
      console.warn('No se pudo cargar la portada de Cover Art Archive:', error);
    }
  }
  metadataApplying = false;
  if (metadataMatchClose) metadataMatchClose.disabled = false;
  closeMetadataMatchModal();
  songDetailsModal.classList.remove('open');
  openTrackEditor(song, {
    title: match.title,
    artist: match.artist,
    album: match.album,
    date: match.date,
    trackNumber: match.trackNumber,
    discNumber: match.discNumber,
    genre: match.genre,
    coverDataUrl,
    selectedFields: fields
  });
}

export async function addSongToPlaylist(song, playlist) {
  if (!song || !playlist) return;
  if (playlist.smartFilter) {
    await showConfirmDialog({
      title: "Playlist dinámica",
      message: "Su contenido se determina por sus filtros y no admite canciones agregadas manualmente.",
      confirmText: "Aceptar",
      showCancel: false
    });
    return;
  }
  if (!playlist.songs) playlist.songs = [];

  const alreadyExists = playlist.songs.some(s => s.id === song.id || (s.title === song.title && s.artist === song.artist));
  if (alreadyExists) {
    const proceed = await showConfirmDialog({
      title: "¿Canción repetida en playlist?",
      message: `La canción "${song.title}" ya se encuentra en "${playlist.title}". ¿Deseas agregarla de nuevo?`,
      confirmText: "Agregar",
      cancelText: "Cancelar"
    });
    if (!proceed) return;
  }

  playlist.songs.push(song);
  persistPlaylists();
  renderPlaylistsUI();
  if (state.currentView === 'playlists-hub') {
    renderPlaylistsHubUI();
  }
  if (state.currentView === 'playlist' && state.currentPlaylistId === playlist.id) {
    renderPlaylistDetailView();
  }
}

async function addSongsToPlaylist(songs, playlist) {
  if (!playlist) return;
  if (playlist.smartFilter) return;
  const playlistSongs = Array.isArray(playlist.songs) ? playlist.songs : [];
  const songsToAdd = songs.filter((song, index) =>
    !playlistSongs.some(existing => songsMatch(existing, song)) &&
    songs.findIndex(other => songsMatch(song, other)) === index
  );
  if (!songsToAdd.length) return;

  playlist.songs = [...playlistSongs, ...songsToAdd];
  persistPlaylists();
  renderPlaylistsUI();
  if (state.currentView === 'playlists-hub') renderPlaylistsHubUI();
  if (state.currentView === 'playlist' && state.currentPlaylistId === playlist.id) {
    renderPlaylistDetailView();
  }
}

function openPlaylistPicker(songs) {
  const editablePlaylists = state.playlists.filter(playlist => !playlist.smartFilter);
  if (!editablePlaylists.length) {
    void showConfirmDialog({
      title: 'No hay playlists editables',
      message: 'Crea una playlist manual para agregar canciones. Las playlists dinámicas se actualizan mediante sus filtros.',
      confirmText: 'Aceptar',
      showCancel: false
    });
    return;
  }

  const modal = document.getElementById('multi-playlist-modal');
  const options = document.getElementById('multi-playlist-options');
  const title = document.getElementById('multi-playlist-title');
  const description = document.getElementById('multi-playlist-description');
  const modeToggle = document.getElementById('multi-playlist-toggle');
  const applyButton = document.getElementById('multi-playlist-apply');
  const cancelButton = document.getElementById('multi-playlist-cancel');
  const closeButton = document.getElementById('multi-playlist-close');
  if (!modal || !options || !title || !description || !modeToggle || !applyButton || !cancelButton || !closeButton) return;

  const selectedSongs = Array.isArray(songs) ? songs : [songs];
  let mode = 'single';

  const createPlaylistThumbnail = playlist => {
    const thumbnail = document.createElement('span');
    thumbnail.className = 'playlist-picker-thumb';
    if (playlist.coverUrl) {
      const image = document.createElement('img');
      image.src = playlist.coverUrl;
      image.alt = '';
      thumbnail.appendChild(image);
    } else {
      const icon = document.createElement('i');
      icon.className = 'ph ph-playlist';
      thumbnail.appendChild(icon);
    }
    return thumbnail;
  };

  const renderSingleChoice = () => {
    mode = 'single';
    title.textContent = 'Agregar a playlist';
    description.textContent = `Elige dónde agregar ${selectedSongs.length === 1 ? 'esta canción' : `estas ${selectedSongs.length} canciones`}. Las canciones repetidas se omitirán.`;
    modeToggle.title = 'Elegir varias playlists';
    modeToggle.setAttribute('aria-label', 'Elegir varias playlists');
    modeToggle.setAttribute('aria-pressed', 'false');
    modeToggle.querySelector('i').className = 'ph ph-list-checks';
    options.replaceChildren();
    editablePlaylists.forEach(playlist => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'playlist-picker-item';
      button.dataset.playlistId = String(playlist.id);
      button.appendChild(createPlaylistThumbnail(playlist));
      const name = document.createElement('span');
      name.className = 'playlist-picker-name';
      name.textContent = playlist.title;
      button.appendChild(name);
      options.appendChild(button);
    });

    const createButton = document.createElement('button');
    createButton.type = 'button';
    createButton.className = 'playlist-picker-item';
    createButton.dataset.playlistAction = 'create';
    createButton.innerHTML = '<i class="ph ph-plus"></i><span>Nueva playlist...</span>';
    options.appendChild(createButton);

    applyButton.hidden = true;
    applyButton.disabled = true;
  };

  const renderMultipleChoices = () => {
    mode = 'multiple';
    title.textContent = 'Agregar a varias playlists';
    description.textContent = `Selecciona los destinos para ${selectedSongs.length === 1 ? 'esta canción' : `estas ${selectedSongs.length} canciones`}. Los duplicados se omitirán.`;
    modeToggle.title = 'Volver a elegir una playlist';
    modeToggle.setAttribute('aria-label', 'Volver a elegir una playlist');
    modeToggle.setAttribute('aria-pressed', 'true');
    modeToggle.querySelector('i').className = 'ph ph-arrow-left';
    options.replaceChildren();

    editablePlaylists.forEach(playlist => {
      const label = document.createElement('label');
      label.className = 'multi-playlist-option';
      const checkbox = document.createElement('input');
      checkbox.type = 'checkbox';
      checkbox.value = String(playlist.id);
      label.append(checkbox, createPlaylistThumbnail(playlist));
      const name = document.createElement('span');
      name.className = 'playlist-picker-name';
      name.textContent = playlist.title;
      label.appendChild(name);
      options.appendChild(label);
    });

    applyButton.hidden = false;
    updateApplyState();
  };

  const updateApplyState = () => {
    applyButton.disabled = mode !== 'multiple' || !options.querySelector('input:checked');
  };

  const toggleMode = () => {
    if (mode === 'single') renderMultipleChoices();
    else renderSingleChoice();
  };

  const close = () => {
    modal.classList.remove('open');
    applyButton.removeEventListener('click', apply);
    cancelButton.removeEventListener('click', close);
    closeButton.removeEventListener('click', close);
    modeToggle.removeEventListener('click', toggleMode);
    options.removeEventListener('click', handleOptionClick);
    options.removeEventListener('change', updateApplyState);
    modal.removeEventListener('click', onBackdropClick);
    document.removeEventListener('keydown', onKeyDown);
  };

  const handleOptionClick = event => {
    const actionButton = event.target.closest('[data-playlist-action]');
    if (actionButton?.dataset.playlistAction === 'create') {
      close();
      btnAddPlaylist.click();
      return;
    }
    const playlistButton = event.target.closest('[data-playlist-id]');
    if (!playlistButton) return;
    const playlist = state.playlists.find(item => String(item.id) === playlistButton.dataset.playlistId);
    if (!playlist) return;
    close();
    void addSongsToPlaylist(selectedSongs, playlist);
  };

  const apply = () => {
    if (mode !== 'multiple') return;
    const selectedIds = new Set(
      [...options.querySelectorAll('input:checked')].map(input => input.value)
    );
    const selectedPlaylists = state.playlists.filter(playlist => selectedIds.has(String(playlist.id)));
    close();
    selectedPlaylists.forEach(playlist => { void addSongsToPlaylist(selectedSongs, playlist); });
  };
  const onBackdropClick = event => {
    if (event.target === modal) close();
  };
  const onKeyDown = event => {
    if (event.key === 'Escape') close();
  };

  renderSingleChoice();
  modeToggle.addEventListener('click', toggleMode);
  options.addEventListener('click', handleOptionClick);
  applyButton.addEventListener('click', apply);
  cancelButton.addEventListener('click', close);
  closeButton.addEventListener('click', close);
  options.addEventListener('change', updateApplyState);
  modal.addEventListener('click', onBackdropClick);
  document.addEventListener('keydown', onKeyDown);
  modal.classList.add('open');
}

export function toggleExpandedCover(forceState) {
  const requestedState = typeof forceState === 'boolean' ? forceState : !state.isCoverExpanded;
  const newState = requestedState && !state.isLyricsOpen;
  state.isCoverExpanded = newState;

  if (expandedCoverWidget) {
    expandedCoverWidget.classList.toggle('open', state.isCoverExpanded);
  }

  if (playerLeftPanel) {
    playerLeftPanel.classList.toggle('cover-hidden', state.isCoverExpanded);
  }

  setTimeout(() => {
    updateTitleMarquee();
  }, 260);
}

