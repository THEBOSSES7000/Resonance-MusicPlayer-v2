function fileToDataUrl(file) {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = () => {
      if (typeof reader.result === 'string') resolve(reader.result);
      else reject(new Error('No se pudo leer la imagen de portada.'));
    };
    reader.onerror = () => reject(reader.error || new Error('No se pudo leer la imagen de portada.'));
    reader.readAsDataURL(file);
  });
}

async function persistPlaylistCover(playlistId) {
  if (!tempCoverFile) return tempModalCoverUrl;
  const tauriCore = window.__TAURI__?.core;
  if (typeof tauriCore?.invoke === 'function' && typeof tauriCore.convertFileSrc === 'function') {
    const extensionsByMime = {
      'image/jpeg': 'jpg',
      'image/png': 'png',
      'image/webp': 'webp',
      'image/gif': 'gif'
    };
    const fileExtension = tempCoverFile.name.match(/\.([a-z0-9]+)$/i)?.[1]?.toLowerCase();
    const extension = extensionsByMime[tempCoverFile.type] || fileExtension;
    if (!extension || !['jpg', 'jpeg', 'png', 'webp', 'gif'].includes(extension)) {
      throw new Error('Formato de imagen no válido. Usa JPG, PNG, WEBP o GIF.');
    }
    const imageData = Array.from(new Uint8Array(await tempCoverFile.arrayBuffer()));
    const savedPath = await tauriCore.invoke('save_playlist_cover', {
      playlistId: String(playlistId),
      imageData,
      extension
    });
    return tauriCore.convertFileSrc(savedPath);
  }
  return fileToDataUrl(tempCoverFile);
}

