const expandedCoverImg = document.getElementById('expanded-cover-img');
const expandedCoverPlaceholder = document.getElementById('expanded-cover-placeholder');

let prevVolume = 0.8;
let tooltipTimeout = null;
let masterVolume = 1;
let audioContext = null;
let equalizerEnabled = false;
let audioAnalysisEnabled = false;
let replayGainEnabled = false;
let crossfadeEnabled = false;
let crossfadeDuration = 4;
let crossfadeAutomaticOnly = false;
let playbackFadeInEnabled = false;
let playbackFadeInDuration = 2;
let playbackFadeOutEnabled = false;
let playbackFadeOutDuration = 2;
let crossfadeInProgress = false;
let trackFadeStarted = false;
let audioDeckNodes = new Map();
let equalizerGains = [0, 0, 0, 0, 0, 0, 0];
let rampAnimationId = null;
let crossfadeAnimationResolve = null;
let crossfadeGeneration = 0;

const EQUALIZER_FREQUENCIES = [60, 150, 400, 1000, 2400, 6000, 15000];

function getDeckState(deck) {
  if (!audioDeckNodes.has(deck)) {
    audioDeckNodes.set(deck, {
      transitionLevel: deck === audio ? 1 : 0,
      envelopeLevel: 1,
      replayGainLevel: 1,
      source: null,
      filters: [],
      analyser: null,
      analysisData: null,
      ramps: new Map()
    });
  }
  return audioDeckNodes.get(deck);
}

function getReplayGainLevel(track) {
  if (!replayGainEnabled || !Number.isFinite(track?.replayGainDb)) return 1;
  const db = Math.max(-24, Math.min(6, track.replayGainDb));
  return Math.min(1, 10 ** (db / 20));
}

function updateDeckVolume(deck) {
  const deckState = getDeckState(deck);
  const volume = masterVolume * deckState.transitionLevel * deckState.envelopeLevel * deckState.replayGainLevel;
  const clamped = Math.max(0, Math.min(1, volume));
  deck.volume = clamped;
  if (nativeAudioActive && deck === audio) {
    void nativeSetVolume(clamped);
  }
}

function setDeckTrack(deck, track, startWithFade = false) {
  const deckState = getDeckState(deck);
  cancelDeckRamp(deck, 'envelopeLevel');
  deckState.replayGainLevel = getReplayGainLevel(track);
  deckState.envelopeLevel = startWithFade && playbackFadeInEnabled ? 0 : 1;
  deckState.transitionLevel = 1;
  trackFadeStarted = false;
  updateDeckVolume(deck);
  if (startWithFade && playbackFadeInEnabled) {
    void rampDeckValue(deck, 'envelopeLevel', 1, playbackFadeInDuration);
  }
}

function cancelDeckRamp(deck, property) {
  const ramps = getDeckState(deck).ramps;
  const ramp = ramps.get(property);
  if (!ramp) return;
  if (ramp.animationId !== null) cancelAnimationFrame(ramp.animationId);
  ramps.delete(property);
  ramp.resolve();
}

function rampDeckValue(deck, property, target, durationSeconds) {
  const deckState = getDeckState(deck);
  cancelDeckRamp(deck, property);
  const startValue = deckState[property];
  const startTime = performance.now();
  const durationMs = Math.max(1, durationSeconds * 1000);
  return new Promise(resolve => {
    const ramp = { animationId: null, resolve };
    const step = now => {
      if (deckState.ramps.get(property) !== ramp) return;
      const progress = Math.min(1, (now - startTime) / durationMs);
      deckState[property] = startValue + (target - startValue) * progress;
      updateDeckVolume(deck);
      if (progress >= 1) {
        deckState.ramps.delete(property);
        resolve();
      } else {
        ramp.animationId = requestAnimationFrame(step);
      }
    };
    deckState.ramps.set(property, ramp);
    ramp.animationId = requestAnimationFrame(step);
  });
}

function otherDeck(deck) {
  return deck === primaryAudio ? secondaryAudio : primaryAudio;
}

function cancelCrossfade() {
  crossfadeGeneration++;
  if (rampAnimationId !== null) cancelAnimationFrame(rampAnimationId);
  rampAnimationId = null;
  const resolveAnimation = crossfadeAnimationResolve;
  crossfadeAnimationResolve = null;
  resolveAnimation?.();
  crossfadeInProgress = false;
  crossfadeVisualActive = false;
  updateCrossfadeIndicator();
  audioDecks.forEach(deck => {
    const deckState = getDeckState(deck);
    deckState.transitionLevel = deck === audio ? 1 : 0;
    if (deck !== audio) {
      deck.pause();
      deck.removeAttribute('src');
      deck.load();
    }
    updateDeckVolume(deck);
  });
}

export function stopPlaybackForDeletedFile() {
  cancelCrossfade();
  audioDecks.forEach(deck => {
    deck.pause();
    deck.removeAttribute('src');
    deck.load();
  });
  audio = primaryAudio;
  currentTitleTextEl.textContent = 'Sin reproducción activa';
  currentArtistEl.textContent = 'Selecciona una canción';
  updateWindowSongTitle();
  currentArtistEl.classList.remove('is-active');
  updateAudioQuality(null);
  resetPlayerCoverToPlaceholder();
  timeCurrentEl.textContent = '0:00';
  timeTotalEl.textContent = '0:00';
  playIcon.className = 'ph-fill ph-play';
  resetProgressVisual();
  syncPlayingUI(false);
  notifyDiscordPresence(true, true);
}

export function showVolumeTooltip(val) {
  if (!volumeTooltip) return;
  if (document.documentElement.dataset.playerVolumePercentage === 'true') {
    volumeTooltip.classList.remove('visible');
    return;
  }
  volumeTooltip.textContent = `${Math.round(val)}%`;
  volumeTooltip.classList.add('visible');
  clearTimeout(tooltipTimeout);
  tooltipTimeout = setTimeout(() => {
    volumeTooltip.classList.remove('visible');
  }, 1200);
}

export function setAppVolume(val, showTooltip = true) {
  const clamped = Math.max(0, Math.min(100, Math.round(val)));
  localStorage.setItem('pn_volume', String(clamped));
  masterVolume = clamped / 100;
  audioDecks.forEach(updateDeckVolume);
  if (volumeRange) volumeRange.value = clamped;
  if (volumePercentage) volumePercentage.textContent = `${clamped}%`;

  if (clamped === 0) {
    volIcon.className = "ph ph-speaker-simple-x";
  } else if (clamped < 50) {
    volIcon.className = "ph ph-speaker-low";
  } else {
    volIcon.className = "ph ph-speaker-high";
  }
  volIcon.classList.toggle('is-muted', clamped === 0);

  if (clamped > 0) {
    prevVolume = clamped / 100;
  }
  if (showTooltip) showVolumeTooltip(clamped);
}

export async function configureEqualizer(enabled, gains = equalizerGains) {
  equalizerGains = EQUALIZER_FREQUENCIES.map((_, index) =>
    Math.max(-12, Math.min(12, Number(gains[index]) || 0))
  );
  equalizerEnabled = Boolean(enabled);
  if (!equalizerEnabled && !audioContext) return;

  if (!audioContext) {
    const AudioContextClass = window.AudioContext || window.webkitAudioContext;
    if (!AudioContextClass) {
      equalizerEnabled = false;
      throw new Error('El navegador no admite ecualización de audio.');
    }
    audioContext = new AudioContextClass();
  }

  for (const deck of audioDecks) {
    ensureDeckAudioNodes(deck);
    const deckState = getDeckState(deck);
    deckState.filters.forEach((filter, index) => {
      filter.gain.setTargetAtTime(equalizerGains[index], audioContext.currentTime, 0.025);
    });
    routeDeckAudio(deck);
  }

  syncAudioContextPlaybackState();
}

function ensureDeckAudioNodes(deck) {
  const deckState = getDeckState(deck);
  if (!deckState.source) {
    deckState.source = audioContext.createMediaElementSource(deck);
    deckState.filters = EQUALIZER_FREQUENCIES.map((frequency, index) => {
      const filter = audioContext.createBiquadFilter();
      filter.type = index === 0 ? 'lowshelf' : index === EQUALIZER_FREQUENCIES.length - 1 ? 'highshelf' : 'peaking';
      filter.frequency.value = frequency;
      filter.Q.value = 1;
      filter.gain.value = equalizerGains[index];
      return filter;
    });
  }
  if (!deckState.analyser) {
    deckState.analyser = audioContext.createAnalyser();
    deckState.analyser.fftSize = 1024;
    deckState.analysisData = new Uint8Array(deckState.analyser.fftSize);
  }
}

function routeDeckAudio(deck) {
  const deckState = getDeckState(deck);
  deckState.source.disconnect();
  deckState.filters.forEach(filter => filter.disconnect());
  deckState.analyser?.disconnect();

  let outputNode = deckState.source;
  if (equalizerEnabled) {
    outputNode.connect(deckState.filters[0]);
    for (let index = 0; index < deckState.filters.length - 1; index += 1) {
      deckState.filters[index].connect(deckState.filters[index + 1]);
    }
    outputNode = deckState.filters[deckState.filters.length - 1];
  }
  if (audioAnalysisEnabled && deckState.analyser) {
    outputNode.connect(deckState.analyser);
    deckState.analyser.connect(audioContext.destination);
  } else {
    outputNode.connect(audioContext.destination);
  }
}

function syncAudioContextPlaybackState() {
  if (!audioContext || audioContext.state === 'closed') return;
  const hasPlayingDeck = audioDecks.some(deck => !deck.paused && !deck.ended);
  if (hasPlayingDeck && audioContext.state === 'suspended') {
    void audioContext.resume().catch(error => {
      console.error('No se pudo reanudar el contexto de audio:', error);
    });
  } else if (!hasPlayingDeck && audioContext.state === 'running') {
    void audioContext.suspend().catch(error => {
      console.error('No se pudo suspender el contexto de audio:', error);
    });
  }
}

export async function configureAudioAnalysis(enabled) {
  // Con audio nativo la energía llega por IPC desde Rust; no crear AudioContext
  // (evita la segunda sesión WASAPI de msedgewebview2.exe en el mezclador de Windows).
  if (nativeAudioActive || (nativeAudioEnabled && !audio.currentSrc && !audio.src)) {
    audioAnalysisEnabled = Boolean(enabled);
    if (enabled) ensureNativeEnergyListener();
    return true;
  }

  if (!enabled && !audioContext) {
    audioAnalysisEnabled = false;
    return false;
  }
  if (enabled && !audioContext) {
    const AudioContextClass = window.AudioContext || window.webkitAudioContext;
    if (!AudioContextClass) return false;
    audioContext = new AudioContextClass();
  }

  audioAnalysisEnabled = Boolean(enabled);
  for (const deck of audioDecks) {
    ensureDeckAudioNodes(deck);
    routeDeckAudio(deck);
  }
  syncAudioContextPlaybackState();
  return true;
}

export function getAudioLevel() {
  // Preferir energía del motor nativo (sin Web Audio API → sin sesión extra en Windows)
  if (nativeAudioActive) {
    return audioAnalysisEnabled ? nativeAudioEnergy : 0;
  }
  if (!audioAnalysisEnabled || !audioContext || audioContext.state !== 'running') return 0;
  const deckState = getDeckState(audio);
  if (!deckState.analyser || !deckState.analysisData || audio.paused) return 0;
  deckState.analyser.getByteTimeDomainData(deckState.analysisData);
  let squaredSum = 0;
  for (let index = 0; index < deckState.analysisData.length; index += 1) {
    const sample = (deckState.analysisData[index] - 128) / 128;
    squaredSum += sample * sample;
  }
  return Math.min(1, Math.sqrt(squaredSum / deckState.analysisData.length) * 4);
}

export function setReplayGainEnabled(enabled) {
  replayGainEnabled = Boolean(enabled);
  audioDecks.forEach(deck => {
    const track = deck === audio ? state.activeQueue[state.currentTrackIndex] : null;
    getDeckState(deck).replayGainLevel = getReplayGainLevel(track);
    updateDeckVolume(deck);
  });
}

export function updateReplayGainForTrack(track) {
  const activeTrack = state.activeQueue[state.currentTrackIndex];
  const updatedPath = track?.file?.path?.toLocaleLowerCase();
  if (!updatedPath || activeTrack?.file?.path?.toLocaleLowerCase() !== updatedPath) return;
  getDeckState(audio).replayGainLevel = getReplayGainLevel(activeTrack);
  updateDeckVolume(audio);
}

export function setCrossfadeSettings(enabled, duration = crossfadeDuration, automaticOnly = crossfadeAutomaticOnly) {
  crossfadeEnabled = Boolean(enabled);
  crossfadeDuration = Math.max(1, Math.min(12, Number(duration) || 4));
  crossfadeAutomaticOnly = Boolean(automaticOnly);
  // Al desactivar: cancelar fundido en curso para que no quede "pegado"
  if (!crossfadeEnabled && crossfadeInProgress) {
    try { cancelCrossfade(); } catch (_) {}
  }
  if (crossfadeEnabled) {
    cancelDeckRamp(audio, 'envelopeLevel');
    getDeckState(audio).envelopeLevel = 1;
    trackFadeStarted = false;
    updateDeckVolume(audio);
  }
  if (!crossfadeEnabled && crossfadeInProgress) cancelCrossfade();
}

export function setCrossfadeIndicatorEnabled(enabled) {
  crossfadeIndicatorEnabled = Boolean(enabled);
  updateCrossfadeIndicator();
}

export function setPlaybackFadeSettings(fadeInEnabled, fadeInDuration, fadeOutEnabled, fadeOutDuration) {
  playbackFadeInEnabled = Boolean(fadeInEnabled);
  playbackFadeInDuration = Math.max(1, Math.min(5, Number(fadeInDuration) || 2));
  playbackFadeOutEnabled = Boolean(fadeOutEnabled);
  playbackFadeOutDuration = Math.max(1, Math.min(5, Number(fadeOutDuration) || 2));
  if (!playbackFadeInEnabled && !playbackFadeOutEnabled) {
    cancelDeckRamp(audio, 'envelopeLevel');
    getDeckState(audio).envelopeLevel = 1;
    trackFadeStarted = false;
    updateDeckVolume(audio);
  }
}

export async function setAudioOutputDevice(deviceId) {
  if (audioDecks.some(deck => typeof deck.setSinkId !== 'function')) {
    throw new Error('La selección de dispositivo de salida no está disponible.');
  }
  const previousDeviceId = audio.sinkId || '';
  try {
    const outputChanges = audioDecks.map(deck => deck.setSinkId(deviceId));
    if (audioContext && typeof audioContext.setSinkId === 'function') {
      outputChanges.push(audioContext.setSinkId(deviceId));
    }
    await Promise.all(outputChanges);
  } catch (error) {
    const restoreChanges = audioDecks.map(deck => deck.setSinkId(previousDeviceId));
    if (audioContext && typeof audioContext.setSinkId === 'function') {
      restoreChanges.push(audioContext.setSinkId(previousDeviceId));
    }
    await Promise.allSettled(restoreChanges);
    throw error;
  }
}

function resetInactiveDeck() {
  const inactiveDeck = otherDeck(audio);
  inactiveDeck.pause();
  inactiveDeck.removeAttribute('src');
  inactiveDeck.load();
  const inactiveState = getDeckState(inactiveDeck);
  inactiveState.transitionLevel = 0;
  inactiveState.envelopeLevel = 1;
  inactiveState.replayGainLevel = 1;
  updateDeckVolume(inactiveDeck);
}

async function crossfadeToNext(index) {
  if (crossfadeInProgress || index < 0 || index >= state.activeQueue.length) return false;
  const nextTrack = state.activeQueue[index];
  // Motor nativo: fundido real con dos sinks en Rust
  if (nativeAudioActive && canUseNativeAudio(nextTrack)) {
    return nativeCrossfadeToNext(index);
  }
  // Si el motor nativo está habilitado pero aún no activo, no forzar HTML dual-deck
  if (nativeAudioEnabled && canUseNativeAudio(nextTrack) && !nativeAudioActive) {
    // Primera pista o fallback: dejar que loadSong normal se encargue
    return false;
  }
  crossfadeInProgress = true;
  const generation = ++crossfadeGeneration;
  const outgoingDeck = audio;
  const incomingDeck = otherDeck(outgoingDeck);
  const outgoingState = getDeckState(outgoingDeck);
  const incomingState = getDeckState(incomingDeck);
  incomingDeck.pause();
  incomingState.transitionLevel = 0;
  incomingState.envelopeLevel = 1;
  updateDeckVolume(incomingDeck);

  try {
    await ensureSongMetadata(state.activeQueue[index]);
    if (generation !== crossfadeGeneration) return true;
    await loadSong(index, false, true, incomingDeck, true, generation);
    if (generation !== crossfadeGeneration) return true;
    await audio.play();
    syncPlayingUI(true);
    playIcon.className = "ph-fill ph-pause";

    const outgoingRemaining = Number.isFinite(outgoingDeck.duration)
      ? Math.max(0.25, outgoingDeck.duration - outgoingDeck.currentTime)
      : crossfadeDuration;
    const incomingDuration = Number.isFinite(audio.duration) ? audio.duration : crossfadeDuration * 2;
    const duration = Math.max(0.25, Math.min(crossfadeDuration, outgoingRemaining, incomingDuration / 2));
    const startTime = performance.now();
    crossfadeVisualActive = true;
    updateCrossfadeIndicator();
    await new Promise(resolve => {
      crossfadeAnimationResolve = resolve;
      const step = now => {
        if (!crossfadeInProgress) return;
        const progress = Math.min(1, (now - startTime) / (duration * 1000));
        outgoingState.transitionLevel = 1 - progress;
        incomingState.transitionLevel = progress;
        updateDeckVolume(outgoingDeck);
        updateDeckVolume(incomingDeck);
        if (progress >= 1) {
          rampAnimationId = null;
          crossfadeAnimationResolve = null;
          resolve();
        } else {
          rampAnimationId = requestAnimationFrame(step);
        }
      };
      rampAnimationId = requestAnimationFrame(step);
    });

    if (generation !== crossfadeGeneration || !crossfadeInProgress) return true;
    outgoingDeck.pause();
    outgoingDeck.removeAttribute('src');
    outgoingDeck.load();
    outgoingState.transitionLevel = 0;
    incomingState.transitionLevel = 1;
    updateDeckVolume(outgoingDeck);
    updateDeckVolume(incomingDeck);
    crossfadeInProgress = false;
    crossfadeVisualActive = false;
    updateCrossfadeIndicator();
    return true;
  } catch (error) {
    if (generation !== crossfadeGeneration) return true;
    console.error('No se pudo iniciar el fundido cruzado:', error);
    if (audio === incomingDeck) audio = outgoingDeck;
    incomingDeck.pause();
    incomingDeck.removeAttribute('src');
    incomingDeck.load();
    incomingState.transitionLevel = 0;
    outgoingState.transitionLevel = 1;
    updateDeckVolume(incomingDeck);
    updateDeckVolume(outgoingDeck);
    crossfadeInProgress = false;
    crossfadeVisualActive = false;
    updateCrossfadeIndicator();
    await loadSong(index, true, true);
    return false;
  }
}

/**
 * Crossfade nativo: solapa la pista actual con la siguiente bajando/subiendo volumen.
 * Actualiza la UI de la cola como un cambio de pista normal.
 */
async function nativeCrossfadeToNext(index) {
  if (crossfadeInProgress || index < 0 || index >= state.activeQueue.length) return false;
  const track = state.activeQueue[index];
  const path = track?.file?.path || track?.path;
  if (!path || typeof path !== 'string') return false;

  crossfadeInProgress = true;
  const generation = ++crossfadeGeneration;
  crossfadeVisualActive = true;
  updateCrossfadeIndicator();

  try {
    // Historial + índice como loadSong
    if (state.currentTrackIndex !== -1 && state.currentTrackIndex !== index) {
      const oldIndex = state.currentTrackIndex;
      if (index > oldIndex) {
        for (let i = oldIndex; i < index; i++) {
          const t = state.activeQueue[i];
          if (t && (state.playbackHistory.length === 0 || state.playbackHistory[0] !== t)) {
            state.playbackHistory.unshift(t);
          }
        }
      }
      if (state.playbackHistory.length > 100) {
        state.playbackHistory = state.playbackHistory.slice(0, 100);
      }
    }

    await ensureSongMetadata(track);
    if (generation !== crossfadeGeneration) return true;

    const vol = typeof masterVolume === 'number' ? masterVolume : 0.8;
    const gain = getReplayGainLevel(track);
    const st = await nativeInvoke('native_audio_crossfade', {
      path,
      durationSecs: crossfadeDuration,
      volume: Math.max(0, Math.min(1, vol * gain))
    });
    if (generation !== crossfadeGeneration) return true;

    nativeAudioActive = true;
    nativeLastEnded = false;
    state.currentTrackIndex = index;
    applyNativeStatusToUi(st);
    startNativeProgressPoll();

    if (st.durationSeconds > 0) track.duration = st.durationSeconds;

    // UI de la pista nueva
    try {
      const lib = getSongByIdOrPath(track.file?.path || track.path || track.id);
      if (lib) {
        if (lib.coverPath) track.coverPath = lib.coverPath;
        if (lib.coverUrl) track.coverUrl = lib.coverUrl;
      }
    } catch (_) {}
    paintPlayerCover(resolveCoverUrl(track), track);
    void loadWaveformForTrack(track);
    void import('./scanner.js')
      .then(async mod => {
        const [, , cover] = await Promise.all([
          mod.ensureSongLyrics?.(track),
          mod.ensureSongTechDetails?.(track),
          mod.ensureSongCover?.(track)
        ]);
        if (state.activeQueue[state.currentTrackIndex] !== track) return;
        try {
          updateAudioQuality(track);
          updateLyricsButtonVisibility(track);
          updateLyricsUI?.();
          paintPlayerCover(cover || resolveCoverUrl(track), track);
        } catch (_) {}
      })
      .catch(() => {});

    const titleClean = (track.title || '').trim();
    const artistClean = (track.artist || '').trim();
    updateWindowSongTitle(track);
    currentTitleTextEl.textContent = titleClean;
    currentArtistEl.textContent = artistClean || 'Desconocido';
    currentArtistEl.classList.toggle('is-active', Boolean(artistClean && artistClean !== 'Desconocido'));
    updateAudioQuality(track);
    void updateWindowsMediaMetadata(track);
    updateWindowsMediaPlayback(true);
    updateLyricsButtonVisibility(track);
    updateTitleMarquee();
    updateFavIcon();
    renderQueue();
    updateLyricsUI();
    notifyDiscordPresence(true);
    playIcon.className = 'ph-fill ph-pause';
    syncPlayingUI(true);
    setDeckTrack(audio, track, false);
    getDeckState(audio).transitionLevel = 1;
    updateDeckVolume(audio);

    // El icono se apaga cuando status.crossfading pase a false (applyNativeStatusToUi)
    // Respaldo por tiempo por si el poll no lo ve
    const gen = generation;
    window.setTimeout(() => {
      if (gen !== crossfadeGeneration) return;
      if (crossfadeInProgress) {
        crossfadeInProgress = false;
        crossfadeVisualActive = false;
        updateCrossfadeIndicator();
      }
    }, Math.ceil(crossfadeDuration * 1000) + 200);

    return true;
  } catch (error) {
    if (generation !== crossfadeGeneration) return true;
    console.error('Crossfade nativo falló:', error);
    crossfadeInProgress = false;
    crossfadeVisualActive = false;
    updateCrossfadeIndicator();
    await loadSong(index, true, true);
    return false;
  }
}

export function shuffleArray(arr) {
  const copy = [...arr];
  for (let i = copy.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [copy[i], copy[j]] = [copy[j], copy[i]];
  }
  return copy;
}

export async function playNextInQueue(song, skipDuplicateConfirmation = false) {
  if (!song) return;

  const alreadyInQueue = state.activeQueue.some(s => s.id === song.id || (s.title === song.title && s.artist === song.artist));
  if (alreadyInQueue && !skipDuplicateConfirmation) {
    const proceed = await showConfirmDialog({
      title: "¿Agregar canción duplicada?",
      message: `La canción "${song.title}" ya se encuentra en la lista de reproducción. ¿Estás seguro de que quieres agregarla de nuevo?`,
      confirmText: "Agregar",
      cancelText: "Cancelar"
    });
    if (!proceed) return;
  }

  const enqueuedSong = { ...song, isEnqueuedNext: true };

  if (state.activeQueue.length === 0 || state.currentTrackIndex === -1) {
    state.activeQueue = [enqueuedSong];
    loadSong(0, true);
    return;
  }

  let insertIndex = state.currentTrackIndex + 1;
  while (insertIndex < state.activeQueue.length && state.activeQueue[insertIndex].isEnqueuedNext === true) {
    insertIndex++;
  }

  state.activeQueue.splice(insertIndex, 0, enqueuedSong);
  renderQueue();
}

export async function addToQueue(song, skipDuplicateConfirmation = false) {
  if (!song) return;

  const alreadyInQueue = state.activeQueue.some(s => s.id === song.id || (s.title === song.title && s.artist === song.artist));
  if (alreadyInQueue && !skipDuplicateConfirmation) {
    const proceed = await showConfirmDialog({
      title: "¿Agregar canción duplicada?",
      message: `La canción "${song.title}" ya se encuentra en la cola de reproducción. ¿Estás seguro de que quieres agregarla?`,
      confirmText: "Agregar",
      cancelText: "Cancelar"
    });
    if (!proceed) return;
  }

  const enqueuedSong = { ...song, isEnqueuedNext: false };

  if (state.activeQueue.length === 0 || state.currentTrackIndex === -1) {
    state.activeQueue = [enqueuedSong];
    loadSong(0, true);
    return;
  }

  state.activeQueue.push(enqueuedSong);
  renderQueue();
}

export function removeFromQueue(index) {
  if (index < 0 || index >= state.activeQueue.length) return;
  if (index === state.currentTrackIndex) {
    nextSong();
  }
  state.activeQueue.splice(index, 1);
  if (index < state.currentTrackIndex) {
    state.currentTrackIndex--;
  }
  renderQueue();
}

export function updateTitleMarquee() {
  const box = document.getElementById('title-marquee-box');
  const titleEl = document.getElementById('current-title');
  if (!box || !titleEl) return;

  box.classList.remove('is-overflowing');
  titleEl.style.removeProperty('--marquee-dist');
  titleEl.style.removeProperty('--marquee-duration');

  requestAnimationFrame(() => {
    const overflow = titleEl.scrollWidth - box.clientWidth;
    if (overflow > 4) {
      box.classList.add('is-overflowing');
      titleEl.style.setProperty('--marquee-dist', `${overflow + 14}px`);
      const duration = Math.max(6, Math.min(16, overflow / 18));
      titleEl.style.setProperty('--marquee-duration', `${duration}s`);
    }
  });
}

export async function loadSong(index, autoPlay = true, recordHistory = true, targetDeck = audio, preserveCrossfade = false, crossfadeToken = null) {
  if (index < 0 || index >= state.activeQueue.length) return;
  if (!preserveCrossfade && crossfadeInProgress) cancelCrossfade();

  if (recordHistory && state.currentTrackIndex !== -1) {
    const oldIndex = state.currentTrackIndex;
    const newIndex = index;

    if (newIndex > oldIndex) {
      for (let i = oldIndex; i < newIndex; i++) {
        const track = state.activeQueue[i];
        if (track) {
          if (state.playbackHistory.length === 0 || state.playbackHistory[0] !== track) {
            state.playbackHistory.unshift(track);
          }
        }
      }
    } else if (newIndex < oldIndex) {
      const upcomingSet = new Set(state.activeQueue.slice(newIndex));
      state.playbackHistory = state.playbackHistory.filter(t => !upcomingSet.has(t));
    }

    if (state.playbackHistory.length > 100) {
      state.playbackHistory = state.playbackHistory.slice(0, 100);
    }
  }

  const track = state.activeQueue[index];
  const currentTrack = state.currentTrackIndex < 0
    ? null
    : state.activeQueue[state.currentTrackIndex];
  const trackChanged = !currentTrack ||
    currentTrack.id !== track.id ||
    (currentTrack.file?.path || currentTrack.audioUrl) !== (track.file?.path || track.audioUrl);
  if (preserveCrossfade) {
    await ensureSongMetadata(track);
    if (crossfadeToken !== crossfadeGeneration) return;
  }
  state.currentTrackIndex = index;

  await ensureSongMetadata(track);
  if (preserveCrossfade && crossfadeToken !== crossfadeGeneration) return;

  if (trackChanged) {
    setPlaybackSpeed(1);
    setPlaybackPitch(0);
  }
  const useNative = canUseNativeAudio(track) && targetDeck === audio && !preserveCrossfade;
  let audioSrc = null;
  if (useNative) {
    try {
      // Cargar ya con autoPlay para evitar race pause/play al cambiar de pista
      await nativeLoadTrack(track, Boolean(autoPlay));
    } catch (error) {
      console.error('Audio nativo falló, usando HTML Audio:', error);
      nativeAudioActive = false;
      audioSrc = resolveAudioUrl(track);
      if (!audioSrc) return;
      targetDeck.src = audioSrc;
    }
  } else {
    nativeAudioActive = false;
    stopNativeProgressPoll();
    audioSrc = resolveAudioUrl(track);
    if (!audioSrc) {
      console.error('No se pudo resolver la URL de audio de la pista:', track?.title);
      return;
    }
    targetDeck.src = audioSrc;
  }

  // Letras + specs técnicas bajo demanda; actualizar UI cuando lleguen
  // Sincronizar carátula desde la biblioteca canónica (misma ruta)
  try {
    const lib = getSongByIdOrPath(track.file?.path || track.path || track.id);
    if (lib) {
      if (lib.coverPath) track.coverPath = lib.coverPath;
      if (lib.coverUrl) track.coverUrl = lib.coverUrl;
    }
  } catch (_) {}

  paintPlayerCover(resolveCoverUrl(track), track);

  // Waveform real de la pista (siempre si cambió la ruta de archivo)
  {
    const wavePath = track?.file?.path || track?.path || '';
    if (trackChanged || wavePath !== waveformPeaksPath || !waveformPeaks) {
      void loadWaveformForTrack(track);
    }
  }

  void import('./scanner.js')
    .then(async mod => {
      const [, , cover] = await Promise.all([
        mod.ensureSongLyrics?.(track),
        mod.ensureSongTechDetails?.(track),
        mod.ensureSongCover?.(track)
      ]);
      if (state.activeQueue[state.currentTrackIndex] !== track) return;
      try {
        updateAudioQuality(track);
        updateLyricsButtonVisibility(track);
        updateLyricsUI?.();
        paintPlayerCover(cover || resolveCoverUrl(track), track);
      } catch (_) { /* UI puede no estar lista */ }
    })
    .catch(err => console.warn('No se pudieron cargar letras/specs/carátula:', err));
  if (targetDeck !== audio) audio = targetDeck;
  setDeckTrack(targetDeck, track, autoPlay && !preserveCrossfade);
  if (preserveCrossfade) {
    getDeckState(targetDeck).transitionLevel = 0;
    updateDeckVolume(targetDeck);
  }
  else resetInactiveDeck();

  const titleClean = (track.title || "").trim();
  const artistClean = (track.artist || "").trim();

  updateWindowSongTitle(track);
  currentTitleTextEl.textContent = titleClean;
  currentArtistEl.textContent = artistClean || "Desconocido";
  currentArtistEl.classList.toggle('is-active', Boolean(artistClean && artistClean !== 'Desconocido'));
  updateAudioQuality(track);
  void updateWindowsMediaMetadata(track);
  updateWindowsMediaPlayback(Boolean(autoPlay && !preserveCrossfade));

  // Carátula: paintPlayerCover (arriba + ensureSongCover async)

  updateLyricsButtonVisibility(track);

  updateTitleMarquee();
  updateFavIcon();
  renderQueue();
  updateLyricsUI();
  notifyDiscordPresence(true);

  if (autoPlay) {
    if (nativeAudioActive) {
      // Load ya hizo autoPlay (+ fade-in). Solo refrescar UI; no llamar play (cancelaría el fade).
      startNativeProgressPoll();
      playIcon.className = "ph-fill ph-pause";
      syncPlayingUI(true);
      updateWindowsMediaPlayback(true);
      updateWindowsMediaPosition(true);
      nativeInvoke('native_audio_status')
        .then(st => applyNativeStatusToUi(st))
        .catch(() => {});
    } else {
      audio.play().then(() => {
        playIcon.className = "ph-fill ph-pause";
        syncPlayingUI(true);
      }).catch(e => {
        console.error(e);
        syncPlayingUI(false);
      });
    }
  } else {
    playIcon.className = "ph-fill ph-play";
    syncPlayingUI(false);
  }
  persistPlaybackSession(autoPlay);
}

export function togglePlay() {
  if (state.activeQueue.length === 0) return;
  if (state.currentTrackIndex === -1) {
    loadSong(0, true);
    return;
  }
  if (nativeAudioActive) {
    void nativeTogglePlay();
    return;
  }
  if (audio.paused) {
    audio.play().then(() => {
      playIcon.className = "ph-fill ph-pause";
      syncPlayingUI(true);
    }).catch(e => console.error(e));
  } else {
    if (crossfadeInProgress) {
      cancelCrossfade();
    }
    audio.pause();
    playIcon.className = "ph-fill ph-play";
    syncPlayingUI(false);
  }
}

export async function nextSong(isAutoEnd = false) {
  if (state.activeQueue.length === 0) return;

  const keepPaused = !isAutoEnd &&
    localStorage.getItem('pn_behavior_next_while_paused') === 'true' &&
    isPlaybackPaused();

  if (isAutoEnd && state.repeatMode === 'one') {
    restartCurrentTrack();
    return;
  }

  if (state.currentTrackIndex + 1 < state.activeQueue.length) {
    const nextIdx = state.currentTrackIndex + 1;
    const nextTrack = state.activeQueue[nextIdx];
    // Crossfade (nativo dual-sink o HTML dual-deck)
    const canCrossfade = crossfadeEnabled
      && (!crossfadeAutomaticOnly || isAutoEnd)
      && !keepPaused;
    if (canCrossfade && await crossfadeToNext(nextIdx)) return;
    loadSong(nextIdx, !keepPaused, true);
  } else {
    if (state.repeatMode === 'all') {
      if (state.isShuffle) {
        state.activeQueue = shuffleArray(state.activeQueue);
      }
      loadSong(0, !keepPaused, true);
    } else if (state.repeatMode === 'one') {
      if (keepPaused) audio.currentTime = 0;
      else restartCurrentTrack();
    } else {
      audio.pause();
      audio.currentTime = 0;
      playIcon.className = "ph-fill ph-play";
      syncPlayingUI(false);
    }
  }
}

export function seekBy(seconds) {
  if (!Number.isFinite(seconds) || !Number.isFinite(audio.duration) || audio.duration <= 0) return;
  if (nativeAudioActive) {
    const base = nativeShadow.currentTime || 0;
    const dur = nativeShadow.duration || 0;
    void nativeSeek(Math.max(0, Math.min(dur || base + seconds, base + seconds)));
    return;
  }
  audio.currentTime = Math.max(0, Math.min(audio.duration, audio.currentTime + seconds));
  if (Number.isFinite(audio.duration) && audio.duration > 0) {
    const progress = audio.currentTime / audio.duration;
    setProgressVisual(progress);
    progressContainer.setAttribute('aria-valuenow', String(Math.round(progress * 100)));
    updateProgressTimes(audio.currentTime, audio.duration);
  }
  updateWindowsMediaPosition(true);
  notifyDiscordPresence(true);
}

function restartCurrentTrack() {
  const deckState = getDeckState(audio);
  cancelDeckRamp(audio, 'envelopeLevel');
  deckState.envelopeLevel = playbackFadeInEnabled ? 0 : 1;
  trackFadeStarted = false;
  updateDeckVolume(audio);
  if (nativeAudioActive) {
    void (async () => {
      await seekPlayback(0);
      await nativeInvoke('native_audio_play', { fadeInSecs: nativeFadeInSecs() });
      nativeShadow.paused = false;
      startNativeProgressPoll();
      playIcon.className = 'ph-fill ph-pause';
      syncPlayingUI(true);
      updateWindowsMediaPlayback(true);
    })();
    return;
  }
  audio.currentTime = 0;
  audio.play().catch(error => console.error(error));
  if (playbackFadeInEnabled) void rampDeckValue(audio, 'envelopeLevel', 1, playbackFadeInDuration);
}

function handleTrackEffects(deck) {
  if (deck !== audio || !Number.isFinite(deck.duration) || deck.duration <= 0) return;
  const remaining = deck.duration - deck.currentTime;
  const hasQueuedNext = state.repeatMode !== 'one' && state.currentTrackIndex + 1 < state.activeQueue.length;

  if (crossfadeEnabled && hasQueuedNext && !crossfadeInProgress && remaining <= crossfadeDuration) {
    void crossfadeToNext(state.currentTrackIndex + 1);
    return;
  }

  if (
    playbackFadeOutEnabled &&
    (!crossfadeEnabled || !hasQueuedNext) &&
    !trackFadeStarted &&
    remaining <= playbackFadeOutDuration
  ) {
    trackFadeStarted = true;
    void rampDeckValue(deck, 'envelopeLevel', 0, Math.max(0.15, Math.min(playbackFadeOutDuration, remaining)));
  }
}

function updateRepeatButton() {
  const button = document.getElementById('btn-repeat');
  if (!button) return;
  button.classList.toggle('active-toggle', state.repeatMode !== 'off');
  button.innerHTML = `<i class="ph ${state.repeatMode === 'one' ? 'ph-repeat-once' : 'ph-repeat'}"></i>`;
  button.title = state.repeatMode === 'all'
    ? 'Repetir cola completa'
    : state.repeatMode === 'one'
      ? 'Repetir una pista'
      : 'Repetición desactivada';
}

export function setShuffleEnabled(enabled) {
  state.isShuffle = Boolean(enabled);
  const button = document.getElementById('btn-shuffle');
  if (button) {
    button.classList.toggle('active-toggle', state.isShuffle);
    button.title = state.isShuffle ? 'Desactivar aleatorio' : 'Aleatorio';
  }

  if (state.isShuffle && state.currentTrackIndex >= 0 && state.activeQueue.length > 1) {
    const played = state.activeQueue.slice(0, state.currentTrackIndex + 1);
    const upcoming = state.activeQueue.slice(state.currentTrackIndex + 1);
    if (upcoming.length > 1) {
      state.activeQueue = [...played, ...shuffleArray(upcoming)];
      renderQueue();
    }
  }
}

export function setRepeatMode(mode) {
  if (!['off', 'all', 'one'].includes(mode)) {
    throw new Error(`Modo de repetición no válido: ${mode}`);
  }
  state.repeatMode = mode;
  updateRepeatButton();
}

export function prevSong() {
  if (state.activeQueue.length === 0) return;

  const goDirectToPrev = localStorage.getItem('pn_behavior_prev_direct') === 'true';
  const keepPaused = localStorage.getItem('pn_behavior_next_while_paused') === 'true' &&
    audio.paused;
  if (!goDirectToPrev && getPlaybackPosition() > 3) {
    void seekPlayback(0);
    return;
  }

  if (state.playbackHistory.length > 0) {
    const lastPlayed = state.playbackHistory[0];
    const idx = state.activeQueue.indexOf(lastPlayed);
    if (idx !== -1) {
      loadSong(idx, !keepPaused, true);
      return;
    } else {
      state.playbackHistory.shift();
      state.activeQueue.splice(Math.max(0, state.currentTrackIndex), 0, lastPlayed);
      loadSong(Math.max(0, state.currentTrackIndex), !keepPaused, false);
      return;
    }
  }

  const prevIdx = (state.currentTrackIndex - 1 + state.activeQueue.length) % state.activeQueue.length;
  loadSong(prevIdx, !keepPaused, false);
}

function initPlayerPopoverControls() {
  const sleepPopover = document.getElementById('sleep-timer-popover');
  const speedPopover = document.getElementById('playback-speed-popover');
  const sleepButton = document.getElementById('btn-sleep-timer');
  const speedButton = document.getElementById('btn-playback-speed');
  const sleepMode = document.getElementById('sleep-timer-mode');
  const sleepUnit = document.getElementById('sleep-timer-unit');
  const sleepValue = document.getElementById('sleep-timer-value');
  const sleepValueRow = document.getElementById('sleep-timer-value-row');

  const setPopoverOpen = (button, popover, open) => {
    if (!button || !popover) return;
    popover.hidden = !open;
    button.setAttribute('aria-expanded', String(open));
  };
  sleepButton?.addEventListener('click', event => {
    event.stopPropagation();
    setPopoverOpen(speedButton, speedPopover, false);
    setPopoverOpen(sleepButton, sleepPopover, sleepPopover.hidden);
    updateSleepTimerStatus();
  });
  speedButton?.addEventListener('click', event => {
    event.stopPropagation();
    setPopoverOpen(sleepButton, sleepPopover, false);
    setPopoverOpen(speedButton, speedPopover, speedPopover.hidden);
  });
  [sleepPopover, speedPopover].forEach(popover => {
    popover?.addEventListener('click', event => event.stopPropagation());
  });
  document.addEventListener('click', () => {
    setPopoverOpen(sleepButton, sleepPopover, false);
    setPopoverOpen(speedButton, speedPopover, false);
  });
  document.addEventListener('keydown', event => {
    if (event.key !== 'Escape') return;
    setPopoverOpen(sleepButton, sleepPopover, false);
    setPopoverOpen(speedButton, speedPopover, false);
  });

  const updateSleepInputs = () => {
    const mode = sleepMode?.value || 'time';
    if (sleepValueRow) sleepValueRow.hidden = mode === 'end';
    if (sleepUnit) {
      sleepUnit.hidden = mode === 'end';
      const timeMode = mode === 'time';
      sleepUnit.querySelector('option[value="minutes"]').hidden = !timeMode;
      sleepUnit.querySelector('option[value="hours"]').hidden = !timeMode;
      sleepUnit.querySelector('option[value="tracks"]').hidden = timeMode;
      sleepUnit.value = timeMode ? 'minutes' : 'tracks';
    }
  };
  sleepMode?.addEventListener('change', updateSleepInputs);
  updateSleepInputs();
  document.getElementById('btn-start-sleep-timer')?.addEventListener('click', () => {
    cancelSleepTimer();
    sleepTimerMode = sleepMode?.value || 'time';
    if (sleepTimerMode === 'time') {
      const amount = Number(sleepValue?.value);
      if (!Number.isFinite(amount) || amount < 1) {
        sleepTimerMode = null;
        updateSleepTimerStatus();
        return;
      }
      const multiplier = sleepUnit?.value === 'hours' ? 60 * 60 * 1000 : 60 * 1000;
      sleepTimerDeadline = Date.now() + amount * multiplier;
      sleepTimerInterval = setInterval(() => {
        if (Date.now() >= sleepTimerDeadline) pauseForSleepTimer();
        else updateSleepTimerStatus();
      }, 1000);
    } else if (sleepTimerMode === 'tracks') {
      const amount = Number(sleepValue?.value);
      if (!Number.isSafeInteger(amount) || amount < 1) {
        sleepTimerMode = null;
        updateSleepTimerStatus();
        return;
      }
      sleepTimerRemainingTracks = amount;
    } else if (state.activeQueue.length === 0 || state.currentTrackIndex < 0) {
      sleepTimerMode = null;
      const status = document.getElementById('sleep-timer-status');
      if (status) status.textContent = 'Reproduce una lista antes de activar esta opción.';
      return;
    }
    sleepButton?.classList.add('active-toggle');
    updateSleepTimerStatus();
  });
  document.getElementById('btn-cancel-sleep-timer')?.addEventListener('click', cancelSleepTimer);

  const speedSlider = document.getElementById('playback-speed');
  const pitchSlider = document.getElementById('playback-pitch');
  const pitchCheckbox = document.getElementById('playback-preserve-pitch');
  speedSlider?.addEventListener('input', () => setPlaybackSpeed(Number(speedSlider.value)));
  pitchSlider?.addEventListener('input', () => setPlaybackPitch(Number(pitchSlider.value)));
  pitchCheckbox?.addEventListener('change', () => setPreservePitch(pitchCheckbox.checked));
  setPlaybackSpeed(playbackRate);
  setPlaybackPitch(playbackPitch);
  setPreservePitch(preservePitch);
}

export function initAudioPlayer() {
  initializeProgressWaveforms();
  setPlaybackSpeed(playbackRate);
  setPreservePitch(preservePitch);
  initWindowsMediaControlListener();
  window.addEventListener('pn-library-cache-cleared', () => {
    const track = state.currentTrackIndex < 0 ? null : state.activeQueue[state.currentTrackIndex];
    if (!track) return;
    currentTitleTextEl.textContent = track.title;
    currentArtistEl.textContent = track.artist || 'Desconocido';
    updateWindowSongTitle(track);
    currentArtistEl.classList.toggle('is-active', Boolean(track.artist && track.artist !== 'Desconocido'));
    updateAudioQuality(track);
    paintPlayerCover(resolveCoverUrl(track), track);
    updateTitleMarquee();
    syncPlayingUI(!audio.paused);
  });
  window.addEventListener('resize', () => setProgressVisual(lastProgressRatio));

  document.getElementById('play-pause-btn').addEventListener('click', togglePlay);
  document.getElementById('btn-next').addEventListener('click', () => nextSong(false));
  document.getElementById('btn-prev').addEventListener('click', prevSong);
  initPlayerPopoverControls();

  const btnShuffle = document.getElementById('btn-shuffle');
  btnShuffle.classList.toggle('active-toggle', state.isShuffle);
  btnShuffle.title = state.isShuffle ? 'Desactivar aleatorio' : 'Aleatorio';
  btnShuffle.addEventListener('click', () => {
    setShuffleEnabled(!state.isShuffle);
  });

  const btnRepeat = document.getElementById('btn-repeat');
  updateRepeatButton();
  btnRepeat.addEventListener('click', () => {
    if (state.repeatMode === 'off') {
      setRepeatMode('all');
    } else if (state.repeatMode === 'all') {
      setRepeatMode('one');
    } else {
      setRepeatMode('off');
    }
  });

  currentArtistEl.addEventListener('click', () => {
    const artistName = state.currentTrackIndex !== -1
      ? state.activeQueue[state.currentTrackIndex]?.artist
      : '';
    const primaryArtist = String(artistName || '').split(/\s*(?:,|&|\bfeat(?:uring)?\.?|\bft\.?|\bwith\b)\s*/i)[0].trim();
    if (primaryArtist && primaryArtist !== 'Desconocido') {
      navigateToView('artist', { artistName: primaryArtist });
    }
  });

  // Silenciar al hacer clic en el icono
  if (volIcon) {
    volIcon.addEventListener('click', () => {
      if (masterVolume > 0) {
        prevVolume = masterVolume;
        setAppVolume(0);
      } else {
        setAppVolume((prevVolume || 0.8) * 100);
      }
    });
  }

  // Desplazamiento manual del slider
  if (volumeRange) {
    volumeRange.addEventListener('input', (e) => {
      setAppVolume(Number(e.target.value));
    });
    volumeRange.addEventListener('mouseenter', () => {
      if (document.documentElement.dataset.playerVolumePercentage !== 'true') {
        showVolumeTooltip(masterVolume * 100);
      }
    });
  }

  // Rueda del mouse (de 5 en 5)
  if (volumeBox) {
    volumeBox.addEventListener('wheel', (e) => {
      e.preventDefault();
      const step = e.deltaY < 0 ? 5 : -5;
      const current = Math.round(masterVolume * 100);
      setAppVolume(current + step);
    }, { passive: false });
  }

  const savedVol = localStorage.getItem('pn_volume');
  const parsedSavedVol = savedVol === null ? 80 : Number(savedVol);
  const initialVolume = Number.isFinite(parsedSavedVol)
    ? Math.max(0, Math.min(100, parsedSavedVol))
    : 80;
  if (volumeRange) volumeRange.value = String(initialVolume);
  setAppVolume(initialVolume, false);
  if (window.__pnFlushSettingsToDisk) {
    void window.__pnFlushSettingsToDisk().catch(error => {
      console.error('No se pudo guardar el volumen restaurado:', error);
    });
  }

  audioDecks.forEach(deck => {
    deck.addEventListener('timeupdate', () => {
      if (deck !== audio) return;
      notifyDiscordPresence();
      if (!isSeeking) updateProgressTimes(deck.currentTime, deck.duration);
      if (deck.duration) {
        const pct = (deck.currentTime / deck.duration) * 100;
        if (!isSeeking) {
          setProgressVisual(pct / 100);
          progressContainer.setAttribute('aria-valuenow', String(Math.round(pct)));
        }
      }
      if (state.isLyricsOpen) {
        updateSyncedLyricsProgress(deck.currentTime);
      }
      if (!isSeeking) handleTrackEffects(deck);
    });

    deck.addEventListener('loadedmetadata', () => {
      if (deck !== audio) return;
      updateProgressTimes(deck.currentTime, deck.duration);
      setProgressVisual(0);
      progressContainer.setAttribute('aria-valuemin', '0');
      progressContainer.setAttribute('aria-valuemax', '100');
      progressContainer.setAttribute('aria-valuenow', '0');
      if (state.currentTrackIndex !== -1 && state.activeQueue[state.currentTrackIndex]) {
        state.activeQueue[state.currentTrackIndex].duration = deck.duration;
        updateAudioQuality(state.activeQueue[state.currentTrackIndex]);
      }
      updateWindowsMediaPlayback(!deck.paused);
      updateWindowsMediaPosition(true);
      notifyDiscordPresence(true);
    });

    deck.addEventListener('ended', () => {
      if (deck !== audio) return;
      if (state.currentTrackIndex !== -1 && state.activeQueue[state.currentTrackIndex]) {
        const currentTrack = state.activeQueue[state.currentTrackIndex];
        incrementPlayCount(currentTrack);
        renderGrids();
      }
      if (handleSleepTimerTrackEnd()) return;
      if (localStorage.getItem('pn_playback_continuous') !== 'false' || state.repeatMode !== 'off') {
        nextSong(true);
        return;
      }
      audio.pause();
      audio.currentTime = 0;
      playIcon.className = 'ph-fill ph-play';
      syncPlayingUI(false);
    });

    deck.addEventListener('play', () => {
      syncAudioContextPlaybackState();
      if (deck === audio) {
        notifyDiscordPresence(true);
        syncPlayingUI(true);
        updateWindowsMediaPlayback(true);
        updateTaskbarPlaybackProgress();
      }
    });
    deck.addEventListener('pause', () => {
      syncAudioContextPlaybackState();
      if (deck === audio) {
        notifyDiscordPresence(true);
        syncPlayingUI(false);
        updateWindowsMediaPlayback(false);
        updateTaskbarPlaybackProgress();
        persistPlaybackSession(false);
      }
    });
  });

  progressContainer.setAttribute('role', 'slider');
  progressContainer.setAttribute('tabindex', '0');
  progressContainer.setAttribute('aria-label', 'Posición de reproducción');
  progressContainer.setAttribute('aria-valuemin', '0');
  progressContainer.setAttribute('aria-valuemax', '100');
  progressContainer.setAttribute('aria-valuenow', '0');

  progressContainer.addEventListener('pointerdown', event => {
    const dur = getPlaybackDuration();
    if (event.button !== 0 || !Number.isFinite(dur) || dur <= 0) return;
    event.preventDefault();
    resumeAfterSeeking = !isPlaybackPaused();
    if (resumeAfterSeeking) {
      if (crossfadeInProgress) cancelCrossfade();
      if (nativeAudioActive) {
        void nativeInvoke('native_audio_pause').then(st => applyNativeStatusToUi(st)).catch(() => {});
      } else {
        audio.pause();
      }
      playIcon.className = "ph-fill ph-play";
      syncPlayingUI(false);
    }

    isSeeking = true;
    pendingSeekSeconds = null;
    activeSeekPointerId = event.pointerId;
    progressContainer.setPointerCapture(event.pointerId);
    progressContainer.classList.add('is-seeking');
    updateSeekPosition(event.clientX, { commit: false });
  });
  progressContainer.addEventListener('pointermove', event => {
    if (!isSeeking || event.pointerId !== activeSeekPointerId) return;
    updateSeekPosition(event.clientX);
  });

  const finishSeeking = event => {
    if (!isSeeking || event.pointerId !== activeSeekPointerId) return;
    updateSeekPosition(event.clientX, { commit: true });
    isSeeking = false;
    activeSeekPointerId = null;
    progressContainer.classList.remove('is-seeking');
    if (progressContainer.hasPointerCapture(event.pointerId)) {
      progressContainer.releasePointerCapture(event.pointerId);
    }
    const shouldResume = resumeAfterSeeking;
    resumeAfterSeeking = false;
    if (shouldResume) {
      if (nativeAudioActive) {
        void nativeInvoke('native_audio_play', { fadeInSecs: 0 })
          .then(st => {
            applyNativeStatusToUi(st);
            startNativeProgressPoll();
            playIcon.className = "ph-fill ph-pause";
            syncPlayingUI(true);
            updateWindowsMediaPlayback(true);
          })
          .catch(error => {
            console.error('No se pudo reanudar la reproducción después de buscar:', error);
            playIcon.className = "ph-fill ph-play";
            syncPlayingUI(false);
          });
      } else {
        audio.play().then(() => {
          playIcon.className = "ph-fill ph-pause";
          syncPlayingUI(true);
        }).catch(error => {
          console.error('No se pudo reanudar la reproducción después de buscar:', error);
          playIcon.className = "ph-fill ph-play";
          syncPlayingUI(false);
        });
      }
    }
    notifyDiscordPresence(true);
  };
  progressContainer.addEventListener('pointerup', finishSeeking);
  progressContainer.addEventListener('pointercancel', finishSeeking);

  progressContainer.addEventListener('keydown', event => {
    const dur = getPlaybackDuration();
    if (!Number.isFinite(dur) || dur <= 0) return;
    let time = getPlaybackPosition();
    if (event.key === 'ArrowRight') time += 5;
    else if (event.key === 'ArrowLeft') time -= 5;
    else if (event.key === 'Home') time = 0;
    else if (event.key === 'End') time = audio.duration;
    else return;
    event.preventDefault();
    if (nativeAudioActive) { void seekPlayback(time); }
    else audio.currentTime = Math.max(0, Math.min(audio.duration, time));
    updateSeekPosition(progressContainer.getBoundingClientRect().left +
      (audio.currentTime / audio.duration) * progressContainer.getBoundingClientRect().width);
    notifyDiscordPresence(true);
  });
}
