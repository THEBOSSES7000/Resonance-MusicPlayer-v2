function notifyDiscordPresence(force = false, clearTrack = false) {
  const track = clearTrack || state.currentTrackIndex < 0
    ? null
    : state.activeQueue[state.currentTrackIndex];
  document.dispatchEvent(new CustomEvent('pn-discord-presence-update', {
    detail: {
      title: track?.title || '',
      artist: track?.artist || '',
      album: track?.album || '',
      filePath: track?.file?.path || '',
      playing: Boolean(track && !audio.paused),
      positionSeconds: track ? getPlaybackPosition() : 0,
      durationSeconds: track && Number.isFinite(audio.duration) ? audio.duration : 0,
      force
    }
  }));
}

function applyPlaybackRate() {
  const effectiveRate = playbackRate * (2 ** (playbackPitch / 12));
  audioDecks.forEach(deck => {
    deck.playbackRate = effectiveRate;
  });
}

function setPlaybackSpeed(rate) {
  playbackRate = Math.min(2, Math.max(0.5, Number(rate) || 1));
  applyPlaybackRate();
  localStorage.setItem('pn_playback_rate', String(playbackRate));
  const slider = document.getElementById('playback-speed');
  const value = document.getElementById('playback-speed-value');
  if (slider) slider.value = String(playbackRate);
  if (value) value.value = `${playbackRate.toFixed(2)}x`;
}

function setPlaybackPitch(semitones) {
  playbackPitch = preservePitch ? 0 : Math.min(12, Math.max(-12, Number(semitones) || 0));
  applyPlaybackRate();
  localStorage.setItem('pn_playback_pitch', String(playbackPitch));
  const slider = document.getElementById('playback-pitch');
  const value = document.getElementById('playback-pitch-value');
  if (slider) slider.value = String(playbackPitch);
  if (value) value.value = `${playbackPitch > 0 ? '+' : ''}${playbackPitch} st`;
}

function setPreservePitch(enabled) {
  preservePitch = Boolean(enabled);
  if (preservePitch) setPlaybackPitch(0);
  audioDecks.forEach(deck => {
    deck.preservesPitch = preservePitch;
    deck.webkitPreservesPitch = preservePitch;
    deck.mozPreservesPitch = preservePitch;
  });
  const pitchSlider = document.getElementById('playback-pitch');
  if (pitchSlider) pitchSlider.disabled = preservePitch;
  localStorage.setItem('pn_playback_preserve_pitch', String(preservePitch));
  const checkbox = document.getElementById('playback-preserve-pitch');
  if (checkbox) checkbox.checked = preservePitch;
}

function updateSleepTimerStatus() {
  const status = document.getElementById('sleep-timer-status');
  if (!status) return;
  if (sleepTimerMode === 'time') {
    const secondsLeft = Math.max(0, Math.ceil((sleepTimerDeadline - Date.now()) / 1000));
    const hours = Math.floor(secondsLeft / 3600);
    const remaining = secondsLeft % 3600;
    const countdown = hours
      ? `${hours}:${String(Math.floor(remaining / 60)).padStart(2, '0')}:${String(remaining % 60).padStart(2, '0')}`
      : formatTime(secondsLeft);
    status.textContent = `Se pausará en ${countdown}.`;
  } else if (sleepTimerMode === 'tracks') {
    status.textContent = `Se pausará al terminar ${sleepTimerRemainingTracks} ${sleepTimerRemainingTracks === 1 ? 'pista' : 'pistas'}.`;
  } else if (sleepTimerMode === 'end') {
    status.textContent = 'Se pausará al terminar la lista actual.';
  } else {
    status.textContent = 'Temporizador desactivado';
  }
}

function cancelSleepTimer() {
  clearInterval(sleepTimerInterval);
  sleepTimerInterval = null;
  sleepTimerMode = null;
  sleepTimerRemainingTracks = 0;
  sleepTimerDeadline = 0;
  updateSleepTimerStatus();
  document.getElementById('btn-sleep-timer')?.classList.remove('active-toggle');
}

function pauseForSleepTimer() {
  cancelSleepTimer();
  audio.pause();
  playIcon.className = 'ph-fill ph-play';
  syncPlayingUI(false);
}

function handleSleepTimerTrackEnd() {
  if (sleepTimerMode === 'time') {
    if (Date.now() >= sleepTimerDeadline) {
      pauseForSleepTimer();
      return true;
    }
    return false;
  }
  if (sleepTimerMode === 'tracks') {
    sleepTimerRemainingTracks--;
    if (sleepTimerRemainingTracks <= 0) {
      pauseForSleepTimer();
      return true;
    }
    updateSleepTimerStatus();
  }
  if (sleepTimerMode === 'end' && state.currentTrackIndex >= state.activeQueue.length - 1) {
    pauseForSleepTimer();
    return true;
  }
  return false;
}

function updateCrossfadeIndicator() {
  const isVisible = crossfadeVisualActive && crossfadeIndicatorEnabled;
  playbackRow?.classList.toggle('crossfade-active', isVisible);
  crossfadeIndicator?.setAttribute('aria-hidden', String(!isVisible));
}

function setProgressVisual(ratio) {
  lastProgressRatio = Math.max(0, Math.min(1, ratio));
  progressFill.style.width = `${lastProgressRatio * 100}%`;
  if (progressWavePlayed) progressWavePlayed.style.width = `${progressContainer.clientWidth}px`;
  updateTaskbarPlaybackProgress();
}

function updateTaskbarPlaybackProgress() {
  const invoke = window.__TAURI__?.core?.invoke;
  if (!invoke) return;

  const trackIsLoaded = state.currentTrackIndex >= 0 &&
    Boolean(state.activeQueue[state.currentTrackIndex]) &&
    Boolean(audio.currentSrc || audio.src);
  const progress = trackIsLoaded && Number.isFinite(audio.duration) && audio.duration > 0
    ? Math.round(Math.max(0, Math.min(1, audio.currentTime / audio.duration)) * 100)
    : (trackIsLoaded ? 0 : null);

  queuedTaskbarProgress = {
    progress,
    paused: Boolean(trackIsLoaded && audio.paused)
  };
  updateWindowsMediaPosition();
  if (taskbarProgressInFlight) return;

  taskbarProgressInFlight = true;
  void (async () => {
    try {
      while (queuedTaskbarProgress) {
        const next = queuedTaskbarProgress;
        queuedTaskbarProgress = null;
        await invoke('set_taskbar_playback_progress', next);
      }
    } catch (error) {
      console.error('No se pudo actualizar el progreso de la barra de tareas:', error);
      queuedTaskbarProgress = null;
    } finally {
      taskbarProgressInFlight = false;
      if (queuedTaskbarProgress) updateTaskbarPlaybackProgress();
    }
  })();
}

function updateWindowsMediaPosition(force = false) {
  const invoke = window.__TAURI__?.core?.invoke;
  const track = state.currentTrackIndex < 0 ? null : state.activeQueue[state.currentTrackIndex];
  const duration = getPlaybackDuration();
  const position = getPlaybackPosition();
  if (!invoke || !track || !Number.isFinite(duration) || duration <= 0) return;
  const now = performance.now();
  if (!force && now - lastNativePositionUpdate < 1000) return;
  lastNativePositionUpdate = now;
  void invoke('seek_windows_media_position', {
    positionSeconds: position,
    durationSeconds: duration
  }).catch(() => {});
}


function updateWindowsMediaPlayback(playing) {
  const invoke = window.__TAURI__?.core?.invoke;
  if (!invoke) return;
  void invoke('update_windows_media_playback', {
    playing,
    positionSeconds: getPlaybackPosition(),
    durationSeconds: Number.isFinite(audio.duration) ? audio.duration : 0
  }).catch(error => {
    console.error('No se pudo actualizar el estado multimedia de Windows:', error);
  });
}

async function updateWindowsMediaMetadata(track) {
  const invoke = window.__TAURI__?.core?.invoke;
  if (!invoke) return;
  const generation = ++nativeArtworkGeneration;
  let artworkBase64 = null;
  if (resolveCoverUrl(track)) {
    try {
      const response = await fetch(resolveCoverUrl(track));
      if (!response.ok) throw new Error(`Respuesta HTTP ${response.status}`);
      const artwork = await response.arrayBuffer();
      if (artwork.byteLength > 8 * 1024 * 1024) {
        throw new Error('La portada supera el tamaño máximo permitido de 8 MiB.');
      }
      const reader = new FileReader();
      artworkBase64 = await new Promise((resolve, reject) => {
        reader.onloadend = () => {
          const base64 = typeof reader.result === 'string'
            ? reader.result.split(',')[1]
            : null;
          resolve(base64 || null);
        };
        reader.onerror = () => reject(reader.error || new Error('No se pudo leer la portada.'));
        reader.readAsDataURL(new Blob([artwork]));
      });
    } catch (error) {
      console.error('No se pudo preparar la portada para Windows:', error);
    }
  }
  if (generation !== nativeArtworkGeneration ||
      state.activeQueue[state.currentTrackIndex] !== track) return;
  void invoke('update_windows_media_metadata', {
    metadata: {
      title: track.title || 'Desconocido',
      artist: track.artist || 'Desconocido',
      album: track.album || '',
      artworkBase64
    }
  }).catch(error => {
    console.error('No se pudieron actualizar los metadatos multimedia de Windows:', error);
  });
}

function initWindowsMediaControlListener() {
  const listen = window.__TAURI__?.event?.listen;
  if (!listen) return;
  void listen('windows-media-control', event => {
    const { action, positionSeconds } = event.payload || {};
    if (action === 'play' && isPlaybackPaused()) togglePlay();
    else if (action === 'pause' && !isPlaybackPaused()) togglePlay();
    else if (action === 'next') void nextSong(false);
    else if (action === 'previous') prevSong();
    else if (action === 'seek' && Number.isFinite(positionSeconds)) {
      void seekPlayback(positionSeconds);
      updateWindowsMediaPosition(true);
      notifyDiscordPresence(true);
    }
  }).catch(error => {
    console.error('No se pudieron escuchar los controles multimedia de Windows:', error);
  });
}

export function resetProgressVisual() {
  setProgressVisual(0);
