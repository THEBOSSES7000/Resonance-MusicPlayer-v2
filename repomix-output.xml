    if (alternateText) btnConfirmAlternate.addEventListener('click', onAlternate);
  });
}

export function extractDominantColor(imgSrc) {
  return new Promise((resolve) => {
    if (!imgSrc) return resolve({ r: 61, g: 28, b: 104 });
    const img = new Image();
    img.crossOrigin = "Anonymous";
    img.onload = () => {
      try {
        const canvas = document.createElement("canvas");
        canvas.width = 16;
        canvas.height = 16;
        const ctx = canvas.getContext("2d");
        ctx.drawImage(img, 0, 0, 16, 16);
        const data = ctx.getImageData(0, 0, 16, 16).data;
        let r = 0, g = 0, b = 0, count = 0;
        for (let i = 0; i < data.length; i += 4) {
          if (data[i] + data[i + 1] + data[i + 2] > 70) {
            r += data[i];
            g += data[i + 1];
            b += data[i + 2];
            count++;
          }
        }
        if (count > 0) {
          resolve({
            r: Math.round(r / count),
            g: Math.round(g / count),
            b: Math.round(b / count)
          });
        } else {
          resolve({ r: 61, g: 28, b: 104 });
        }
      } catch (e) {
        resolve({ r: 61, g: 28, b: 104 });
      }
    };
    img.onerror = () => resolve({ r: 61, g: 28, b: 104 });
    img.src = imgSrc;
  });
}

export function parseM3UContent(text) {
  return parseM3UEntries(text).map(entry => {
    const ranked = rankM3UCandidates(entry);
    const best = ranked[0];
    return best && isConfidentM3UMatch(entry, ranked) ? best.song : null;
  }).filter(Boolean);
}

function normalizeM3UText(value) {
  return String(value || '')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLocaleLowerCase()
    .replace(/[^a-z0-9]+/g, ' ')
    .trim();
}

function pathBasename(path) {
  return String(path || '').replace(/\\/g, '/').split('/').pop() || '';
}

function parseM3UEntries(text) {
  const entries = [];
  let currentExtInf = null;
  String(text).replace(/^\uFEFF/, '').split(/\r?\n/).forEach(line => {
    const trimmed = line.trim();
    if (!trimmed) return;
    if (trimmed.startsWith('#EXTINF:')) {
      const comma = trimmed.indexOf(',');
      if (comma < 0) return;
      const duration = Number(trimmed.slice(8, comma));
      const displayName = trimmed.slice(comma + 1).trim();
      const artistTitle = displayName.match(/^(.+?)\s+(?:-|–|—)\s+(.+)$/);
      currentExtInf = {
        duration: Number.isFinite(duration) ? duration : 0,
        displayName,
        artist: artistTitle?.[1]?.trim() || '',
        title: artistTitle?.[2]?.trim() || displayName
      };
      return;
    }
    if (trimmed.startsWith('#')) return;
    const sourcePath = trimmed.replace(/^file:\/\//i, '').replace(/\//g, '\\');
    const filename = pathBasename(trimmed);
    const fallbackTitle = filename.replace(/\.[^.]+$/, '');
    entries.push({
      sourcePath,
      filename,
      duration: currentExtInf?.duration || 0,
      artist: currentExtInf?.artist || '',
      title: currentExtInf?.title || fallbackTitle,
      displayName: currentExtInf?.displayName || fallbackTitle
    });
    currentExtInf = null;
  });
  return entries;
}

function rankM3UCandidates(entry) {
  const filename = normalizeM3UText(pathBasename(entry.filename));
  const title = normalizeM3UText(entry.title);
  const artist = normalizeM3UText(entry.artist);
  return state.localMusicFiles.map(song => {
    const songFilename = normalizeM3UText(song.file?.name || song.file?.path);
    const songTitle = normalizeM3UText(song.title);
    const songArtist = normalizeM3UText(song.artist);
    let score = 0;
    if (filename && filename === songFilename) score += 100;
    if (title && title === songTitle) score += 75;
    else if (title && songTitle && (title.includes(songTitle) || songTitle.includes(title))) score += 45;
    if (artist && artist === songArtist) score += 35;
    else if (artist && songArtist && (artist.includes(songArtist) || songArtist.includes(artist))) score += 18;
    if (entry.duration > 0 && song.duration > 0) {
      const difference = Math.abs(entry.duration - song.duration);
      if (difference <= 2) score += 8;
      else if (difference <= 5) score += 4;
    }
    return { song, score, filenameMatch: Boolean(filename && filename === songFilename) };
  }).filter(candidate => candidate.score > 0)
    .sort((left, right) => right.score - left.score);
}

function isConfidentM3UMatch(entry, ranked) {
  const [best, second] = ranked;
  if (!best) return false;
  const titleMatches = normalizeM3UText(entry.title) === normalizeM3UText(best.song.title);
  const artistMatches = Boolean(entry.artist) &&
    normalizeM3UText(entry.artist) === normalizeM3UText(best.song.artist);
  if (best.filenameMatch && (titleMatches || artistMatches || !entry.title) &&
      (!second || best.score - second.score >= 20)) return true;
  return titleMatches && artistMatches && (!second || best.score - second.score >= 20);
}

function rankM3UMetadataCandidates(entry) {
  const title = normalizeM3UText(entry.title);
  const artist = normalizeM3UText(entry.artist);
  if (!title && !artist) return [];
  return state.localMusicFiles.map(song => {
    const songTitle = normalizeM3UText(song.title);
    const songArtist = normalizeM3UText(song.artist);
    let score = 0;
    if (title && title === songTitle) score += 100;
    else if (title && songTitle && (title.includes(songTitle) || songTitle.includes(title))) score += 45;
    if (artist && artist === songArtist) score += 60;
    else if (artist && songArtist && (artist.includes(songArtist) || songArtist.includes(artist))) score += 25;
    if (entry.duration > 0 && song.duration > 0) {
      const difference = Math.abs(entry.duration - song.duration);
      if (difference <= 2) score += 20;
      else if (difference <= 5) score += 10;
    }
    return { song, score };
  }).filter(candidate => candidate.score > 0)
    .sort((left, right) => right.score - left.score);
}

function isConfidentMetadataMatch(entry, ranked) {
  const [best, second] = ranked;
  if (!best || best.score < 100) return false;
  const titleMatches = normalizeM3UText(entry.title) === normalizeM3UText(best.song.title);
  const artistMatches = Boolean(entry.artist) &&
    normalizeM3UText(entry.artist) === normalizeM3UText(best.song.artist);
  if (!titleMatches || (entry.artist && !artistMatches)) return false;
  if (!second || best.score - second.score >= 20) return true;
  return !entry.artist && entry.duration > 0 &&
    Math.abs(entry.duration - best.song.duration) <= 2 &&
    Math.abs(entry.duration - second.song.duration) > 2;
}

function createUnresolvedM3USong(entry) {
  return {
    id: `m3u-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`,
    title: entry.title || entry.displayName || pathBasename(entry.filename),
    artist: entry.artist || 'Desconocido',
    album: '',
    duration: entry.duration || 0,
    file: {
      name: pathBasename(entry.filename),
      path: entry.sourcePath || '',
      isUnresolvedM3U: true
    },
    isUnresolvedM3U: true
  };
}

function isLinkedToLocalLibrary(song) {
  if (!song || song.isUnresolvedM3U) return false;
  return state.localMusicFiles.some(localSong => {
    if (song.id !== undefined && song.id !== null && localSong.id === song.id) return true;
    const songPath = String(song.file?.path || song.file?.webkitRelativePath || '')
      .replace(/\//g, '\\').toLocaleLowerCase();
    const localPath = String(localSong.file?.path || localSong.file?.webkitRelativePath || '')
      .replace(/\//g, '\\').toLocaleLowerCase();
    return Boolean(songPath && songPath === localPath);
  });
}

function rankSongCandidates(song) {
  return rankM3UCandidates({
    filename: song?.file?.name || pathBasename(song?.file?.path),
    title: song?.title || '',
    artist: song?.artist === 'Desconocido' ? '' : song?.artist || '',
    duration: song?.duration || 0
  });
}

function openMissingSongsResolver(sourceSongs, onApply, showCompleteMessage = true) {
  const workingSongs = [...sourceSongs];
  const reviewItems = [];
  let automaticallyLocated = 0;

  workingSongs.forEach((song, index) => {
    if (!song?.isUnresolvedM3U && isLinkedToLocalLibrary(song)) return;
    const ranked = rankSongCandidates(song);
    const entry = {
      filename: song?.file?.name || pathBasename(song?.file?.path),
      title: song?.title || '',
      artist: song?.artist === 'Desconocido' ? '' : song?.artist || '',
      duration: song?.duration || 0
    };
    const best = ranked[0];
    if (best && isConfidentM3UMatch(entry, ranked)) {
      workingSongs[index] = best.song;
      automaticallyLocated++;
    } else {
      reviewItems.push({ index, song, ranked });
    }
  });

  if (!reviewItems.length) {
    onApply(workingSongs);
    if (showCompleteMessage) {
      void showConfirmDialog({
        title: 'Búsqueda completada',
        message: automaticallyLocated
          ? `Se ubicaron automáticamente ${automaticallyLocated} canciones.`
          : 'No se encontraron canciones sin ubicar en esta playlist.',
        confirmText: 'Aceptar',
        showCancel: false
      });
    }
    return;
  }

  const modal = document.getElementById('missing-songs-modal');
  const list = document.getElementById('missing-songs-list');
  const description = document.getElementById('missing-songs-description');
  const applyButton = document.getElementById('missing-songs-apply');
  const cancelButton = document.getElementById('missing-songs-cancel');
  const closeButton = document.getElementById('missing-songs-close');
  const autoFindButton = document.getElementById('missing-songs-auto-find');
  const autoFindStatus = document.getElementById('missing-songs-auto-status');
  if (!modal || !list || !description || !applyButton || !cancelButton || !closeButton ||
      !autoFindButton || !autoFindStatus) return;

  description.textContent = `${reviewItems.length} canción(es) necesitan confirmación. A la izquierda aparece la referencia de la playlist y a la derecha las coincidencias encontradas en tus directorios.`;
  list.replaceChildren();
  autoFindStatus.textContent = '';
  const decisions = new Map();
  const rowByIndex = new Map();

  reviewItems.forEach(({ index, song, ranked }) => {
    const row = document.createElement('article');
    row.className = 'missing-song-row';
    row.dataset.index = String(index);

    const missingSide = document.createElement('div');
    missingSide.className = 'missing-song-side';
    const missingTitle = document.createElement('strong');
    missingTitle.textContent = song?.title || song?.file?.name || 'Canción desconocida';
    const missingDetails = document.createElement('span');
    missingDetails.textContent = [song?.artist, song?.file?.path].filter(Boolean).join(' · ') || 'Referencia sin ubicación local';
    missingSide.append(missingTitle, missingDetails);

    const candidateSide = document.createElement('div');
    candidateSide.className = 'missing-song-candidate';
    if (ranked.length) {
      const select = document.createElement('select');
      select.setAttribute('aria-label', `Posibles coincidencias para ${missingTitle.textContent}`);
      ranked.slice(0, 8).forEach(({ song: candidate, score }, candidateIndex) => {
        const option = document.createElement('option');
        option.value = String(candidateIndex);
        option.textContent = `${candidate.title || candidate.file?.name} — ${candidate.artist || 'Desconocido'}${candidate.album ? ` · ${candidate.album}` : ''}`;
        option.dataset.score = String(score);
        select.appendChild(option);
      });
      const candidateDetails = document.createElement('span');
      candidateDetails.className = 'missing-song-empty';
      candidateDetails.textContent = 'Canción candidata en los directorios configurados';
      candidateSide.append(select, candidateDetails);
    } else {
      const noCandidate = document.createElement('span');
      noCandidate.className = 'missing-song-placeholder';
      noCandidate.textContent = 'No se encontró una coincidencia probable';
      candidateSide.appendChild(noCandidate);
    }

    const actions = document.createElement('div');
    actions.className = 'missing-song-row-actions';
    const useSuggestionButton = document.createElement('button');
    useSuggestionButton.type = 'button';
    useSuggestionButton.className = 'btn-pill-save';
    useSuggestionButton.textContent = 'Usar coincidencia';
    useSuggestionButton.disabled = !ranked.length;
    useSuggestionButton.addEventListener('click', () => {
      const select = candidateSide.querySelector('select');
      if (!select) return;
      setSongDecision(index, ranked[Number(select.value)].song);
    });
    const replaceButton = document.createElement('button');
    replaceButton.type = 'button';
    replaceButton.className = 'btn-pill-save secondary';
    replaceButton.textContent = 'Reemplazar archivo';
    replaceButton.addEventListener('click', async () => {
      replaceButton.disabled = true;
      autoFindStatus.textContent = '';
      try {
        const selectedSong = await selectSongFromConfiguredLibrary();
        if (selectedSong) setSongDecision(index, selectedSong);
      } catch (error) {
        console.error('No se pudo reemplazar la canción seleccionada:', error);
        autoFindStatus.textContent = error.message || 'No se pudo seleccionar el archivo.';
      } finally {
        replaceButton.disabled = false;
      }
    });
    const leaveButton = document.createElement('button');
    leaveButton.type = 'button';
    leaveButton.className = 'btn-pill-save secondary';
    leaveButton.textContent = 'Dejar vacío';
    leaveButton.addEventListener('click', () => {
      const unresolvedSong = {
        ...song,
        audioUrl: '',
        file: { ...(song?.file || {}), name: song?.file?.name || '', path: '', isUnresolvedM3U: true },
        isUnresolvedM3U: true
      };
      if (decisions.get(index)?.isUnresolvedM3U) decisions.delete(index);
      else decisions.set(index, unresolvedSong);
      updateRowDecision(index);
    });
    actions.append(useSuggestionButton, replaceButton, leaveButton);
    candidateSide.appendChild(actions);
    row.append(missingSide, candidateSide);
    list.appendChild(row);
    rowByIndex.set(index, row);
  });

  function updateRowDecision(index) {
    rowByIndex.get(index)?.classList.toggle('is-decided', decisions.has(index));
    updateApplyButton();
  }
  function setSongDecision(index, selectedSong) {
    decisions.set(index, selectedSong);
    updateRowDecision(index);
  }
  const updateApplyButton = () => {
    applyButton.disabled = decisions.size !== reviewItems.length;
  };
  const autoFindSongs = () => {
    let matched = 0;
    reviewItems.forEach(({ index, song }) => {
      const entry = {
        title: song?.title || '',
        artist: song?.artist === 'Desconocido' ? '' : song?.artist || '',
        duration: song?.duration || 0
      };
      const ranked = rankM3UMetadataCandidates(entry);
      const best = ranked[0];
      if (best && isConfidentMetadataMatch(entry, ranked)) {
        decisions.set(index, best.song);
        matched++;
        updateRowDecision(index);
      }
    });
    autoFindStatus.textContent = matched
      ? `Se encontraron automáticamente ${matched} coincidencia(s) seguras. Revisa las demás canciones.`
      : 'No se encontraron coincidencias de metadatos suficientemente seguras.';
  };
  const cleanup = () => {
    modal.classList.remove('open');
    applyButton.removeEventListener('click', applyDecisions);
    autoFindButton.removeEventListener('click', autoFindSongs);
    cancelButton.removeEventListener('click', close);
    closeButton.removeEventListener('click', close);
    modal.removeEventListener('click', onBackdropClick);
    document.removeEventListener('keydown', onKeyDown);
  };
  const close = () => cleanup();
  const applyDecisions = () => {
    if (decisions.size !== reviewItems.length) return;
    decisions.forEach((song, index) => { workingSongs[index] = song; });
    cleanup();
    onApply(workingSongs);
  };
  const onBackdropClick = event => {
    if (event.target === modal) close();
  };
  const onKeyDown = event => {
    if (event.key === 'Escape') close();
  };
  applyButton.addEventListener('click', applyDecisions);
  autoFindButton.addEventListener('click', autoFindSongs);
  cancelButton.addEventListener('click', close);
  closeButton.addEventListener('click', close);
  modal.addEventListener('click', onBackdropClick);
  document.addEventListener('keydown', onKeyDown);
  updateApplyButton();
  modal.classList.add('open');
}

async function selectSongFromConfiguredLibrary() {
  const invoke = window.__TAURI__?.core?.invoke;
  if (typeof invoke !== 'function') {
    throw new Error('La selección manual de archivos está disponible desde la aplicación Resonance.');
  }
  const selectedPath = await invoke('select_music_file');
  if (!selectedPath) return null;
  const normalizePath = path => String(path || '').replace(/\//g, '\\').toLocaleLowerCase();
  let selectedSong = state.localMusicFiles.find(song =>
    normalizePath(song.file?.path) === normalizePath(selectedPath)
  );
  if (!selectedSong) {
    await rescanConfiguredMusic();
    selectedSong = state.localMusicFiles.find(song =>
      normalizePath(song.file?.path) === normalizePath(selectedPath)
    );
  }
  if (!selectedSong) {
    throw new Error('El archivo elegido no aparece en la biblioteca. Actualiza el escaneo de las carpetas configuradas e inténtalo de nuevo.');
  }
  return selectedSong;
}

export function playFromContext(list, trackIndex, contextTitle = "Cola de reproducción", autoPlay = true, contextId = null, randomizeStart = false, preserveQueueOrder = false) {
  const sourceQueue = [...list];
  state.activeQueue = sourceQueue;
  state.activeQueueTitle = contextTitle;
  state.activeContextId = contextId || contextTitle;
  if (playerSourceLabel) {
    const sourceText = playerSourceLabel.querySelector('.player-source-text');
    if (sourceText) sourceText.textContent = contextTitle;
    playerSourceLabel.title = contextTitle;
    playerSourceLabel.setAttribute('aria-label', `Origen de reproducción: ${contextTitle}`);
  }
  state.queueVisibleCount = 25;
  state.playbackHistory = [];

  if (trackIndex > 0) {
    for (let i = 0; i < trackIndex; i++) {
      state.playbackHistory.unshift(state.activeQueue[i]);
    }
  }

  if (state.isShuffle && sourceQueue.length > 1 && !preserveQueueOrder) {
    if (randomizeStart) {
      state.activeQueue = shuffleArray(sourceQueue);
      trackIndex = 0;
    } else if (trackIndex >= 0 && trackIndex < sourceQueue.length) {
      const selectedTrack = sourceQueue[trackIndex];
      const upcomingTracks = sourceQueue.filter((_, index) => index !== trackIndex);
      state.activeQueue = [selectedTrack, ...shuffleArray(upcomingTracks)];
      trackIndex = 0;
    }
  }

  renderHistoryUI();

  if (queueHeaderTitle) {
    queueHeaderTitle.textContent = `Cola (${contextTitle})`;
  }
  loadSong(trackIndex, autoPlay, false);
}

function updateSongCardsDOM(song) {
  document.querySelectorAll(`.song-card[data-id="${song.id}"]`).forEach(card => {
    const imgWrap = card.querySelector('.card-img-wrap');
    if (imgWrap && resolveCoverUrl(song)) {
      const icon = imgWrap.querySelector('.cover-placeholder-icon');
      if (icon) icon.remove();
      let img = imgWrap.querySelector('.song-cover-img');
      if (!img) {
        img = document.createElement('img');
        img.className = 'song-cover-img';
        imgWrap.prepend(img);
      }
      img.src = resolveCoverUrl(song);
      img.alt = song.title;
    }
    const h4 = card.querySelector('h4');
    const p = card.querySelector('p');
    if (h4) h4.textContent = song.title;
    if (p) p.textContent = song.artist || "Desconocido";
  });
}

export async function ensureSongMetadata(song) {
  if (song.metadataLoaded) return;
  if (
    song.file?.isNativeFile &&
    song.title &&
    song.artist
  ) {
    song.metadataLoaded = true;
    return;
  }
  if (!song.metadataPromise) {
    song.metadataPromise = (async () => {
      try {
        const meta = await extractMetadata(song.file);
        if (meta.title) song.title = meta.title;
        if (meta.artist) song.artist = meta.artist;
        if (meta.album) song.album = meta.album;
        if (meta.coverUrl) song.coverUrl = meta.coverUrl;
        if (meta.lyrics) song.lyrics = meta.lyrics;
        if (meta.sampleRate) song.sampleRate = meta.sampleRate;
        if (meta.channels) song.channels = meta.channels;
        if (meta.bitDepth) song.bitDepth = meta.bitDepth;
        if (meta.codec) song.codec = meta.codec;
      } catch (err) {
        console.warn("Error leyendo metadatos:", err);
      } finally {
        song.metadataLoaded = true;
        updateSongCardsDOM(song);
        if (state.currentView === 'favorites' || state.currentView === 'playlist' || state.currentView === 'all-music' || state.currentView === 'folder-detail') {
          renderPlaylistDetailView();
        } else if (state.currentView === 'artist') {
          renderPlaylistDetailView();
        } else if (state.currentView === 'search') {
          renderSearchResultsContent();
        }
      }
    })();
  }
  await song.metadataPromise;
}

function updatePlaylistRowTitleMarquee(row, shouldScroll) {
  row.classList.toggle('is-track-playing', shouldScroll);
  const title = row.querySelector('.row-text-meta strong');
  if (!title) return;

  title.classList.remove('is-scrolling');
  title.style.removeProperty('--row-title-scroll-distance');
  title.style.removeProperty('--row-title-scroll-duration');
  if (!shouldScroll) return;

  requestAnimationFrame(() => {
    if (!row.isConnected || !row.classList.contains('is-track-playing')) return;
    const overflow = title.scrollWidth - title.clientWidth;
    if (overflow <= 8) return;
    title.style.setProperty('--row-title-scroll-distance', `${overflow + 12}px`);
    title.style.setProperty('--row-title-scroll-duration', `${Math.max(6, Math.min(16, 5 + overflow / 16))}s`);
    title.classList.add('is-scrolling');
  });
}

/**
 * Sincroniza el estado visual completo de sonido en tiempo real
 */
export function syncPlayingUI(isPlaying) {
  const playPauseButton = document.getElementById('play-pause-btn');
  const playPauseIcon = document.getElementById('play-icon');
  if (playPauseIcon) {
    playPauseIcon.className = isPlaying ? 'ph-fill ph-pause' : 'ph-fill ph-play';
  }
  if (playPauseButton) {
    playPauseButton.title = isPlaying ? 'Pausar' : 'Reproducir';
    playPauseButton.setAttribute('aria-label', playPauseButton.title);
  }

  const currentSong = state.currentTrackIndex !== -1 ? state.activeQueue[state.currentTrackIndex] : null;
  syncPlayerAlbumLinkState();
  const collectionContextId = state.currentView === 'playlist'
    ? `playlist_${state.currentPlaylistId}`
    : state.currentView === 'folder-detail'
      ? `folder_${state.currentFolderId}`
      : state.currentView === 'all-music'
        ? 'all_music'
        : state.currentView === 'favorites'
          ? 'favorites'
          : state.currentView === 'artist'
            ? artistContextId(state.artistName)
            : state.currentView === 'album-detail'
              ? albumContextId(state.albumArtistName, state.albumTitle)
              : null;
  const collectionPlayIcon = btnPlayAllFavorites?.querySelector('i');
  if (collectionPlayIcon) {
    const isCurrentCollectionPlaying = Boolean(currentSong) &&
      state.activeContextId === collectionContextId &&
      isPlaying;
    collectionPlayIcon.className = isCurrentCollectionPlaying ? 'ph-fill ph-pause' : 'ph-fill ph-play';
    btnPlayAllFavorites.title = isCurrentCollectionPlaying ? 'Pausar' : 'Reproducir todo';
    btnPlayAllFavorites.setAttribute('aria-label', btnPlayAllFavorites.title);
  }

  // 1. Tarjetas del menú principal
  document.querySelectorAll('.song-card').forEach(card => {
    const songId = Number(card.dataset.id);
    const cardContext = card.dataset.context;
    const playBtnIcon = card.querySelector('.card-play-hover i');
    let soundwaveBadge = card.querySelector('.card-soundwave-badge');

    if (currentSong && currentSong.id === songId) {
      const isExactOrigin = cardContext === state.activeContextId;

      if (isExactOrigin) {
        card.classList.add('is-active');
        card.classList.remove('is-playing-elsewhere');
        if (playBtnIcon) {
          playBtnIcon.className = isPlaying ? "ph-fill ph-pause" : "ph-fill ph-play";
        }
        if (!soundwaveBadge) {
          soundwaveBadge = document.createElement('div');
          soundwaveBadge.className = 'card-soundwave-badge';
          card.querySelector('.card-img-wrap').appendChild(soundwaveBadge);
        }
        soundwaveBadge.innerHTML = getSoundWaveHTML(!isPlaying);
        soundwaveBadge.style.display = 'flex';
      } else {
        card.classList.remove('is-active');
        card.classList.add('is-playing-elsewhere');
        if (playBtnIcon) {
          playBtnIcon.className = "ph-fill ph-play";
        }
        if (soundwaveBadge) {
          soundwaveBadge.style.display = 'none';
        }
      }
    } else {
      card.classList.remove('is-active', 'is-playing-elsewhere');
      if (playBtnIcon) {
        playBtnIcon.className = "ph-fill ph-play";
      }
      if (soundwaveBadge) {
        soundwaveBadge.style.display = 'none';
      }
    }
  });
  syncLibraryAlbumIndicators(currentSong, isPlaying);

  // 2. Filas de tabla de detalle y búsqueda
  let activeViewContext = 'none';
  if (state.currentView === 'favorites') activeViewContext = 'favorites';
  else if (state.currentView === 'all-music') activeViewContext = 'all_music';
  else if (state.currentView === 'playlist') activeViewContext = 'playlist_' + state.currentPlaylistId;
  else if (state.currentView === 'folder-detail') activeViewContext = 'folder_' + state.currentFolderId;
  else if (state.currentView === 'artist') activeViewContext = artistContextId(state.artistName);
  else if (state.currentView === 'album-detail') activeViewContext = albumContextId(state.albumArtistName, state.albumTitle);
  else if (state.currentView === 'search') activeViewContext = 'search_songs';

  const isTableSourceActive = activeViewContext === state.activeContextId;

  document.querySelectorAll('.playlist-table-row').forEach(row => {
    const songId = Number(row.dataset.songId);
    const indexCell = row.querySelector('.row-index');
    const trackIdx = Number(row.dataset.trackIdx);

    if (currentSong && currentSong.id === songId) {
      if (isTableSourceActive) {
        row.classList.add('is-active');
        row.classList.remove('is-playing-elsewhere');
        if (indexCell) {
          indexCell.innerHTML = getSoundWaveHTML(!isPlaying);
        }
      } else {
        row.classList.remove('is-active');
        row.classList.add('is-playing-elsewhere');
        if (indexCell) {
          indexCell.textContent = trackIdx + 1;
        }
      }
    } else {
      row.classList.remove('is-active', 'is-playing-elsewhere');
      if (indexCell) {
        indexCell.textContent = trackIdx + 1;
      }
    }
    updatePlaylistRowTitleMarquee(row, Boolean(currentSong && currentSong.id === songId && isPlaying));
  });

  // 3. Soundwave en tarjeta "Sonando ahora"
  const nowPlayingWaveWrap = document.querySelector('.now-playing-wave-wrap');
  if (nowPlayingWaveWrap) {
    nowPlayingWaveWrap.innerHTML = getSoundWaveHTML(audio.paused);
  }

  // 4. Barra lateral izquierda:
  // 4.1 Inicio
  const isHomePlaying = state.activeContextId === 'recent' || state.activeContextId === 'mostPlayed';
  if (navBtnHome) {
    navBtnHome.classList.toggle('is-playing-origin', isHomePlaying);
    if (homeSidebarSoundwave) {
      homeSidebarSoundwave.innerHTML = isHomePlaying ? getSoundWaveHTML(!isPlaying) : '';
    }
  }

  // 4.2 Música
  const isMusicPlaying = state.activeContextId === 'all_music';
  if (navBtnMusic) {
    navBtnMusic.classList.toggle('is-playing-origin', isMusicPlaying);
    if (musicSidebarSoundwave) {
      musicSidebarSoundwave.innerHTML = isMusicPlaying ? getSoundWaveHTML(!isPlaying) : '';
    }
  }

  // 4.3 Carpetas
  const isFoldersPlaying = typeof state.activeContextId === 'string' && state.activeContextId.startsWith('folder_');
  if (navBtnFolders) {
    navBtnFolders.classList.toggle('is-playing-origin', isFoldersPlaying);
    if (foldersSidebarSoundwave) {
      foldersSidebarSoundwave.innerHTML = isFoldersPlaying ? getSoundWaveHTML(!isPlaying) : '';
    }
  }

  // 4.4 Listas de reproducción:
  let isPlaylistPlaying = typeof state.activeContextId === 'string' && state.activeContextId.startsWith('playlist_');
  let isPinnedPlaylist = false;
  if (isPlaylistPlaying) {
    const plId = Number(state.activeContextId.replace('playlist_', ''));
    const pl = state.playlists.find(p => p.id === plId);
    if (pl && pl.isPinned !== false) {
      isPinnedPlaylist = true;
    }
  }

  const shouldShowOnGeneralPlaylistsNav = isPlaylistPlaying && !isPinnedPlaylist;
  if (navBtnPlaylists) {
    navBtnPlaylists.classList.toggle('is-playing-origin', shouldShowOnGeneralPlaylistsNav);
    if (playlistsSidebarSoundwave) {
      playlistsSidebarSoundwave.innerHTML = shouldShowOnGeneralPlaylistsNav ? getSoundWaveHTML(!isPlaying) : '';
    }
  }

  // 4.5 Tus me gusta
  const isFavPlaying = state.activeContextId === 'favorites';
  if (btnOpenFavorites) {
    btnOpenFavorites.classList.toggle('is-playing-origin', isFavPlaying);
    if (favSidebarSoundwave) {
      favSidebarSoundwave.innerHTML = isFavPlaying ? getSoundWaveHTML(!isPlaying) : '';
    }
  }

  // 4.6 Acceso directo de playlists fijadas
  document.querySelectorAll('.playlist-card-left').forEach(card => {
    if (card.classList.contains('quick-access-item')) {
      const originId = card.dataset.quickType === 'song'
        ? `quick_song_${state.localMusicFiles.find(song =>
          sameQuickSongReference(JSON.parse(card.dataset.quickKey), song)
        )?.id}`
        : `folder_${card.dataset.folderId}`;
      const isQuickItemPlaying = Boolean(state.activeContextId) &&
        state.activeContextId === originId;
      card.classList.toggle('is-playing-origin', isQuickItemPlaying);
      const waveWrap = card.querySelector('.sidebar-soundwave-wrap');
      if (waveWrap) waveWrap.innerHTML = isQuickItemPlaying ? getSoundWaveHTML(!isPlaying) : '';
      return;
    }
    const plId = Number(card.dataset.id);
    const isThisPlaylist = state.activeContextId === ('playlist_' + plId);
    card.classList.toggle('is-playing-origin', isThisPlaylist);
    const waveWrap = card.querySelector('.sidebar-soundwave-wrap');
    if (waveWrap) {
      waveWrap.innerHTML = isThisPlaylist ? getSoundWaveHTML(!isPlaying) : '';
    }
  });

  // 5. Cuadrícula de Carpetas
  document.querySelectorAll('.folder-card').forEach(fCard => {
    const fId = Number(fCard.dataset.id);
    const isThisFolder = state.activeContextId === ('folder_' + fId);
    fCard.classList.toggle('is-playing-origin', isThisFolder);
    const playIcon = fCard.querySelector('.card-play-hover i');
    if (playIcon) {
      const isPlayingThisFolder = isThisFolder && Boolean(currentSong) && isPlaying;
      playIcon.className = isPlayingThisFolder ? 'ph-fill ph-pause' : 'ph-fill ph-play';
      const playButton = playIcon.closest('.card-play-hover');
      if (playButton) {
        playButton.title = isPlayingThisFolder ? 'Pausar carpeta' : 'Reproducir carpeta';
        playButton.setAttribute('aria-label', playButton.title);
      }
    }
    const waveWrap = fCard.querySelector('.folder-soundwave-wrap');
    if (waveWrap) {
      waveWrap.innerHTML = isThisFolder ? getSoundWaveHTML(!isPlaying) : '';
    }
  });

  // 6. Cuadrícula del Hub de Playlists
  document.querySelectorAll('.playlist-grid-card').forEach(pCard => {
    const plId = Number(pCard.dataset.id);
    const isThisPlaylist = state.activeContextId === ('playlist_' + plId);
    pCard.classList.toggle('is-playing-origin', isThisPlaylist);
    const playIcon = pCard.querySelector('.card-play-hover i');
    if (playIcon) {
      const isPlayingThisPlaylist = isThisPlaylist && Boolean(currentSong) && isPlaying;
      playIcon.className = isPlayingThisPlaylist ? 'ph-fill ph-pause' : 'ph-fill ph-play';
      const playButton = playIcon.closest('.card-play-hover');
      if (playButton) {
        playButton.title = isPlayingThisPlaylist ? 'Pausar playlist' : 'Reproducir playlist';
        playButton.setAttribute('aria-label', playButton.title);
      }
    }
    const waveWrap = pCard.querySelector('.playlist-hub-soundwave-wrap');
    if (waveWrap) {
      waveWrap.innerHTML = isThisPlaylist ? getSoundWaveHTML(!isPlaying) : '';
    }
  });
}

function createSongCard(song, onPlayCallback, contextType = "") {
  const card = document.createElement('div');
  card.className = 'song-card';
  card.dataset.id = song.id;
  card.dataset.context = contextType;

  const coverHtml = resolveCoverUrl(song) 
    ? `<img src="${resolveCoverUrl(song)}" alt="${song.title}" class="song-cover-img" />`
    : `<i class="ph ph-waveform cover-placeholder-icon"></i>`;

  const isCurrent = state.currentTrackIndex !== -1 && state.activeQueue[state.currentTrackIndex]?.id === song.id;
  const isExactOrigin = isCurrent && contextType === state.activeContextId;
  const isPlaying = isExactOrigin && !audio.paused;

  if (isExactOrigin) {
    card.classList.add('is-active');
  } else if (isCurrent) {
    card.classList.add('is-playing-elsewhere');
  }

  const soundwaveBadgeHtml = isExactOrigin 
    ? `<div class="card-soundwave-badge">${getSoundWaveHTML(!isPlaying)}</div>` 
    : ``;
  const favoriteBadgeHtml = song.isFavorite
    ? '<span class="card-favorite-badge" title="En favoritos" aria-label="En favoritos"><i class="ph-fill ph-heart" aria-hidden="true"></i></span>'
    : '';

  card.innerHTML = `
    <div class="card-img-wrap${song.isFavorite ? ' has-favorite' : ''}">
      ${soundwaveBadgeHtml}
      ${coverHtml}
      ${favoriteBadgeHtml}
      <button class="card-play-hover" title="Reproducir / Pausar">
        <i class="${isPlaying ? 'ph-fill ph-pause' : 'ph-fill ph-play'}"></i>
      </button>
    </div>
    <h4>${song.title}</h4>
    <p>${song.artist}</p>
  `;

  const playHoverBtn = card.querySelector('.card-play-hover');
  playHoverBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    playSongCard(song, contextType, onPlayCallback);
  });

  card.addEventListener('click', (e) => {
    if (handleSongSelectionClick(card, e)) return;
    playSongCard(song, contextType, onPlayCallback);
  });

  updateQueuePositionIndicator(card, song);

  if (!song.metadataLoaded) {
    ensureSongMetadata(song);
  }

  return card;
}

function playSongCard(song, contextType, onPlayCallback) {
  const currentSong = state.currentTrackIndex !== -1 ? state.activeQueue[state.currentTrackIndex] : null;
  if (currentSong?.id === song.id && state.activeContextId === contextType) {
    togglePlay();
    return;
  }
  onPlayCallback();
}

function playSongFromContext(songs, index, title, contextId) {
  const selectedSong = songs[index];
  const currentSong = state.currentTrackIndex !== -1 ? state.activeQueue[state.currentTrackIndex] : null;
  if (selectedSong && currentSong?.id === selectedSong.id && state.activeContextId === contextId) {
    togglePlay();
    return;
  }
  playFromContext(songs, index, title, true, contextId);
}

function clearSongSelection() {
  document.querySelectorAll('.song-card.is-multi-selected, .playlist-table-row.is-multi-selected')
    .forEach(element => element.classList.remove('is-multi-selected'));
  songSelectionAnchor = null;
}

function handleSongSelectionClick(element, event) {
  const isMultiSelect = event.ctrlKey || event.metaKey || event.shiftKey;
  if (!isMultiSelect) {
    clearSongSelection();
    return false;
  }

  event.preventDefault();
  const container = element.closest('.playlist-table-body, .grid-cards');
  const siblings = container
    ? [...container.querySelectorAll('.song-card, .playlist-table-row')]
    : [element];

  if (event.shiftKey && songSelectionAnchor?.isConnected && songSelectionAnchor.parentElement === container) {
    const anchorIndex = siblings.indexOf(songSelectionAnchor);
    const targetIndex = siblings.indexOf(element);
    if (!event.ctrlKey && !event.metaKey) clearSongSelection();
    if (anchorIndex !== -1 && targetIndex !== -1) {
      siblings.slice(Math.min(anchorIndex, targetIndex), Math.max(anchorIndex, targetIndex) + 1)
        .forEach(item => item.classList.add('is-multi-selected'));
    } else {
      element.classList.add('is-multi-selected');
    }
  } else if (event.ctrlKey || event.metaKey) {
    element.classList.toggle('is-multi-selected');
  } else {
    clearSongSelection();
    element.classList.add('is-multi-selected');
  }

  songSelectionAnchor = element;
  return true;
}

function getSongForSelectableElement(element) {
  const songId = Number(element.dataset.id || element.dataset.songId);
  return state.localMusicFiles.find(song => song.id === songId)
    || state.playlists.flatMap(playlist => playlist.songs || []).find(song => song.id === songId)
    || state.activeQueue.find(song => song.id === songId)
    || null;
}

function getSelectedSongs(clickedElement, clickedSong) {
  if (!clickedElement.classList.contains('is-multi-selected')) return [clickedSong];
  const selectedElements = [...document.querySelectorAll(
    '.song-card.is-multi-selected, .playlist-table-row.is-multi-selected'
  )];
  return selectedElements.map(getSongForSelectableElement).filter(Boolean);
}

function normalizeSongPath(song) {
  const path = song?.file?.path || song?.path || '';
  return String(path).replace(/\\/g, '/').toLowerCase();
}

function songsMatch(first, second) {
  if (!first || !second) return false;
  const p1 = normalizeSongPath(first);
  const p2 = normalizeSongPath(second);
  if (p1 && p2 && p1 === p2) return true;
  if (first.id !== undefined && first.id !== null &&
      second.id !== undefined && second.id !== null &&
      String(first.id) === String(second.id)) return true;
  const t1 = (first.title || '').trim();
  const t2 = (second.title || '').trim();
  const a1 = (first.artist || '').trim();
  const a2 = (second.artist || '').trim();
  return Boolean(t1 && t2 && t1 === t2 && a1 === a2);
}

function persistFavoriteKeys() {
  updateFavoritesCount();
  void import('./scanner.js')
    .then(mod => mod.saveNativeLibraryCache?.())
    .catch(() => {});
}

function setSongFavorite(song, isFavorite) {
  if (!song) return;
  song.isFavorite = Boolean(isFavorite);

  // Actualizar la copia canónica en la biblioteca (por path, luego por match)
  const pathKey = normalizeSongPath(song);
  if (pathKey) {
    const lib = state.songsById?.get?.(pathKey) ||
      state.localMusicFiles.find(s => normalizeSongPath(s) === pathKey);
    if (lib) lib.isFavorite = Boolean(isFavorite);
  }

  const targets = [
    ...state.localMusicFiles,
    ...state.activeQueue,
    ...state.playbackHistory,
    ...state.playlists.flatMap(playlist => playlist.songs || [])
  ];
  targets
    .filter(candidate => candidate && songsMatch(candidate, song))
    .forEach(candidate => { candidate.isFavorite = Boolean(isFavorite); });

  persistFavoriteKeys();
}

async function toggleFavoriteForSelection(song, clickedElement = null) {
  const selectedSongs = clickedElement
    ? getSelectedSongs(clickedElement, song)
    : [...document.querySelectorAll('.song-card.is-multi-selected, .playlist-table-row.is-multi-selected')]
      .map(getSongForSelectableElement)
      .filter(Boolean);
  const sourceSongs = selectedSongs.length > 1 ? selectedSongs : [song];
  const songs = sourceSongs.filter((candidate, index) =>
    sourceSongs.findIndex(other => songsMatch(candidate, other)) === index
  );
  const allAreFavorites = songs.every(selectedSong => selectedSong.isFavorite);

  if (songs.length > 1 && allAreFavorites) {
    const proceed = await showConfirmDialog({
      title: '¿Quitar canciones de favoritos?',
      message: `Se quitarán ${songs.length} canciones de ${getFavoritesDisplayName()}. ¿Deseas continuar?`,
      confirmText: 'Quitar',
      cancelText: 'Cancelar'
    });
    if (!proceed) return;
  }

  const nextValue = songs.length > 1 ? !allAreFavorites : !song.isFavorite;
  songs.forEach(selectedSong => setSongFavorite(selectedSong, nextValue));
  refreshSongCardFavoriteIndicators();
  updateFavoritesCount();
  updateFavIcon();
}

export function addCurrentSongToPlaylist() {
  const song = state.currentTrackIndex === -1
    ? null
    : state.activeQueue[state.currentTrackIndex];
  if (!song) {
    void showConfirmDialog({
      title: 'Sin canción',
      message: 'Reproduce una canción para agregarla a una playlist.',
      confirmText: 'Entendido',
      showCancel: false
    });
    return;
  }
  openPlaylistPicker([song]);
}

export function toggleCurrentSongFavorite() {
  const song = state.currentTrackIndex === -1
    ? null
    : state.activeQueue[state.currentTrackIndex];
  if (!song) return;

  setSongFavorite(song, !song.isFavorite);
  refreshSongCardFavoriteIndicators();
  updateFavoritesCount();
  updateFavIcon();
}

function refreshSongCardFavoriteIndicators() {
  document.querySelectorAll('.song-card').forEach(card => {
    const song = state.localMusicFiles.find(candidate => candidate.id === Number(card.dataset.id));
    if (!song) return;
    const imageWrap = card.querySelector('.card-img-wrap');
    if (!imageWrap) return;
    imageWrap.classList.toggle('has-favorite', song.isFavorite);
    let badge = imageWrap.querySelector('.card-favorite-badge');
    if (song.isFavorite && !badge) {
      badge = document.createElement('span');
      badge.className = 'card-favorite-badge';
      badge.title = 'En favoritos';
      badge.setAttribute('aria-label', 'En favoritos');
      badge.innerHTML = '<i class="ph-fill ph-heart" aria-hidden="true"></i>';
      imageWrap.appendChild(badge);
    } else if (!song.isFavorite) {
      badge?.remove();
    }
  });
}

async function addSongsToQueue(songs, addNext, contextTitle = 'Cola de reproducción', contextId = 'queue') {
  const alreadyQueued = song => state.activeQueue.some(queuedSong =>
    queuedSong.id === song.id || (queuedSong.title === song.title && queuedSong.artist === song.artist)
  );
  const duplicates = songs.filter(alreadyQueued);
  let songsToAdd = songs;

  if (duplicates.length > 0) {
    const choice = await showConfirmDialog({
      title: 'Canciones que ya están en la cola',
      message: `${duplicates.length} de las canciones seleccionadas ya están en la cola. ¿Quieres agregarlas de nuevo o solo agregar las que faltan?`,
      confirmText: 'Agregar todas',
      alternateText: 'Omitir las repetidas',
      cancelText: 'Cancelar'
    });

    if (choice === false) return;
    if (choice === 'alternate') songsToAdd = songs.filter(song => !alreadyQueued(song));
  }

  if (songsToAdd.length > 0 && (state.activeQueue.length === 0 || state.currentTrackIndex === -1)) {
    const queue = songsToAdd.map((song, index) => ({
      ...song,
      isEnqueuedNext: addNext && index > 0
    }));
    playFromContext(queue, 0, contextTitle, true, contextId, true);
    return;
  }

  for (const song of songsToAdd) {
    if (addNext) await playNextInQueue(song, true);
    else await addToQueue(song, true);
  }
}

function getQueuePosition(song) {
  if (state.currentTrackIndex < 0) return null;
  const queueIndex = state.activeQueue.findIndex((queuedSong, index) =>
    index > state.currentTrackIndex &&
    queuedSong.isEnqueuedNext === true &&
    (queuedSong.id === song.id || (queuedSong.title === song.title && queuedSong.artist === song.artist))
  );
  return queueIndex === -1 ? null : queueIndex - state.currentTrackIndex;
}

function updateQueuePositionIndicator(element, song) {
  const existingBadge = element.querySelector('.queue-position-indicator');
  const position = getQueuePosition(song);
  if (!position) {
    existingBadge?.remove();
    return;
  }

  const badge = existingBadge || document.createElement('span');
  badge.className = 'queue-position-indicator';
  badge.title = `Se reproducirá en ${position} ${position === 1 ? 'canción' : 'canciones'}`;
  badge.setAttribute('aria-label', badge.title);
  badge.innerHTML = `<i class="ph ph-skip-forward" aria-hidden="true"></i><span>${position}</span>`;

  const badgeContainer = element.classList.contains('song-card')
    ? element.querySelector('.card-img-wrap')
    : element.querySelector('.row-thumb-box');
  if (badgeContainer && !existingBadge) badgeContainer.appendChild(badge);
}

function refreshQueuePositionIndicators() {
  document.querySelectorAll('.song-card, .playlist-table-row').forEach(element => {
    const song = getSongForSelectableElement(element);
    if (song) updateQueuePositionIndicator(element, song);
  });
}

export function renderGrids() {
  recentGrid.innerHTML = '';
  artistsGrid?.replaceChildren();
  exploreGrid.innerHTML = '';
  albumsGrid?.replaceChildren();

  if (state.localMusicFiles.length === 0) {
    recentGrid.innerHTML = `
      <div class="empty-state-card">
        <i class="ph ph-folder-open"></i>
        <h3>Tu biblioteca está vacía</h3>
        <p>No se ha escaneado música todavía. Haz clic en "Escanear música" para elegir tu carpeta local.</p>
        <button class="btn-primary" onclick="document.getElementById('native-folder-input').click()">
          <i class="ph ph-file-audio"></i> Seleccionar carpeta
        </button>
      </div>
    `;
    exploreGrid.innerHTML = `
      <div class="empty-state-card" style="padding: 2rem;">
        <p style="color:var(--text-muted); font-size:0.9rem;">Tus canciones y artistas aparecerán aquí una vez escaneada tu música.</p>
      </div>
    `;
    if (artistsGrid) {
      artistsGrid.innerHTML = '<div class="empty-state-card"><p>Aquí aparecerán los artistas de tu biblioteca.</p></div>';
    }
    if (albumsGrid) {
      albumsGrid.innerHTML = '<div class="empty-state-card"><p>Aquí aparecerán los álbumes de tu biblioteca.</p></div>';
    }
    renderAllAlbumsUI();
    return;
  }

  const recentSongs = [...state.localMusicFiles]
    .sort((a, b) => (b.file?.lastModified || 0) - (a.file?.lastModified || 0))
    .slice(0, 25);

  recentSongs.forEach((song, idx) => {
    recentGrid.appendChild(createSongCard(song, () => {
      playFromContext(recentSongs, idx, "Recién agregadas", true, "recent");
    }, "recent"));
  });

  const topArtists = getLibraryArtists().slice(0, 25);
  topArtists.forEach(artist => artistsGrid?.appendChild(createLibraryArtistCard(artist)));
  loadArtistPortraits(artistsGrid);

  const mostPlayedSongs = [...state.localMusicFiles]
    .sort((a, b) => (b.playCount || 0) - (a.playCount || 0))
    .slice(0, 25);

  mostPlayedSongs.forEach((song, idx) => {
    exploreGrid.appendChild(createSongCard(song, () => {
      playFromContext(mostPlayedSongs, idx, "Más escuchadas", true, "mostPlayed");
    }, "mostPlayed"));
  });

  getLibraryAlbums().slice(0, 25).forEach(album => {
    albumsGrid?.appendChild(createLibraryAlbumCard(album));
  });
  renderAllAlbumsUI();
  syncPlayingUI(!audio.paused);
}

function renderAllAlbumsUI({ append = false, previousVisibleCount = 0 } = {}) {
  if (!allAlbumsGrid) return;
  if (!append) {
    allAlbumsGrid.replaceChildren();
    albumGridVisibleCount = 50;
  }
  const albums = getLibraryAlbums().filter(album => album.songs.length > albumsMinTrackCount);
  if (albums.length === 0) {
    allAlbumsGrid.innerHTML = `
      <div class="empty-state-card" style="grid-column: 1 / -1;">
        <i class="ph ph-disc"></i>
        <h3>No hay álbumes que coincidan</h3>
        <p>Prueba otro filtro de cantidad de pistas o revisa los metadatos de tu biblioteca.</p>
      </div>
    `;
    return;
  }
  const firstIndex = append ? Math.min(previousVisibleCount, albums.length) : 0;
  albums.slice(firstIndex, albumGridVisibleCount)
    .forEach(album => allAlbumsGrid.appendChild(createLibraryAlbumCard(album, true)));
  const currentSong = state.currentTrackIndex >= 0 ? state.activeQueue[state.currentTrackIndex] : null;
  syncLibraryAlbumIndicators(currentSong, !audio.paused);
}

function syncLibraryAlbumIndicators(currentSong, isPlaying) {
  document.querySelectorAll('.library-album-card').forEach(card => {
    const indicator = card.querySelector('.library-album-playing-indicator');
    const isCurrentAlbum = Boolean(currentSong) &&
      String(currentSong.album || '').trim().toLocaleLowerCase() === card.dataset.albumTitle.toLocaleLowerCase() &&
      String(currentSong.artist || '').trim().toLocaleLowerCase() === card.dataset.albumArtist.toLocaleLowerCase();
    card.classList.toggle('is-playing-origin', isCurrentAlbum && state.activeContextId === card.dataset.albumContext);
    card.classList.toggle('is-playing-elsewhere', isCurrentAlbum && state.activeContextId !== card.dataset.albumContext);
    if (indicator) {
      indicator.hidden = !isCurrentAlbum;
      indicator.innerHTML = isCurrentAlbum ? getSoundWaveHTML(!isPlaying) : '';
    }
  });
}

export function renderHistoryUI() {
  if (!queueHistoryList || !historyCountEl) return;

  historyCountEl.textContent = state.playbackHistory.length;

  if (state.playbackHistory.length === 0) {
    queueHistoryList.innerHTML = `<div class="empty-queue-msg" style="padding: 0.5rem 0.2rem;">No hay canciones reproducidas aún</div>`;
    return;
  }

  queueHistoryList.innerHTML = '';
  state.playbackHistory.forEach((song, hIdx) => {
    const item = document.createElement('div');
    item.className = 'queue-item queue-history-item';
    item.dataset.songId = song.id;
    item.dataset.historyIdx = hIdx;

    const thumbHtml = `<img class="queue-thumb-img" alt="" width="36" height="36" />`;

    item.innerHTML = `
      <div class="queue-item-meta">
        <div class="queue-item-icon">${thumbHtml}</div>
        <div class="queue-item-info">
          <h5>${song.title}</h5>
          <span>${song.artist}</span>
        </div>
      </div>
    `;

    item.addEventListener('click', () => {
      const queueIdx = state.activeQueue.indexOf(song);
      if (queueIdx !== -1) {
        loadSong(queueIdx, true, true);
      } else {
        state.activeQueue.splice(state.currentTrackIndex, 0, song);
        loadSong(state.currentTrackIndex, true, true);
      }
    });

    queueHistoryList.appendChild(item);
    const historyImg = item.querySelector('.queue-thumb-img');
    if (historyImg) bindLazyCover(historyImg, song);
  });
}

function getPlaybackTrackReference(song) {
  return {
    path: song.file?.path || null,
    name: song.file?.name || null,
    title: song.title || '',
    artist: song.artist || '',
    album: song.album || ''
  };
}

export function persistPlaybackSession(isPlaying = !audio.paused) {
  if (!playbackSessionPersistenceReady) return;
  if (state.currentTrackIndex < 0 || !state.activeQueue[state.currentTrackIndex]) {
    if (!preservePlaybackSnapshotWhileEmpty) {
      const emptySnapshot = {
        queue: [],
        currentIndex: -1,
        currentTime: 0,
        isPlaying: false,
        title: 'Cola de reproducción',
        contextId: null
      };
      try {
        localStorage.setItem(PLAYBACK_SESSION_STORAGE_KEY, JSON.stringify(emptySnapshot));
      } catch (error) {
        console.error('No se pudo guardar la sesión vacía de reproducción:', error);
      }
    }
    return;
  }
  preservePlaybackSnapshotWhileEmpty = false;

  const snapshot = {
    queue: state.activeQueue.map(getPlaybackTrackReference),
    currentIndex: state.currentTrackIndex,
    currentTime: 0,
    isPlaying,
    title: state.activeQueueTitle,
    contextId: state.activeContextId
  };
  try {
    localStorage.setItem(PLAYBACK_SESSION_STORAGE_KEY, JSON.stringify(snapshot));
  } catch (error) {
    console.error('No se pudo guardar la sesión de reproducción:', error);
  }
}

function getPlaybackTrackReferenceKey(reference) {
  if (reference.path) return `path:${String(reference.path).replaceAll('\\', '/').toLowerCase()}`;
  return `meta:${reference.name || ''}:${reference.title || ''}:${reference.artist || ''}:${reference.album || ''}`.toLowerCase();
}

export async function initializePlaybackSession() {
  playbackSessionPersistenceReady = false;

  const restoreEnabled = localStorage.getItem('pn_restore_playback_session') !== 'false';
  preservePlaybackSnapshotWhileEmpty = !restoreEnabled;
  let snapshot = null;
  if (restoreEnabled) {
    try {
      const currentSnapshot = localStorage.getItem(PLAYBACK_SESSION_STORAGE_KEY);
      const legacySnapshot = currentSnapshot ? null : localStorage.getItem(LEGACY_PLAYBACK_SESSION_STORAGE_KEY);
      const storedSnapshot = currentSnapshot || legacySnapshot;
      snapshot = JSON.parse(storedSnapshot || 'null');
      if (legacySnapshot && snapshot) {
        localStorage.setItem(PLAYBACK_SESSION_STORAGE_KEY, legacySnapshot);
        localStorage.removeItem(LEGACY_PLAYBACK_SESSION_STORAGE_KEY);
      }
    } catch (error) {
      console.error('No se pudo leer la sesión de reproducción guardada:', error);
      localStorage.removeItem(PLAYBACK_SESSION_STORAGE_KEY);
      localStorage.removeItem(LEGACY_PLAYBACK_SESSION_STORAGE_KEY);
    }
  } else {
    state.activeQueue = [];
    state.activeQueueTitle = 'Cola de reproducción';
    state.activeContextId = null;
    state.currentTrackIndex = -1;
    stopPlaybackForDeletedFile();
    renderQueue();
    playbackSessionPersistenceReady = true;
    return;
  }

  const savedQueue = Array.isArray(snapshot?.queue) ? snapshot.queue : [];
  if (savedQueue.length > 0) {
    const tracksByReference = new Map(state.localMusicFiles.map(song => [
      getPlaybackTrackReferenceKey(getPlaybackTrackReference(song)),
      song
    ]));
    const restoredEntries = savedQueue
      .map((reference, index) => ({
        track: reference && typeof reference === 'object'
          ? tracksByReference.get(getPlaybackTrackReferenceKey(reference))
          : null,
        savedIndex: index
      }))
      .filter(entry => entry.track);
    const restoredQueue = restoredEntries.map(entry => entry.track);

    if (restoredQueue.length > 0) {
      state.activeQueue = restoredQueue;
      state.activeQueueTitle = snapshot.title || 'Cola de reproducción';
      state.activeContextId = snapshot.contextId || state.activeQueueTitle;
      state.currentTrackIndex = -1;
      const savedCurrentIndex = Math.max(0, Math.min(savedQueue.length - 1, Number(snapshot.currentIndex) || 0));
      const restoredCurrentIndex = restoredEntries.findIndex(entry => entry.savedIndex >= savedCurrentIndex);
      const currentIndex = restoredCurrentIndex >= 0 ? restoredCurrentIndex : restoredQueue.length - 1;
      const savedAudio = audio;
      const metadataReady = new Promise(resolve => {
        const cleanup = () => {
          savedAudio.removeEventListener('loadedmetadata', onLoaded);
          savedAudio.removeEventListener('error', onError);
        };
        const onLoaded = () => {
          cleanup();
          resolve();
        };
        const onError = () => {
          cleanup();
          console.error('No se pudo cargar el archivo de la sesión de reproducción guardada.');
          resolve();
        };
        savedAudio.addEventListener('loadedmetadata', onLoaded, { once: true });
        savedAudio.addEventListener('error', onError, { once: true });
      });
      await loadSong(currentIndex, false, false);
      await metadataReady;
      if (snapshot.isPlaying) {
        try {
          await audio.play();
        } catch (error) {
          console.error('No se pudo reanudar la reproducción guardada:', error);
        }
      }
    } else {
      console.warn('No se encontraron las canciones de la sesión guardada en las carpetas configuradas.');
    }
  }

  if (state.activeQueue.length === 0 && state.localMusicFiles.length > 0 && !snapshot) {
    playFromContext(state.localMusicFiles.slice(0, 25), 0, 'Recién agregadas', false);
  } else if (state.activeQueue.length === 0) {
    renderQueue();
  }

  playbackSessionPersistenceReady = true;
}

window.addEventListener('pagehide', () => persistPlaybackSession());

export function renderQueue() {
  refreshQueuePositionIndicators();

  if (state.activeQueue.length === 0 || state.currentTrackIndex === -1) {
    queueNowPlaying.innerHTML = `<div class="empty-queue-msg">Ninguna canción en reproducción</div>`;
    queueItemsContainer.innerHTML = `<div class="empty-queue-msg">La cola está vacía</div>`;
    renderHistoryUI();
    return;
  }

  if (queueHeaderTitle) {
    queueHeaderTitle.textContent = `Cola (${state.activeQueueTitle})`;
  }

  const current = state.activeQueue[state.currentTrackIndex];
  const coverHtml = current.coverUrl
    ? `<img src="${current.coverUrl}" alt="${current.title}" class="queue-cover-img" />`
    : `<i class="ph ph-waveform"></i>`;

  queueNowPlaying.innerHTML = `
    <div class="now-playing-left">
      <div class="now-playing-cover-box">${coverHtml}</div>
      <div class="now-playing-meta">
        <h5>${current.title}</h5>
        <p>${current.artist}</p>
      </div>
    </div>
    <div class="now-playing-wave-wrap">
      ${getSoundWaveHTML(audio.paused)}
    </div>
  `;
  queueNowPlaying.dataset.songId = current.id;

  renderHistoryUI();

  queueItemsContainer.innerHTML = '';
  const upcomingSongs = [];
  for (let i = state.currentTrackIndex + 1; i < state.activeQueue.length; i++) {
    upcomingSongs.push({ song: state.activeQueue[i], idx: i });
  }

  if (upcomingSongs.length === 0) {
    queueItemsContainer.innerHTML = `<div class="empty-queue-msg">No hay más canciones a continuación</div>`;
    return;
  }

  const visibleSongs = upcomingSongs.slice(0, state.queueVisibleCount);

  visibleSongs.forEach(({ song, idx }) => {
    const item = document.createElement('div');
    item.className = 'queue-item';
    item.dataset.songId = song.id;
    item.dataset.queueIdx = idx;

    item.draggable = true;

    item.addEventListener('dragstart', (e) => {
      draggedQueueIndex = idx;
      isDragging = true;
      e.dataTransfer.effectAllowed = 'move';
      e.dataTransfer.setData('text/plain', String(idx));
      requestAnimationFrame(() => {
        item.classList.add('queue-dragging');
      });
    });

    item.addEventListener('dragover', (e) => {
      if (draggedQueueIndex === null) return;
      e.preventDefault();
      e.stopPropagation();
      e.dataTransfer.dropEffect = 'move';

      if (draggedQueueIndex !== idx) {
        document.querySelectorAll('.queue-item').forEach(q => {
          if (q !== item) q.classList.remove('queue-drag-over');
        });
        item.classList.add('queue-drag-over');
      }
    });

    item.addEventListener('dragleave', (e) => {
      const rect = item.getBoundingClientRect();
      if (e.clientX <= rect.left || e.clientX >= rect.right || e.clientY <= rect.top || e.clientY >= rect.bottom) {
        item.classList.remove('queue-drag-over');
      }
    });

    item.addEventListener('drop', (e) => {
      e.preventDefault();
      e.stopPropagation();
      item.classList.remove('queue-drag-over');

      if (draggedQueueIndex !== null && draggedQueueIndex !== idx) {
        const itemToMove = state.activeQueue[draggedQueueIndex];
        state.activeQueue.splice(draggedQueueIndex, 1);
        let targetIndex = idx;
        if (draggedQueueIndex < targetIndex) targetIndex--;
        if (e.clientY > item.getBoundingClientRect().top + item.offsetHeight / 2) targetIndex++;
        state.activeQueue.splice(targetIndex, 0, itemToMove);
        renderQueue();
      }
      cleanupDragState();
    });

    item.addEventListener('dragend', cleanupDragState);

    const thumbHtml = `<img class="queue-thumb-img" alt="" width="36" height="36" />`;

    const badgeHtml = song.isEnqueuedNext
      ? `<div class="queue-item-badge" title="En cola para reproducir a continuación"><i class="ph-fill ph-queue"></i></div>`
      : ``;

    item.innerHTML = `
      <div class="queue-item-meta">
        <div class="queue-item-icon">${thumbHtml}</div>
        <div class="queue-item-info">
          <h5>${song.title}</h5>
          <span>${song.artist}</span>
        </div>
      </div>
      ${badgeHtml}
    `;

    item.addEventListener('click', (e) => {
      if (isDragging) {
        e.preventDefault();
        return;
      }
      loadSong(idx, true);
    });

    queueItemsContainer.appendChild(item);
    const queueImg = item.querySelector('.queue-thumb-img');
    if (queueImg) bindLazyCover(queueImg, song);
  });

  if (upcomingSongs.length > state.queueVisibleCount) {
    const loadMoreBtn = document.createElement('button');
    loadMoreBtn.className = 'btn-load-more-queue';
    const remainingCount = upcomingSongs.length - state.queueVisibleCount;
    loadMoreBtn.innerHTML = `<i class="ph ph-plus-circle"></i> Cargar más (${remainingCount} restantes)`;
    loadMoreBtn.addEventListener('click', () => {
      state.queueVisibleCount += 25;
      renderQueue();
    });
    queueItemsContainer.appendChild(loadMoreBtn);
  }
}

function favoriteStorageKey(song) {
  if (!song) return '';
  const pathKey = normalizeSongPath(song);
  if (pathKey) return `path:${pathKey}`;
  const title = (song.title || '').trim();
  const artist = (song.artist || '').trim();
  return title || artist ? `${title}:::${artist}` : '';
}

function songMatchesFavoriteKey(song, key) {
  if (!song || !key) return false;
  if (key.startsWith('path:')) {
    const path = (song.file?.path || song.path || '').replace(/\\/g, '/').toLowerCase();
    return path && key === `path:${path}`;
  }
  return key === `${song.title || ''}:::${song.artist || ''}`;
}

export function updateFavoritesCount() {
  const count = state.localMusicFiles.filter(s => s.isFavorite).length;
  if (favCountEl) favCountEl.textContent = `${count} canciones`;

  const favKeys = state.localMusicFiles
    .filter(s => s.isFavorite)
    .map(favoriteStorageKey)
    .filter(Boolean);
  try {
    localStorage.setItem('pn_favorites_keys', JSON.stringify(favKeys));
  } catch (error) {
    console.warn('No se pudieron guardar favoritos:', error);
  }
}

function getFavoritesDisplayName() {
  return localStorage.getItem('pn_rename_favorites_label') === 'true'
    ? 'Favoritos'
    : 'Tus me gusta';
}

function getFavoriteActionLabel(isFavorite) {
  if (localStorage.getItem('pn_rename_favorites_label') === 'true') {
    return isFavorite ? 'Quitar de Favoritos' : 'Guardar en Favoritos';
  }
  return isFavorite ? 'Quitar de tus me gusta' : 'Guardar en tus me gusta';
}

function getFavoriteActionLabelForSongs(songs) {
  if (songs.length <= 1) return getFavoriteActionLabel(Boolean(songs[0]?.isFavorite));
  const allAreFavorites = songs.every(song => song.isFavorite);
  return allAreFavorites
    ? `Quitar ${songs.length} de ${getFavoritesDisplayName()}`
    : `Agregar ${songs.length} a ${getFavoritesDisplayName()}`;
}

export function applyFavoritesDisplayName() {
  const displayName = getFavoritesDisplayName();
  const shortcutLabel = document.getElementById('favorites-shortcut-label');
  if (shortcutLabel) shortcutLabel.textContent = displayName;
  if (state.currentView === 'favorites') playlistHeroTitle.textContent = displayName;

  document.querySelectorAll('.row-fav-btn').forEach(button => {
    button.title = getFavoriteActionLabel(button.classList.contains('active'));
  });
  updateFavIcon();

  if (state.activeContextId === 'favorites') {
    state.activeQueueTitle = displayName;
    if (queueHeaderTitle) queueHeaderTitle.textContent = `Cola (${displayName})`;
    if (playerSourceLabel) {
      const sourceText = playerSourceLabel.querySelector('.player-source-text');
      if (sourceText) sourceText.textContent = displayName;
      playerSourceLabel.title = displayName;
      playerSourceLabel.setAttribute('aria-label', `Origen de reproducción: ${displayName}`);
    }
  }
}

export function updateFavIcon() {
  const song = state.currentTrackIndex === -1 ? null : state.activeQueue[state.currentTrackIndex];
  if (!song) {
    favIcon.className = "ph ph-heart";
    playerFavBtn.classList.remove('active');
    playerFavBtn.title = getFavoriteActionLabel(false);
  } else {
    favIcon.className = song.isFavorite ? "ph-fill ph-heart" : "ph ph-heart";
    playerFavBtn.classList.toggle('active', song.isFavorite);
    playerFavBtn.title = getFavoriteActionLabel(song.isFavorite);
  }
  updateFavoritesCount();

  if (state.currentView === 'favorites' || state.currentView === 'all-music' || state.currentView === 'folder-detail' || state.currentView === 'playlist') {
    renderPlaylistDetailView();
  } else if (state.currentView === 'artist') {
    renderPlaylistDetailView();
  } else if (state.currentView === 'search') {
    renderSearchResultsContent();
  }
}

function hideSearchSuggestions() {
  if (!searchSuggestions) return;
  searchSuggestions.hidden = true;
  searchSuggestions.replaceChildren();
}

function escapeSearchText(value) {
  return String(value).replace(/[&<>"']/g, character => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;'
  })[character]);
}

function openSearchResults(query) {
  state.searchQuery = query;
  if (state.currentView !== 'search') {
    state.searchTab = 'songs';
    navigateToView('search');
  } else {
    renderSearchResultsContent();
  }
  hideSearchSuggestions();
}

function renderSearchSuggestions(query) {
  if (!searchSuggestions) return;
  searchSuggestions.replaceChildren();

  const normalizedQuery = query.trim().toLocaleLowerCase();
  if (!normalizedQuery || state.currentView === 'search') {
    hideSearchSuggestions();
    return;
  }

  const songMatches = state.localMusicFiles.filter(song =>
    [song.title, song.artist, song.album].some(value =>
      value && value.toLocaleLowerCase().includes(normalizedQuery)
    )
  );
  const playlistMatches = state.playlists.filter(playlist =>
    [playlist.title, playlist.description].some(value =>
      value && value.toLocaleLowerCase().includes(normalizedQuery)
    )
  );
  const folderMatches = (state.configuredFolders || []).filter(folder =>
    folder.name && folder.name.toLocaleLowerCase().includes(normalizedQuery)
  );
  const resultCount = songMatches.length + playlistMatches.length + folderMatches.length;

  const appendGroup = (label, entries, type, getTitle, getSubtitle, getIcon) => {
    if (entries.length === 0) return;
    const heading = document.createElement('div');
    heading.className = 'search-suggestions-label';
    heading.textContent = label;
    searchSuggestions.appendChild(heading);

    entries.slice(0, type === 'song' ? 4 : 2).forEach(entry => {
      const suggestion = document.createElement('button');
      suggestion.type = 'button';
      suggestion.className = 'search-suggestion';
      suggestion.setAttribute('role', 'option');
      suggestion.dataset.quickType = type;
      suggestion.dataset.quickId = entry.id;

      const cover = document.createElement('span');
      cover.className = 'search-suggestion-cover';
      if (type === 'song' && entry.coverUrl) {
        const image = document.createElement('img');
        image.src = entry.coverUrl;
        image.alt = '';
        cover.appendChild(image);
      } else {
        cover.innerHTML = `<i class="${getIcon(entry)}"></i>`;
      }

      const meta = document.createElement('span');
      meta.className = 'search-suggestion-meta';
      const title = document.createElement('strong');
      title.textContent = getTitle(entry);
      const subtitle = document.createElement('span');
      subtitle.textContent = getSubtitle(entry);
      meta.append(title, subtitle);
      suggestion.append(cover, meta);
      suggestion.addEventListener('mousedown', event => event.preventDefault());
      suggestion.addEventListener('click', () => {
        if (type === 'song') {
          const queue = [...state.activeQueue];
          const insertionIndex = Math.max(0, state.currentTrackIndex);
          queue.splice(insertionIndex, 0, entry);
          playFromContext(queue, insertionIndex, 'Búsqueda', true, 'search_suggestions', false, true);
        } else if (type === 'playlist') {
          navigateToView('playlist', { playlistId: entry.id });
        } else if (type === 'folder') {
          navigateToView('folder-detail', { folderId: entry.id });
        }
        hideSearchSuggestions();
      });
      searchSuggestions.appendChild(suggestion);
    });
  };

  appendGroup('Canciones', songMatches, 'song',
    song => song.title || 'Sin título',
    song => song.artist || 'Desconocido',
    () => 'ph ph-music-note');
  appendGroup('Playlists', playlistMatches, 'playlist',
    playlist => playlist.title || 'Playlist sin título',
    playlist => `${getPlaylistSongs(playlist).length} canciones`,
    () => 'ph ph-playlist');
  appendGroup('Carpetas', folderMatches, 'folder',
    folder => folder.name,
    folder => `${folder.count || 0} canciones`,
    () => 'ph ph-folder');

  if (resultCount === 0) {
    const empty = document.createElement('div');
    empty.className = 'search-suggestions-label';
    empty.textContent = 'No se encontraron resultados';
    searchSuggestions.appendChild(empty);
  }

  const allResults = document.createElement('button');
  allResults.type = 'button';
  allResults.className = 'search-suggestion search-suggestion-all';
  allResults.textContent = `Ver todos los resultados (${resultCount})`;
  allResults.addEventListener('mousedown', event => event.preventDefault());
  allResults.addEventListener('click', () => openSearchResults(query.trim()));
  searchSuggestions.appendChild(allResults);
  searchSuggestions.hidden = false;
}

/**
 * Gestor unificado de navegación
 */
export function navigateToView(targetView, meta = null, pushHistory = true) {
  if (targetView === 'album-detail' && isAlbumNavigationBlocked(meta?.artistName, meta?.albumTitle)) return;
  const previousView = state.currentView;
  clearSongSelection();
  if (pushHistory && (
    state.currentView !== targetView ||
    (targetView === 'artist' && state.artistName !== meta?.artistName) ||
    (targetView === 'album-detail' && (
      state.albumTitle !== meta?.albumTitle || state.artistName !== meta?.artistName
    ))
  )) {
    state.viewHistory.push({
      view: state.currentView,
      playlistId: state.currentPlaylistId,
      folderId: state.currentFolderId,
      artistName: state.artistName,
      albumTitle: state.albumTitle,
      albumArtistName: state.albumArtistName
    });
  }

  state.currentView = targetView;
  if (meta && meta.playlistId !== undefined) state.currentPlaylistId = meta.playlistId;
  if (meta && meta.folderId !== undefined) state.currentFolderId = meta.folderId;
  syncTrackFilterContext();
  if (targetView === 'artist') {
    const nextArtistName = String(meta?.artistName || '').trim();
    state.artistName = nextArtistName;
  } else if (targetView === 'album-detail') {
    state.artistName = String(meta?.artistName || state.artistName || '').trim();
    state.albumArtistName = state.artistName;
    state.albumTitle = String(meta?.albumTitle || '').trim();
  }

  if (btnNavBack) {
    btnNavBack.style.display = targetView === 'home' ? 'none' : 'flex';
  }
  if (targetView !== 'search') hideSearchSuggestions();

  homeView.style.display = 'none';
  if (foldersView) foldersView.style.display = 'none';
  if (albumsView) albumsView.style.display = 'none';
  if (playlistsView) playlistsView.style.display = 'none';
  if (searchView) searchView.style.display = 'none';
  playlistView.style.display = 'none';

  navBtnHome.classList.remove('active');
  if (navBtnMusic) navBtnMusic.classList.remove('active');
  if (navBtnFolders) navBtnFolders.classList.remove('active');
  if (navBtnPlaylists) navBtnPlaylists.classList.remove('active');
  btnOpenFavorites.classList.remove('active');

  if (targetView === 'home') {
    homeView.style.display = 'flex';
    navBtnHome.classList.add('active');
    syncPlayingUI(!audio.paused);
  } else if (targetView === 'all-music') {
    playlistView.style.display = 'flex';
    if (navBtnMusic) navBtnMusic.classList.add('active');
    state.musicVisibleCount = 50;
    renderPlaylistDetailView();
  } else if (targetView === 'folders') {
    if (foldersView) foldersView.style.display = 'flex';
    if (navBtnFolders) navBtnFolders.classList.add('active');
    renderFoldersUI();
  } else if (targetView === 'albums') {
    if (albumsView) albumsView.style.display = 'flex';
    renderAllAlbumsUI();
  } else if (targetView === 'playlists-hub') {
    if (playlistsView) playlistsView.style.display = 'flex';
    if (navBtnPlaylists) navBtnPlaylists.classList.add('active');
    renderPlaylistsHubUI();
  } else if (targetView === 'favorites') {
    playlistView.style.display = 'flex';
    btnOpenFavorites.classList.add('active');
    renderPlaylistDetailView();
  } else if (targetView === 'search') {
    if (searchView) searchView.style.display = 'flex';
    renderSearchResultsContent();
  } else if (targetView === 'playlist' || targetView === 'folder-detail' || targetView === 'artist' || targetView === 'album-detail') {
    playlistView.style.display = 'flex';
    if (targetView === 'folder-detail' && navBtnFolders) navBtnFolders.classList.add('active');
    renderPlaylistDetailView();
  }

  if (document.documentElement.classList.contains('pn-smooth-transitions') &&
      !document.documentElement.classList.contains('pn-disable-animations') &&
      mainContent) {
    mainContent.classList.remove('pn-view-transition');
    void mainContent.offsetWidth;
    mainContent.classList.add('pn-view-transition');
    window.setTimeout(() => mainContent.classList.remove('pn-view-transition'), 280);
  }
}

/**
 * RENDERIZADO DE RESULTADOS DE BÚSQUEDA (PESTAÑAS ESTILO SPOTIFY)
 */
export function renderSearchResultsContent() {
  if (!searchResultsContent) return;
  searchResultsContent.innerHTML = '';

  const q = (state.searchQuery || '').trim().toLowerCase();
  const displayQuery = escapeSearchText(state.searchQuery || '');

  // Actualizar píldoras activas
  document.querySelectorAll('.search-pill').forEach(pill => {
    pill.classList.toggle('active', pill.dataset.tab === state.searchTab);
  });

  if (!q) {
    searchResultsContent.innerHTML = `
      <div class="empty-state-card" style="margin-top: 1rem;">
        <i class="ph ph-magnifying-glass"></i>
        <h3>Escribe para buscar</h3>
        <p>Busca canciones, artistas, álbumes, listas, carpetas o elementos de tu cola.</p>
      </div>
    `;
    return;
  }

  // 1. PESTAÑA CANCIONES (PRIMERA Y POR DEFECTO)
  if (state.searchTab === 'songs') {
    const matches = state.localMusicFiles.filter(s =>
      (s.title && s.title.toLowerCase().includes(q)) ||
      (s.artist && s.artist.toLowerCase().includes(q)) ||
      (s.album && s.album.toLowerCase().includes(q))
    );

    if (matches.length === 0) {
      searchResultsContent.innerHTML = `
        <div class="empty-state-card" style="margin-top: 1rem;">
          <i class="ph ph-music-notes"></i>
          <h3>No se encontraron canciones</h3>
          <p>No hay canciones que coincidan con "${displayQuery}".</p>
        </div>
      `;
      return;
    }

    const currentSong = state.currentTrackIndex !== -1 ? state.activeQueue[state.currentTrackIndex] : null;
    const isSearchContextActive = state.activeContextId === 'search_songs';

    const container = document.createElement('div');
    container.className = 'playlist-table-container';
    container.style.padding = '0';

    container.innerHTML = `
      <div class="playlist-table-header">
        <div class="col-index">#</div>
        <div class="col-title">Título</div>
        <div class="col-album">Álbum</div>
        <div class="col-date">Fecha en que se agregó</div>
        <div class="col-duration"><i class="ph ph-clock"></i></div>
      </div>
      <div class="playlist-table-body" id="search-tracks-body"></div>
    `;

    const body = container.querySelector('#search-tracks-body');

    matches.forEach((song, idx) => {
      const row = document.createElement('div');
      row.className = 'playlist-table-row';
      row.dataset.songId = song.id;
      row.dataset.trackIdx = idx;

      const isCurrent = currentSong && currentSong.id === song.id;
      if (isCurrent && isSearchContextActive) {
        row.classList.add('is-active');
      } else if (isCurrent) {
        row.classList.add('is-playing-elsewhere');
      }

      const thumbHtml = `<img class="row-thumb-img" alt="" width="40" height="40" />`;

      const indexHtml = (isCurrent && isSearchContextActive)
        ? getSoundWaveHTML(audio.paused)
        : `${idx + 1}`;

      row.innerHTML = `
        <div class="row-index">${indexHtml}</div>
        <div class="row-title-box">
          <div class="row-thumb-box">${thumbHtml}</div>
          <div class="row-text-meta">
            <strong>${song.title}</strong>
            <span>${song.artist || "Desconocido"}</span>
          </div>
        </div>
        <div class="row-album">${song.album || "Sencillo"}</div>
        <div class="row-date">${song.addedDate || "Reciente"}</div>
        <div class="row-duration-box">
          <span>${Number.isFinite(song.duration) && song.duration > 0 ? formatTime(song.duration) : '--:--'}</span>
          <button class="row-fav-btn ${song.isFavorite ? 'active' : ''}" title="${getFavoriteActionLabel(song.isFavorite)}">
            <i class="${song.isFavorite ? 'ph-fill ph-heart' : 'ph ph-heart'}"></i>
          </button>
        </div>
      `;

      updateQueuePositionIndicator(row, song);
      row.addEventListener('click', (e) => {
        if (e.target.closest('.row-fav-btn') || handleSongSelectionClick(row, e)) return;
        playSongFromContext(matches, idx, `Búsqueda: ${state.searchQuery}`, 'search_songs');
      });

      row.querySelector('.row-fav-btn').addEventListener('click', (e) => {
        e.stopPropagation();
        void toggleFavoriteForSelection(song, row);
      });

      body.appendChild(row);
      const lazyThumb = row.querySelector('.row-thumb-img');
      if (lazyThumb) bindLazyCover(lazyThumb, song);
      const searchThumb = row.querySelector('.row-thumb-img');
      if (searchThumb) bindLazyCover(searchThumb, song);
      updatePlaylistRowTitleMarquee(row, Boolean(isCurrent && !audio.paused));
    });

    searchResultsContent.appendChild(container);
  }

  // 2. PESTAÑA PLAYLISTS
  else if (state.searchTab === 'playlists') {
    const matches = state.playlists.filter(p =>
      (p.title && p.title.toLowerCase().includes(q)) ||
      (p.description && p.description.toLowerCase().includes(q))
    );

    if (matches.length === 0) {
      searchResultsContent.innerHTML = `
        <div class="empty-state-card" style="margin-top: 1rem;">
          <i class="ph ph-playlist"></i>
          <h3>No se encontraron listas de reproducción</h3>
          <p>No hay playlists que coincidan con "${displayQuery}".</p>
        </div>
      `;
      return;
    }

    const grid = document.createElement('div');
    grid.className = 'playlists-grid';

    const isOverlay = state.playlistsViewLayout === 'overlay';

    matches.forEach(pl => {
      const card = document.createElement('div');
      card.className = `playlist-grid-card ${isOverlay ? 'design-overlay' : 'design-standard'}`;
      card.dataset.id = pl.id;

      const playlistSongs = getPlaylistSongs(pl);
      const songsCount = playlistSongs.length;
      const isPinned = pl.isPinned !== false;
      const pinBadge = isPinned ? `<div class="card-pin-badge" title="Fijada en acceso directo"><i class="ph-fill ph-push-pin"></i></div>` : '';

      const isThisPlaylistPlaying = state.activeContextId === ('playlist_' + pl.id);
      if (isThisPlaylistPlaying) card.classList.add('is-playing-origin');

      if (isOverlay) {
        const coverHtml = pl.coverUrl
          ? `<img src="${pl.coverUrl}" class="overlay-bg-img" alt="${pl.title}" />`
          : `<div class="overlay-bg-placeholder"><i class="ph ph-playlist"></i></div>`;

        card.innerHTML = `
          ${pinBadge}
          ${coverHtml}
          <button class="card-play-hover" title="Reproducir playlist"><i class="ph-fill ph-play"></i></button>
          <div class="overlay-content-box">
            <div class="playlist-card-title-row">
              <h4>${pl.title}</h4>
              ${pl.smartFilter ? '<i class="ph ph-lightning smart-playlist-badge" title="Playlist dinámica" aria-label="Playlist dinámica"></i>' : ''}
              <div class="playlist-hub-soundwave-wrap">
                ${isThisPlaylistPlaying ? getSoundWaveHTML(audio.paused) : ''}
              </div>
            </div>
            <p>${pl.description || (pl.smartFilter ? "Playlist dinámica" : "Lista de reproducción")}</p>
            <span class="playlist-grid-count">${songsCount} canciones</span>
          </div>
        `;
      } else {
        const coverHtml = pl.coverUrl
          ? `<img src="${pl.coverUrl}" alt="${pl.title}" />`
          : `<i class="ph ph-playlist cover-placeholder-icon"></i>`;

        card.innerHTML = `
          ${pinBadge}
          <div class="playlist-card-cover-wrap">
            ${coverHtml}
            <button class="card-play-hover" title="Reproducir playlist"><i class="ph-fill ph-play"></i></button>
          </div>
          <div class="playlist-card-title-row">
            <h4>${pl.title}</h4>
            ${pl.smartFilter ? '<i class="ph ph-lightning smart-playlist-badge" title="Playlist dinámica" aria-label="Playlist dinámica"></i>' : ''}
            <div class="playlist-hub-soundwave-wrap">
              ${isThisPlaylistPlaying ? getSoundWaveHTML(audio.paused) : ''}
            </div>
          </div>
          <p>${pl.description || (pl.smartFilter ? "Playlist dinámica" : "Lista de reproducción")}</p>
          <span class="playlist-grid-count">${songsCount} canciones</span>
        `;
      }

      card.querySelector('.card-play-hover').addEventListener('click', (e) => {
        e.stopPropagation();
        if (playlistSongs.length > 0) {
          const contextId = 'playlist_' + pl.id;
          if (state.activeContextId === contextId && state.currentTrackIndex !== -1) {
            togglePlay();
          } else {
            playFromContext(playlistSongs, 0, pl.title, true, contextId, true);
          }
        }
      });

      card.addEventListener('click', () => {
        navigateToView('playlist', { playlistId: pl.id });
      });

      grid.appendChild(card);
    });

    searchResultsContent.appendChild(grid);
  }

  // 3. PESTAÑA CARPETAS
  else if (state.searchTab === 'folders') {
    const matches = state.configuredFolders.filter(f =>
      (f.name && f.name.toLowerCase().includes(q)) ||
      (f.description && f.description.toLowerCase().includes(q))
    );

    if (matches.length === 0) {
      searchResultsContent.innerHTML = `
        <div class="empty-state-card" style="margin-top: 1rem;">
          <i class="ph ph-folder"></i>
          <h3>No se encontraron carpetas</h3>
          <p>No hay carpetas vinculadas que coincidan con "${displayQuery}".</p>
        </div>
      `;
      return;
    }

    const grid = document.createElement('div');
    grid.className = 'folders-grid';

    matches.forEach(folder => {
      const card = document.createElement('div');
      card.className = 'folder-card';
      card.dataset.id = folder.id;

      const isThisFolderPlaying = state.activeContextId === ('folder_' + folder.id);
      if (isThisFolderPlaying) card.classList.add('is-playing-origin');

      card.innerHTML = `
        <div class="folder-card-icon"><i class="ph-fill ph-folder"></i></div>
        <div class="folder-card-info">
          <div class="folder-card-title-row">
            <span class="folder-card-title">${folder.name}</span>
            <div class="folder-soundwave-wrap">
              ${isThisFolderPlaying ? getSoundWaveHTML(audio.paused) : ''}
            </div>
          </div>
          <span class="folder-card-desc">${folder.description || "Carpeta local de música"}</span>
          <span class="folder-card-count">${folder.count} canciones</span>
        </div>
      `;

      card.addEventListener('click', () => {
        navigateToView('folder-detail', { folderId: folder.id });
      });

      grid.appendChild(card);
    });

    searchResultsContent.appendChild(grid);
  }

  // Pestaña artistas
  else if (state.searchTab === 'artists') {
    const matches = getLibraryArtists().filter(artist =>
      artist.name.toLocaleLowerCase().includes(q)
    );
    if (matches.length === 0) {
      searchResultsContent.innerHTML = `
        <div class="empty-state-card" style="margin-top: 1rem;">
          <i class="ph ph-user"></i>
          <h3>No se encontraron artistas</h3>
          <p>No hay artistas que coincidan con "${displayQuery}".</p>
        </div>
      `;
      return;
    }
    const grid = document.createElement('div');
    grid.className = 'albums-grid';
    matches.forEach(artist => grid.appendChild(createLibraryArtistCard(artist)));
    searchResultsContent.appendChild(grid);
    loadArtistPortraits(grid);
  }

  // Pestaña álbumes
  else if (state.searchTab === 'albums') {
    const matches = getLibraryAlbums().filter(album =>
      album.songs.length > albumsMinTrackCount &&
      (album.title.toLocaleLowerCase().includes(q) || album.artist.toLocaleLowerCase().includes(q))
    );
    if (matches.length === 0) {
      searchResultsContent.innerHTML = `
        <div class="empty-state-card" style="margin-top: 1rem;">
          <i class="ph ph-disc"></i>
          <h3>No se encontraron álbumes</h3>
          <p>No hay álbumes que coincidan con "${displayQuery}".</p>
        </div>
      `;
      return;
    }
    const grid = document.createElement('div');
    grid.className = 'albums-grid';
    matches.forEach(album => grid.appendChild(createLibraryAlbumCard(album, true)));
    searchResultsContent.appendChild(grid);
    const currentSong = state.currentTrackIndex >= 0 ? state.activeQueue[state.currentTrackIndex] : null;
    syncLibraryAlbumIndicators(currentSong, !audio.paused);
  }

  // Pestaña cola de reproducción
  else if (state.searchTab === 'queue') {
    const matches = state.activeQueue
      .map((s, idx) => ({ song: s, queueIndex: idx }))
      .filter(({ song }) =>
        (song.title && song.title.toLowerCase().includes(q)) ||
        (song.artist && song.artist.toLowerCase().includes(q)) ||
        (song.album && song.album.toLowerCase().includes(q))
      );

    if (matches.length === 0) {
      searchResultsContent.innerHTML = `
        <div class="empty-state-card" style="margin-top: 1rem;">
          <i class="ph ph-queue"></i>
          <h3>Sin coincidencias en la cola</h3>
          <p>No se encontraron canciones en la cola activa que coincidan con "${displayQuery}".</p>
        </div>
      `;
      return;
    }

    const container = document.createElement('div');
    container.className = 'playlist-table-container';
    container.style.padding = '0';

    container.innerHTML = `
      <div class="playlist-table-header">
        <div class="col-index">#</div>
        <div class="col-title">Título</div>
        <div class="col-album">Álbum</div>
        <div class="col-date">Posición en cola</div>
        <div class="col-duration"><i class="ph ph-clock"></i></div>
      </div>
      <div class="playlist-table-body" id="search-queue-body"></div>
    `;

    const body = container.querySelector('#search-queue-body');

    matches.forEach(({ song, queueIndex }) => {
      const row = document.createElement('div');
      row.className = 'playlist-table-row';
      row.dataset.songId = song.id;
      row.dataset.trackIdx = queueIndex;

      const isCurrent = state.currentTrackIndex === queueIndex;
      if (isCurrent) {
        row.classList.add('is-active');
      }

      const thumbHtml = `<img class="row-thumb-img" alt="" width="40" height="40" />`;

      const indexHtml = isCurrent
        ? getSoundWaveHTML(audio.paused)
        : `${queueIndex + 1}`;

      row.innerHTML = `
        <div class="row-index">${indexHtml}</div>
        <div class="row-title-box">
          <div class="row-thumb-box">${thumbHtml}</div>
          <div class="row-text-meta">
            <strong>${song.title}</strong>
            <span>${song.artist || "Desconocido"}</span>
          </div>
        </div>
        <div class="row-album">${song.album || "Sencillo"}</div>
        <div class="row-date">${isCurrent ? 'Sonando ahora' : 'En cola'}</div>
        <div class="row-duration-box">
          <span>${Number.isFinite(song.duration) && song.duration > 0 ? formatTime(song.duration) : '--:--'}</span>
          <button class="row-fav-btn ${song.isFavorite ? 'active' : ''}" title="${getFavoriteActionLabel(song.isFavorite)}">
            <i class="${song.isFavorite ? 'ph-fill ph-heart' : 'ph ph-heart'}"></i>
          </button>
        </div>
      `;

      row.addEventListener('click', (e) => {
        if (e.target.closest('.row-fav-btn')) return;
        loadSong(queueIndex, true);
      });

      row.querySelector('.row-fav-btn').addEventListener('click', (e) => {
        e.stopPropagation();
        void toggleFavoriteForSelection(song, row);
      });

      body.appendChild(row);
      const lazyThumb = row.querySelector('.row-thumb-img');
      if (lazyThumb) bindLazyCover(lazyThumb, song);
      const searchThumb = row.querySelector('.row-thumb-img');
      if (searchThumb) bindLazyCover(searchThumb, song);
      updatePlaylistRowTitleMarquee(row, Boolean(isCurrent && !audio.paused));
    });

    searchResultsContent.appendChild(container);
  }
}

/* RENDERIZADO DEL GRID DE CARPETAS */
export function renderFoldersUI() {
  if (!foldersGrid) return;
  loadFolderSortMode();
  foldersGrid.innerHTML = '';

  if (!state.configuredFolders || state.configuredFolders.length === 0) {
    foldersGrid.innerHTML = `
      <div class="empty-state-card" style="grid-column: 1 / -1;">
        <i class="ph ph-folder-open"></i>
        <h3>No hay carpetas vinculadas</h3>
        <p>Ve a Configuración o escanea una carpeta para indexar tus canciones.</p>
      </div>
    `;
    return;
  }

  let foldersList = [...state.configuredFolders];

  if (state.folderSortMode === 'name') {
    foldersList.sort((a, b) => a.name.localeCompare(b.name));
  } else if (state.folderSortMode === 'count') {
    foldersList.sort((a, b) => (b.count || 0) - (a.count || 0));
  } else if (state.folderSortMode === 'date') {
    foldersList.sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0));
  } else if (state.folderSortMode === 'recent') {
    foldersList.sort((a, b) => (b.lastPlayed || 0) - (a.lastPlayed || 0));
  }

  foldersList.forEach(folder => {
    const card = document.createElement('div');
    card.className = 'folder-card';
    card.dataset.id = folder.id;

    const isThisFolderPlaying = state.activeContextId === ('folder_' + folder.id);
    if (isThisFolderPlaying) {
      card.classList.add('is-playing-origin');
    }

    card.innerHTML = `
      <div class="folder-card-icon">
        <i class="ph-fill ph-folder"></i>
      </div>
      <div class="folder-card-info">
        <div class="folder-card-title-row">
          <span class="folder-card-title">${folder.name}</span>
          <div class="folder-soundwave-wrap">
            ${isThisFolderPlaying ? getSoundWaveHTML(audio.paused) : ''}
          </div>
        </div>
        <span class="folder-card-desc">${folder.description || "Carpeta local de música"}</span>
        <span class="folder-card-count">${folder.count} canciones</span>
      </div>
    `;

    card.addEventListener('click', () => {
      navigateToView('folder-detail', { folderId: folder.id });
    });

    foldersGrid.appendChild(card);
  });
}

/* RENDERIZADO DEL HUB DE PLAYLISTS */
export function renderPlaylistsHubUI() {
  loadPlaylistsViewSortMode();
  if (!playlistsGrid) return;
  playlistsGrid.innerHTML = '';

  if (!state.playlists || state.playlists.length === 0) {
    playlistsGrid.innerHTML = `
      <div class="empty-state-card" style="grid-column: 1 / -1;">
        <i class="ph ph-playlist"></i>
        <h3>No tienes listas de reproducción creadas</h3>
        <p>Haz clic en "Crear playlist" para organizar tus temas favoritos.</p>
        <button class="btn-primary" onclick="document.getElementById('btn-add-playlist').click()">
          <i class="ph ph-plus"></i> Crear mi primera playlist
        </button>
      </div>
    `;
    return;
  }

  let list = [...state.playlists];
  if (state.playlistsViewSortMode === 'name') {
    list.sort((a, b) => a.title.localeCompare(b.title));
  } else if (state.playlistsViewSortMode === 'count') {
    list.sort((a, b) => getPlaylistSongs(b).length - getPlaylistSongs(a).length);
  } else if (state.playlistsViewSortMode === 'date') {
    list.sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0));
  } else if (state.playlistsViewSortMode === 'pinned') {
    list.sort((a, b) => (b.isPinned === false ? 0 : 1) - (a.isPinned === false ? 0 : 1));
  }

  const isOverlay = state.playlistsViewLayout === 'overlay';

  list.forEach(pl => {
    const card = document.createElement('div');
    card.className = `playlist-grid-card ${isOverlay ? 'design-overlay' : 'design-standard'}`;
    card.dataset.id = pl.id;

    const songsCount = getPlaylistSongs(pl).length;
    const isPinned = pl.isPinned !== false;
    const pinBadge = isPinned ? `<div class="card-pin-badge" title="Fijada en acceso directo"><i class="ph-fill ph-push-pin"></i></div>` : '';

    const isThisPlaylistPlaying = state.activeContextId === ('playlist_' + pl.id);
    if (isThisPlaylistPlaying) {
      card.classList.add('is-playing-origin');
    }

    if (isOverlay) {
      const coverHtml = pl.coverUrl
        ? `<img src="${pl.coverUrl}" class="overlay-bg-img" alt="${pl.title}" />`
        : `<div class="overlay-bg-placeholder"><i class="ph ph-playlist"></i></div>`;

      card.innerHTML = `
        ${pinBadge}
        ${coverHtml}
        <button class="card-play-hover" title="Reproducir playlist">
          <i class="ph-fill ph-play"></i>
        </button>
        <div class="overlay-content-box">
          <div class="playlist-card-title-row">
            <h4>${pl.title}</h4>
            ${pl.smartFilter ? '<i class="ph ph-lightning smart-playlist-badge" title="Playlist dinámica" aria-label="Playlist dinámica"></i>' : ''}
            <div class="playlist-hub-soundwave-wrap">
              ${isThisPlaylistPlaying ? getSoundWaveHTML(audio.paused) : ''}
            </div>
          </div>
          <p>${pl.description || (pl.smartFilter ? "Playlist dinámica" : "Lista de reproducción")}</p>
          <span class="playlist-grid-count">${songsCount} canciones</span>
        </div>
      `;
    } else {
      const coverHtml = pl.coverUrl
        ? `<img src="${pl.coverUrl}" alt="${pl.title}" />`
        : `<i class="ph ph-playlist cover-placeholder-icon"></i>`;

      card.innerHTML = `
        ${pinBadge}
        <div class="playlist-card-cover-wrap">
          ${coverHtml}
          <button class="card-play-hover" title="Reproducir playlist">
            <i class="ph-fill ph-play"></i>
          </button>
        </div>
        <div class="playlist-card-title-row">
          <h4>${pl.title}</h4>
          ${pl.smartFilter ? '<i class="ph ph-lightning smart-playlist-badge" title="Playlist dinámica" aria-label="Playlist dinámica"></i>' : ''}
          <div class="playlist-hub-soundwave-wrap">
            ${isThisPlaylistPlaying ? getSoundWaveHTML(audio.paused) : ''}
          </div>
        </div>
        <p>${pl.description || (pl.smartFilter ? "Playlist dinámica" : "Lista de reproducción")}</p>
        <span class="playlist-grid-count">${songsCount} canciones</span>
      `;
    }

    const playBtn = card.querySelector('.card-play-hover');
    playBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const playlistSongs = getPlaylistSongs(pl);
      if (playlistSongs.length > 0) {
        const contextId = 'playlist_' + pl.id;
        if (state.activeContextId === contextId && state.currentTrackIndex !== -1) {
          togglePlay();
        } else {
          playFromContext(playlistSongs, 0, pl.title, true, contextId, true);
        }
      } else {
        showConfirmDialog({
          title: "Playlist vacía",
          message: "Esta playlist no contiene canciones aún.",
          confirmText: "Aceptar",
          showCancel: false
        });
      }
    });

    card.addEventListener('click', () => {
      navigateToView('playlist', { playlistId: pl.id });
    });

    playlistsGrid.appendChild(card);
  });
}

export async function renderPlaylistDetailView({ append = false, previousVisibleCount = 0 } = {}) {
  loadTrackSortModeForView();
  syncTrackFilterContext();
  const paginationContextKey = JSON.stringify([
    state.currentView,
    state.currentPlaylistId,
    state.currentFolderId,
    state.artistName,
    state.albumArtistName,
    state.albumTitle,
    activeTrackFilter.field,
    activeTrackFilter.value
  ]);
  if (detailVisibleContextKey !== paginationContextKey) {
    detailVisibleContextKey = paginationContextKey;
    detailVisibleCount = state.currentView === 'artist' ? ARTIST_TRACK_PAGE_SIZE : 50;
    if (state.currentView === 'all-music') state.musicVisibleCount = 50;
  }
  const isFav = state.currentView === 'favorites';
  const isMusic = state.currentView === 'all-music';
  const isFolder = state.currentView === 'folder-detail';
  const isArtist = state.currentView === 'artist';
  const isAlbum = state.currentView === 'album-detail';
  if (artistLoadMoreWrap) artistLoadMoreWrap.hidden = true;
  const effectiveTrackSortMode = (isMusic || isFolder) && state.trackSortMode === 'custom'
    ? 'title'
    : state.trackSortMode;
  updateTrackReorderToggle();
  if (artistAlbumsSection) artistAlbumsSection.hidden = !isArtist;
  if (artistRelatedSection) artistRelatedSection.hidden = !isArtist;
  if (artistTagsContainer && !isArtist) {
    artistTagsContainer.replaceChildren();
    artistTagsContainer.hidden = true;
  }
  if (!isArtist) {
    if (artistDisambiguation) {
      artistDisambiguation.textContent = '';
      artistDisambiguation.hidden = true;
    }
    if (artistFacts) {
      artistFacts.replaceChildren();
      artistFacts.hidden = true;
    }
  }
  if (artistBioToggle) artistBioToggle.hidden = !isArtist;
  playlistHeroBanner.classList.toggle('artist-profile-hero', isArtist);
  playlistHeroBanner.classList.toggle('album-detail-hero', isAlbum);
  if (collectionOptionsWrap) {
    collectionOptionsWrap.hidden = !(isMusic || isFolder || isFav || isArtist || isAlbum || state.currentView === 'playlist');
  }
  const refreshProfileAction = collectionOptionsMenu?.querySelector('[data-collection-action="refresh-profile"]');
  const editProfileAction = collectionOptionsMenu?.querySelector('[data-collection-action="edit-profile"]');
  if (refreshProfileAction) refreshProfileAction.hidden = !(isArtist || isAlbum);
  if (editProfileAction) editProfileAction.hidden = !(isArtist || isAlbum || isFolder);
  const refreshProfileLabel = refreshProfileAction?.querySelector('span');
  if (refreshProfileLabel) {
    refreshProfileLabel.textContent = isArtist ? 'Actualizar desde MusicBrainz' : 'Actualizar desde la biblioteca';
  }
  const editProfileLabel = editProfileAction?.querySelector('span');
  if (editProfileLabel) editProfileLabel.textContent = isFolder ? 'Editar descripción' : 'Editar información y foto';
  if (playlistHeroAuthor) {
    playlistHeroAuthor.disabled = !isAlbum;
    playlistHeroAuthor.classList.toggle('is-link', isAlbum);
  }
  const findMissingAction = collectionOptionsMenu?.querySelector('[data-collection-action="find-missing"]');
  if (findMissingAction) {
    const currentPlaylist = state.playlists.find(item => item.id === state.currentPlaylistId);
    findMissingAction.hidden = state.currentView !== 'playlist' || Boolean(currentPlaylist?.smartFilter);
  }
  if (collectionOptionsMenu) collectionOptionsMenu.hidden = true;
  if (btnCollectionOptions) btnCollectionOptions.setAttribute('aria-expanded', 'false');
  if (!isArtist && !isAlbum) {
    trackSortMenu?.querySelectorAll('.sort-option').forEach(option => { option.hidden = false; });
    const dateSortOption = trackSortMenu?.querySelector('[data-sort="date"]');
    if (dateSortOption) dateSortOption.textContent = 'Fecha en que se agregó';
    const albumTrackOption = trackSortMenu?.querySelector('[data-sort="track"]');
    if (albumTrackOption) albumTrackOption.hidden = true;
    const customSortOption = trackSortMenu?.querySelector('[data-sort="custom"]');
    if (customSortOption) customSortOption.hidden = isMusic || isFolder;
    trackSortMenu?.querySelectorAll('.sort-option').forEach(option => {
      option.classList.toggle('active', option.dataset.sort === effectiveTrackSortMode);
    });
    if (currentTrackSortLabel) {
      const activeOption = trackSortMenu?.querySelector(`[data-sort="${effectiveTrackSortMode}"]`);
      currentTrackSortLabel.textContent = activeOption?.textContent || 'Nombre de la canción';
    }
  }
  let playlist = null;
  let currentFolder = null;
  let rawSongs = [];

  if (isArtist) {
    const artistName = String(state.artistName || '').trim();
    if (!artistName) return;
    rawSongs = matchingArtistSongs(artistName);
    if (playlistBadgeType) playlistBadgeType.textContent = 'Artista';
    playlistHeroTitle.textContent = artistName;
    playlistHeroAuthor.textContent = artistName;
    playlistHeroCover.innerHTML = '<i class="ph ph-user-circle"></i>';
    playlistHeroDesc.textContent = 'Cargando información de MusicBrainz…';
    playlistHeroDesc.style.removeProperty('display');
    playlistHeroDesc.classList.remove('artist-bio-clamped', 'is-expanded');
    if (artistDisambiguation) {
      artistDisambiguation.textContent = '';
      artistDisambiguation.hidden = true;
    }
    if (artistFacts) {
      artistFacts.replaceChildren();
      artistFacts.hidden = true;
    }
    if (artistTagsContainer) {
      artistTagsContainer.replaceChildren();
      artistTagsContainer.hidden = true;
    }
    playlistHeroBanner.style.background = 'var(--bg-hero)';
    if (artistBioToggle) {
      artistBioToggle.hidden = true;
      artistBioToggle.textContent = 'Leer más';
      artistBioToggle.setAttribute('aria-expanded', 'false');
    }
    void applyArtistHeroMetadata(artistName);
    renderArtistAlbums(matchingArtistSongs(artistName));
    renderRelatedArtists(artistName, matchingArtistSongs(artistName));
    const sortLabel = state.artistSortMode === 'date' ? 'Más recientes' : 'Más escuchadas';
    if (currentTrackSortLabel) currentTrackSortLabel.textContent = sortLabel;
    trackSortMenu?.querySelectorAll('.sort-option').forEach(option => {
      const visible = option.dataset.sort === 'plays' || option.dataset.sort === 'date';
      option.hidden = !visible;
      option.classList.toggle('active', option.dataset.sort === state.artistSortMode);
      if (option.dataset.sort === 'date') option.textContent = 'Más recientes';
    });
  } else if (isAlbum) {
    const albumTitle = String(state.albumTitle || '').trim();
    const artistName = String(state.albumArtistName || state.artistName || '').trim();
    if (!albumTitle || !artistName) return;
    rawSongs = matchingAlbumSongs(artistName, albumTitle);
    const albumOverride = getProfileOverride('album', artistName, albumTitle);
    if (playlistBadgeType) playlistBadgeType.textContent = 'Álbum';
    playlistHeroTitle.textContent = albumTitle;
    playlistHeroAuthor.textContent = artistName;
    const coverUrl = albumOverride?.photo || rawSongs.map(s => resolveCoverUrl(s)).find(Boolean);
    playlistHeroCover.innerHTML = coverUrl
      ? `<img src="${escapeSearchText(coverUrl)}" class="playlist-hero-cover-img" alt="Carátula de ${escapeSearchText(albumTitle)}" />`
      : '<i class="ph ph-disc"></i>';
    playlistHeroDesc.textContent = albumOverride?.description || '';
    playlistHeroDesc.style.display = albumOverride?.description ? 'block' : 'none';
    if (artistFacts) {
      artistFacts.replaceChildren();
      const facts = [
        ['Año', albumOverride?.year],
        ['Sello', albumOverride?.label]
      ].filter(([, value]) => value);
      artistFacts.hidden = facts.length === 0;
      facts.forEach(([label, value]) => {
        const item = document.createElement('span');
        item.className = 'artist-fact';
        const name = document.createElement('strong');
        name.textContent = `${label}: `;
        item.append(name, document.createTextNode(value));
        artistFacts.appendChild(item);
      });
    }
    if (artistBioToggle) artistBioToggle.hidden = true;
    playlistHeroBanner.style.background = 'var(--bg-hero)';
    const sortLabel = state.albumSortMode === 'plays'
      ? 'Más escuchadas'
      : state.albumSortMode === 'date' ? 'Más recientes' : 'N.º de pista';
    if (currentTrackSortLabel) currentTrackSortLabel.textContent = sortLabel;
    trackSortMenu?.querySelectorAll('.sort-option').forEach(option => {
      const visible = ['track', 'plays', 'date'].includes(option.dataset.sort);
      option.hidden = !visible;
      option.classList.toggle('active', option.dataset.sort === state.albumSortMode);
      if (option.dataset.sort === 'track') option.textContent = 'N.º de pista';
      if (option.dataset.sort === 'date') option.textContent = 'Más recientes';
    });
  } else if (isFav) {
    playlistHeroDesc.classList.remove('artist-bio-clamped', 'is-expanded');
    rawSongs = state.localMusicFiles.filter(s => s.isFavorite);
    if (playlistBadgeType) playlistBadgeType.textContent = "Playlist";
    playlistHeroTitle.textContent = getFavoritesDisplayName();
    if (playlistHeroAuthor) playlistHeroAuthor.textContent = 'Resonance';
    playlistHeroDesc.style.display = "none";
    playlistHeroCover.innerHTML = `<i class="ph-fill ph-heart"></i>`;
    playlistHeroBanner.style.background = 'var(--bg-hero)';
  } else if (isMusic) {
    playlistHeroDesc.classList.remove('artist-bio-clamped', 'is-expanded');
    rawSongs = [...state.localMusicFiles];
    if (playlistBadgeType) playlistBadgeType.textContent = "Biblioteca";
    playlistHeroTitle.textContent = "Música";
    if (playlistHeroAuthor) playlistHeroAuthor.textContent = 'Resonance';
    playlistHeroDesc.style.display = "none";
    playlistHeroCover.innerHTML = `<i class="ph ph-music-notes"></i>`;
    playlistHeroBanner.style.background = 'var(--bg-hero)';
  } else if (isFolder) {
    playlistHeroDesc.classList.remove('artist-bio-clamped', 'is-expanded');
    currentFolder = state.configuredFolders.find(f => f.id === state.currentFolderId);
    if (!currentFolder) return;
    rawSongs = state.localMusicFiles.filter(s => s.folderName === currentFolder.name);
    if (playlistBadgeType) playlistBadgeType.textContent = "Carpeta";
    playlistHeroTitle.textContent = currentFolder.name;
    if (playlistHeroAuthor) playlistHeroAuthor.textContent = currentFolder.name;
    playlistHeroDesc.textContent = currentFolder.description || "Carpeta local de música";
    playlistHeroDesc.style.display = "block";
    playlistHeroCover.innerHTML = `<i class="ph-fill ph-folder"></i>`;
    playlistHeroBanner.style.background = 'var(--bg-hero)';
  } else {
    playlistHeroDesc.classList.remove('artist-bio-clamped', 'is-expanded');
    playlist = state.playlists.find(p => p.id === state.currentPlaylistId);
    if (!playlist) return;
    rawSongs = playlist.smartFilter ? getSmartPlaylistSongs(playlist) : (playlist.songs || []);
    if (playlistBadgeType) {
      playlistBadgeType.replaceChildren();
      if (playlist.smartFilter) {
        const icon = document.createElement('i');
        icon.className = 'ph ph-lightning';
        icon.setAttribute('aria-hidden', 'true');
        playlistBadgeType.append(icon, document.createTextNode(' Lista dinámica'));
      } else {
        playlistBadgeType.textContent = 'Playlist';
      }
    }
    playlistHeroTitle.textContent = playlist.title;
    if (playlistHeroAuthor) playlistHeroAuthor.textContent = 'Resonance';
    
    if (playlist.description && playlist.description.trim()) {
      playlistHeroDesc.textContent = playlist.description.trim();
      playlistHeroDesc.style.display = "block";
    } else {
      playlistHeroDesc.style.display = "none";
    }

    if (playlist.coverUrl) {
      playlistHeroCover.innerHTML = `<img src="${playlist.coverUrl}" class="playlist-hero-cover-img" alt="Cover" />`;
      const color = await extractDominantColor(playlist.coverUrl);
      playlistHeroBanner.style.background = `linear-gradient(180deg, rgba(${color.r}, ${color.g}, ${color.b}, 0.75) 0%, color-mix(in srgb, var(--bg-app) 40%, transparent) 100%)`;
    } else {
      playlistHeroCover.innerHTML = `<i class="ph ph-playlist"></i>`;
      playlistHeroBanner.style.background = 'var(--bg-hero)';
    }
  }

  if (tracksFilterBar) {
    tracksFilterBar.hidden = !(isFav || isMusic || isFolder || state.currentView === 'playlist');
  }
  let songs = [...rawSongs];
  if (isFav || isMusic || isFolder || state.currentView === 'playlist') {
    songs = songs.filter(song => matchesTrackFilter(song, activeTrackFilter));
  }
  if (isAlbum && state.albumSortMode === 'plays') {
    songs.sort((a, b) => (b.playCount || 0) - (a.playCount || 0));
  } else if (isAlbum && state.albumSortMode === 'date') {
    songs.sort((a, b) => (b.file?.lastModified || 0) - (a.file?.lastModified || 0));
  } else if (isAlbum && state.albumSortMode === 'track') {
    songs.sort((a, b) => {
      const trackA = Number(a.trackNumber) || Number.MAX_SAFE_INTEGER;
      const trackB = Number(b.trackNumber) || Number.MAX_SAFE_INTEGER;
      return trackA - trackB;
    });
  } else if (isArtist && state.artistSortMode === 'plays') {
    songs.sort((a, b) => (b.playCount || 0) - (a.playCount || 0));
  } else if (isArtist && state.artistSortMode === 'date') {
    songs.sort((a, b) => (b.file?.lastModified || 0) - (a.file?.lastModified || 0));
  } else if (effectiveTrackSortMode === 'plays') {
    songs.sort((a, b) => (b.playCount || 0) - (a.playCount || 0));
  } else if (effectiveTrackSortMode === 'title') {
    songs.sort((a, b) => (a.title || "").localeCompare(b.title || ""));
  } else if (effectiveTrackSortMode === 'date') {
    songs.sort((a, b) => (b.file?.lastModified || 0) - (a.file?.lastModified || 0));
  } else if (effectiveTrackSortMode === 'duration') {
    songs.sort((a, b) => (b.duration || 0) - (a.duration || 0));
  }

  playlistHeroCount.textContent = `${songs.length} canciones`;
  let totalSecs = 0;
  let songsWithDuration = 0;
  songs.forEach(song => {
    if (Number.isFinite(song.duration) && song.duration > 0) {
      totalSecs += song.duration;
      songsWithDuration++;
    }
  });
  const totalMins = Math.floor(totalSecs / 60);
  const formattedTotal = totalMins > 60
    ? `${Math.floor(totalMins / 60)} h ${totalMins % 60} min`
    : `${totalMins} min`;
  playlistHeroDuration.textContent = songsWithDuration === 0
    ? 'Duración desconocida'
    : songsWithDuration < songs.length
      ? `Al menos ${formattedTotal}`
      : formattedTotal;
  if (collectionOptionsMenu) {
    collectionOptionsMenu.querySelectorAll('[data-collection-action]').forEach(button => {
      const profileAction = ['refresh-profile', 'edit-profile'].includes(button.dataset.collectionAction);
      if (button.dataset.collectionAction === 'edit-profile') {
        button.hidden = !(isArtist || isAlbum || isFolder);
        button.disabled = false;
      } else if (button.dataset.collectionAction === 'refresh-profile') {
        button.hidden = !(isArtist || isAlbum);
        button.disabled = false;
      } else {
        button.hidden = isArtist || isAlbum;
        button.disabled = songs.length === 0;
      }
    });
  }

  if (!append) playlistTracksBody.replaceChildren();

  if (songs.length === 0) {
    const emptyMsg = activeTrackFilter.field !== 'all' && (isFolder || isFav || isMusic || state.currentView === 'playlist')
      ? "No hay canciones que coincidan con el filtro actual."
      : isFolder
      ? "No hay canciones dentro de esta carpeta."
      : (isAlbum
        ? `No hay canciones del álbum ${escapeSearchText(state.albumTitle)} de ${escapeSearchText(state.albumArtistName)} en tu biblioteca.`
      : (isArtist
        ? `No hay canciones de ${escapeSearchText(state.artistName)} en tu biblioteca.`
      : (isMusic 
        ? "Tu biblioteca local aún no tiene canciones escaneadas." 
        : (isFav ? "Aún no tienes canciones favoritas." : "Esta playlist está vacía."))));
    playlistTracksBody.innerHTML = `
      <div style="text-align: center; color: var(--text-muted); padding: 4rem 1rem; font-size: 0.95rem;">
        <i class="ph ph-folder-dashed" style="font-size: 3rem; color: var(--accent-light); margin-bottom: 0.8rem; display: block;"></i>
        ${emptyMsg}
      </div>
    `;
    return;
  }

  const currentSong = state.currentTrackIndex !== -1 ? state.activeQueue[state.currentTrackIndex] : null;
  
  let currentContextId = 'playlist_' + playlist?.id;
  if (isFav) currentContextId = 'favorites';
  else if (isMusic) currentContextId = 'all_music';
  else if (isFolder) currentContextId = 'folder_' + currentFolder.id;
  else if (isArtist) currentContextId = artistContextId(state.artistName);
  else if (isAlbum) currentContextId = albumContextId(state.albumArtistName, state.albumTitle);

  const isTableSourceActive = currentContextId === state.activeContextId;
  const collectionPlayIcon = btnPlayAllFavorites?.querySelector('i');
  if (collectionPlayIcon) {
    const isCurrentCollectionPlaying = currentSong &&
      state.activeContextId === currentContextId &&
      !audio.paused;
    collectionPlayIcon.className = isCurrentCollectionPlaying ? 'ph-fill ph-pause' : 'ph-fill ph-play';
    btnPlayAllFavorites.title = isCurrentCollectionPlaying ? 'Pausar' : 'Reproducir todo';
  }
  const visibleCount = isMusic ? state.musicVisibleCount : detailVisibleCount;
  const songsToDisplay = songs.slice(0, visibleCount);
  const firstSongToRender = append
    ? Math.min(previousVisibleCount, songsToDisplay.length)
    : 0;
  if (artistLoadMoreWrap) {
    const remainingCount = Math.max(0, songs.length - songsToDisplay.length);
    artistLoadMoreWrap.hidden = !isArtist || remainingCount === 0;
    if (artistLoadMoreButton && remainingCount > 0) {
      artistLoadMoreButton.textContent = `Cargar más canciones (${remainingCount} restantes)`;
    }
  }

  renderedTrackList = songs;
  renderedTrackContextId = currentContextId;
  renderedTrackContextTitle = playlist?.title ||
    (isMusic ? 'Música'
      : isFolder ? currentFolder.name
        : isArtist ? state.artistName
          : isAlbum ? `${state.albumTitle} — ${state.albumArtistName}`
            : isFav ? getFavoritesDisplayName() : 'Cola de reproducción');

  songsToDisplay.slice(firstSongToRender).forEach((song, pageIndex) => {
    const idx = firstSongToRender + pageIndex;
    const row = document.createElement('div');
    row.className = 'playlist-table-row';
    row.dataset.songId = song.id;
    row.dataset.trackIdx = idx;
    row.dataset.sourceTrackIdx = rawSongs.indexOf(song);

    if ((isFav || state.currentView === 'playlist') &&
        state.trackSortMode === 'custom' && activeTrackFilter.field === 'all' &&
        !playlist?.smartFilter && !isMusic && !isFolder && !isArtist &&
        (state.currentView !== 'playlist' || state.playlistTrackDragReorderEnabled)) {
      row.draggable = true;
    }

    const isCurrent = currentSong && currentSong.id === song.id;
    if (isCurrent && isTableSourceActive) {
      row.classList.add('is-active');
    } else if (isCurrent) {
      row.classList.add('is-playing-elsewhere');
    }

    const thumbHtml = `<img class="row-thumb-img" alt="" width="40" height="40" />`;

    const indexHtml = (isCurrent && isTableSourceActive)
      ? getSoundWaveHTML(audio.paused)
      : `${isAlbum && song.trackNumber ? song.trackNumber : idx + 1}`;

    row.innerHTML = `
      <div class="row-index">${indexHtml}</div>
      <div class="row-title-box">
        <div class="row-thumb-box">${thumbHtml}</div>
        <div class="row-text-meta">
          <strong>${song.title}</strong>
          <span>${song.artist || "Desconocido"}</span>
        </div>
      </div>
      <div class="row-album">${song.album || "Sencillo"}</div>
      <div class="row-date">${song.addedDate || "Reciente"}</div>
      <div class="row-duration-box">
        <span>${Number.isFinite(song.duration) && song.duration > 0 ? formatTime(song.duration) : '--:--'}</span>
        <button class="row-fav-btn ${song.isFavorite ? 'active' : ''}" title="${getFavoriteActionLabel(song.isFavorite)}">
          <i class="${song.isFavorite ? 'ph-fill ph-heart' : 'ph ph-heart'}"></i>
        </button>
      </div>
    `;

    updateQueuePositionIndicator(row, song);
    playlistTracksBody.appendChild(row);
    const thumbImg = row.querySelector('.row-thumb-img');
    if (thumbImg) bindLazyCover(thumbImg, song);
    updatePlaylistRowTitleMarquee(row, Boolean(isCurrent && !audio.paused));
  });
}

function getCollectionForOptions() {
  if (state.currentView === 'playlist') {
    const playlist = state.playlists.find(item => item.id === state.currentPlaylistId);
    if (!playlist) return null;
    const songs = playlist.smartFilter ? getSmartPlaylistSongs(playlist) : [...(playlist.songs || [])];
    return {
      title: playlist.title,
      songs: songs.filter(song => matchesTrackFilter(song, activeTrackFilter)),
      contextId: `playlist_${playlist.id}`
    };
  }
  if (state.currentView === 'folder-detail') {
    const folder = state.configuredFolders.find(item => item.id === state.currentFolderId);
    return folder
      ? {
        title: folder.name,
        songs: state.localMusicFiles.filter(song =>
          song.folderName === folder.name && matchesTrackFilter(song, activeTrackFilter)
        ),
        contextId: `folder_${folder.id}`
      }
      : null;
  }
  if (state.currentView === 'favorites') {
    return {
      title: getFavoritesDisplayName(),
      songs: state.localMusicFiles.filter(song =>
        song.isFavorite && matchesTrackFilter(song, activeTrackFilter)
      ),
      contextId: 'favorites'
    };
  }
  if (state.currentView === 'artist') {
    return {
      title: state.artistName,
      songs: matchingArtistSongs(state.artistName).filter(song =>
        matchesTrackFilter(song, activeTrackFilter)
      ),
      contextId: artistContextId(state.artistName)
    };
  }
  if (state.currentView === 'album-detail') {
    return {
      title: `${state.albumTitle} — ${state.albumArtistName}`,
      songs: matchingAlbumSongs(state.albumArtistName, state.albumTitle).filter(song =>
