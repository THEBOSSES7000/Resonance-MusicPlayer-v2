function updateProgressTimes(currentTime = audio.currentTime, duration = audio.duration) {
  timeCurrentEl.textContent = formatTime(currentTime);
  const showRemaining = showRemainingTime && progressContainer.dataset.progressStyle === 'waveform';
  timeTotalEl.textContent = showRemaining && Number.isFinite(duration) && duration >= 0
    ? `-${formatTime(Math.max(0, duration - currentTime))}`
    : formatTime(duration);
}

function getAudioQualityLabel(track) {
  const codec = String(track?.codec || '').toLowerCase();
  const extension = String(track?.file?.name || track?.file?.path || '').split('.').pop().toLowerCase();
  const isLossless = /flac|pcm|lossless|alac|wav/.test(codec) || ['flac', 'wav'].includes(extension);
  if (!isLossless) return 'Estándar';

  const sampleRate = Number(track?.sampleRate);
  const bitDepth = Number(track?.bitDepth);
  return sampleRate > 48000 || bitDepth > 16 ? 'Hi-Res' : 'Lossless';
}

function updateAudioQuality(track) {
  if (!audioQualityEl) return;
  const quality = track ? getAudioQualityLabel(track) : '';
  audioQualityEl.textContent = quality;
  audioQualityEl.dataset.qualityLevel = quality === 'Hi-Res' || quality === 'Lossless'
    ? 'lossless'
    : quality ? 'standard' : '';
}

/** Nivel 0–1 en el índice i (interpola si la caché tiene otra resolución). */
function waveformLevelAt(index, count = waveformBarCount) {
  if (waveformPeaks && waveformPeaks.length > 0) {
    const n = waveformPeaks.length;
    if (n === count) return Math.max(0, Math.min(1, waveformPeaks[index] || 0));
    const t = index / Math.max(1, count - 1);
    const pos = t * (n - 1);
    const i0 = Math.floor(pos);
    const i1 = Math.min(n - 1, i0 + 1);
    const frac = pos - i0;
    return Math.max(0, Math.min(1, (waveformPeaks[i0] || 0) * (1 - frac) + (waveformPeaks[i1] || 0) * frac));
  }
  return 0.28; // placeholder plano mientras carga
}

/** Onda continua (modo "Continua"): un path SVG relleno. */
function createWaveformSvg() {
  const count = waveformBarCount;
  const points = [];
  for (let index = 0; index < count; index++) {
    const progress = index / Math.max(1, count - 1);
    const level = waveformLevelAt(index, count);
    points.push(`${(progress * 1000).toFixed(1)},${(100 - level * 92).toFixed(1)}`);
  }
  const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
  path.setAttribute('d', `M0 100 L${points.join(' L')} L1000 100 Z`);
  const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
  svg.setAttribute('viewBox', '0 0 1000 100');
  svg.setAttribute('preserveAspectRatio', 'none');
  svg.setAttribute('class', 'progress-wave-svg');
  svg.appendChild(path);
  return svg;
}

/**
 * Barras estilo AIMP: ~200 divisiones, hueco claro, altura moderada.
 * Un canvas (sin cientos de nodos DOM).
 */
function createWaveformBarsCanvas(colorCss) {
  const count = waveformBarCount;
  const canvas = document.createElement('canvas');
  canvas.className = 'progress-wave-canvas';
  // ~4 px lógicos por barra → se distinguen como en AIMP
  const w = Math.max(count * 4, 800);
  const h = 100;
  canvas.width = w;
  canvas.height = h;
  const ctx = canvas.getContext('2d');
  if (!ctx) return canvas;
  ctx.clearRect(0, 0, w, h);
  ctx.fillStyle = colorCss;
  const slot = w / count;
  // Barra ~58% del slot, hueco visible (como AIMP)
  const barW = Math.max(1.5, slot * 0.58);
  // Suelo bajo + techo moderado: se notan valles y picos
  const minH = h * 0.08;
  const maxH = h * 0.62;
  for (let i = 0; i < count; i++) {
    const level = waveformLevelAt(i, count);
    const barH = minH + level * (maxH - minH);
    const x = i * slot + (slot - barW) * 0.5;
    ctx.fillRect(x, h - barH, barW, barH);
  }
  return canvas;
}

function initializeProgressWaveforms() {
  if (!progressWaveTrack || !progressWavePlayed) return;
  // Solo dibujar si el estilo de progreso es waveform (evita trabajo inútil)
  if (progressContainer?.dataset?.progressStyle !== 'waveform') {
    progressWaveTrack.replaceChildren();
    progressWavePlayed.replaceChildren();
    return;
  }
  if (waveformMode === 'smooth') {
    progressWaveTrack.replaceChildren(createWaveformSvg());
    progressWavePlayed.replaceChildren(createWaveformSvg());
  } else {
    // Barras densas (AIMP): canvas track gris + canvas played blanco
    progressWaveTrack.replaceChildren(createWaveformBarsCanvas('#666666'));
    progressWavePlayed.replaceChildren(createWaveformBarsCanvas('#ffffff'));
  }
  setProgressVisual(lastProgressRatio);
}

/**
 * Calcula (en Rust) los picos reales de la pista y redibuja la waveform.
 * No bloquea la UI; si el usuario cambia de canción, se descarta el resultado viejo.
 */
async function loadWaveformForTrack(track) {
  // Solo si el usuario eligió barra de progreso en modo waveform
  if (progressContainer?.dataset?.progressStyle !== 'waveform') {
    return;
  }
  const path = track?.file?.path || track?.path;
  if (!path || typeof path !== 'string' || path.startsWith('blob:')) {
    waveformPeaks = null;
    waveformPeaksPath = null;
    initializeProgressWaveforms();
    return;
  }
  // Ya tenemos picos de esta ruta y misma resolución
  if (
    waveformPeaksPath === path &&
    waveformPeaks &&
    waveformPeaks.length === WAVEFORM_PEAK_COUNT
  ) {
    initializeProgressWaveforms();
    return;
  }
  if (!nativeAudioEnabled) {
    waveformPeaks = null;
    waveformPeaksPath = null;
    initializeProgressWaveforms();
    return;
  }

  const requestId = ++waveformPeaksRequestId;
  // Siempre limpiar al cambiar de pista (evita mostrar la waveform de otra canción)
  waveformPeaks = null;
  waveformPeaksPath = path;
  initializeProgressWaveforms();

  try {
    const result = await nativeInvoke('native_audio_waveform_peaks', {
      path,
      barCount: WAVEFORM_PEAK_COUNT
    });
    if (requestId !== waveformPeaksRequestId) return;

    // El backend devuelve { path, peaks } para no aplicar picos de otra pista
    const resultPath = result?.path || result?.Path || '';
    const peaks = Array.isArray(result) ? result : (result?.peaks || result?.Peaks || null);

    if (resultPath && resultPath !== path) {
      return;
    }
    if (!Array.isArray(peaks) || peaks.length === 0) {
      waveformPeaks = null;
    } else {
      waveformPeaks = peaks.map(v => Math.max(0, Math.min(1, Number(v) || 0)));
      waveformPeaksPath = path;
    }
    initializeProgressWaveforms();
  } catch (error) {
    if (requestId !== waveformPeaksRequestId) return;
    console.warn('No se pudo generar la waveform de la pista:', error);
    waveformPeaks = null;
    initializeProgressWaveforms();
  }
}

function updatePlayerMinimumHeight() {
  const isWaveform = progressContainer.dataset.progressStyle === 'waveform';
  const isSplit = isWaveform && showRemainingTime;
  document.documentElement.style.setProperty(
    '--player-min-height',
    isSplit ? '108px' : (isWaveform ? '96px' : '84px')
  );
}

function updatePlayerSizing() {
  if (!playbackBar) return;
  const root = document.documentElement;
  const configuredHeight = Number.parseFloat(getComputedStyle(root).getPropertyValue('--player-height')) || 88;
  const stacked = window.matchMedia('(max-width: 940px)').matches;
  const compact = window.matchMedia('(max-width: 520px)').matches;
  const midSize = window.matchMedia('(max-width: 1100px)').matches;
  const clamp = (value, min, max) => Math.min(max, Math.max(min, value));
  const height = stacked ? Math.max(configuredHeight, 144) : configuredHeight;
  const scale = stacked
    ? clamp(0.9 + (height - 144) * 0.002, 0.9, 1.1)
    : clamp(1 + (height - 88) * 0.0025, 0.92, 1.22);
  const setPx = (name, value) => root.style.setProperty(name, `${value.toFixed(2)}px`);
  const setScaled = (name, base) => setPx(name, base * scale);
  const coverSize = stacked
    ? clamp(height * 0.4, 34, 72)
    : clamp(72 + (height - 88) * 0.22, 64, 92);
  const controlsGap = compact
    ? clamp(window.innerWidth * 0.022, 0.35 * 16, 0.7 * 16)
    : stacked
      ? clamp(window.innerWidth * 0.02, 0.55 * 16, 1 * 16)
      : midSize
        ? clamp(window.innerWidth * 0.01, 0.45 * 16, 0.9 * 16)
        : 1.1 * 16;
  const iconSize = compact ? 1 * 16 : stacked ? 1.12 * 16 : 1.25 * 16;
  const playSize = compact ? 32 : stacked ? 34 : 38;
  const rightGap = compact ? 0.4 * 16 : stacked || midSize ? 0.65 * 16 : 1.1 * 16;
  const leftGap = compact ? 0.45 * 16 : stacked || midSize ? 0.65 * 16 : 12;
  const columnGap = compact ? 0.35 * 16
    : stacked ? 0.75 * 16
      : midSize ? 0.8 * 16
        : clamp(window.innerWidth * 0.02, 0.75 * 16, 1.5 * 16);
  const inlinePadding = compact ? 0.55 * 16 : stacked || midSize ? 1 * 16
    : clamp(window.innerWidth * 0.02, 0.75 * 16, 1.5 * 16);

  setPx('--player-cover-size', coverSize);
  setScaled('--player-cover-icon-size', 24);
  setScaled('--player-meta-gap', 2);
  setScaled('--player-title-gap', 6);
  setScaled('--player-fav-size', 1.15 * 16);
  setScaled('--player-title-size', (compact ? 0.78 : 0.88) * 16);
  setScaled('--player-artist-size', (compact ? 0.68 : 0.75) * 16);
  setScaled('--player-left-gap', leftGap);
  setScaled('--player-center-gap', (stacked ? 0.15 : 0.375) * 16);
  setScaled('--player-controls-gap', controlsGap);
  setScaled('--player-icon-size', iconSize);
  setScaled('--player-play-size', playSize);
  setScaled('--player-play-icon-size', 1.15 * 16);
  setScaled('--player-progress-gap', (compact ? 0.35 : stacked ? 0.55 : 0.75) * 16);
  setScaled('--player-time-size', (compact ? 0.62 : 0.72) * 16);
  setScaled('--player-time-width', 32);
  setScaled('--player-progress-height', 4);
  setScaled('--player-progress-hover-height', 6);
  setScaled('--player-wave-height', 22);
  setScaled('--player-wave-hover-height', 24);
  setScaled('--player-wave-split-height', 24);
  setScaled('--player-wave-split-time-height', 14);
  setScaled('--player-wave-split-gap', 2);
  setScaled('--player-wave-split-time-size', 0.66 * 16);
  setScaled('--player-right-gap', rightGap);
  setScaled('--player-volume-gap', 8);
  setScaled('--player-volume-icon-size', compact ? 1 * 16 : 1.2 * 16);
  setScaled('--player-volume-slider-width', compact ? 42 : 70);
  setScaled('--player-column-gap', columnGap);
  setScaled('--player-inline-padding', inlinePadding);
  setScaled('--player-vertical-padding', Math.max(10, 6 * scale));
  setScaled('--player-row-gap', stacked ? 0.2 * 16 : 0);
}

updatePlayerSizing();
window.addEventListener('resize', updatePlayerSizing);
if (typeof ResizeObserver !== 'undefined' && playbackBar) {
