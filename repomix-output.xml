function updateLyricsResponsiveScale() {
  const width = lyricsScrollContainer?.clientWidth || window.innerWidth;
  const height = lyricsScrollContainer?.clientHeight || window.innerHeight;
  const scale = Math.max(0.42, Math.min(1, width / 900, height / 600));
  document.documentElement.style.setProperty('--lyrics-window-scale', String(scale));
}

function fitLyricLineToViewport(line) {
  const container = line?.closest('.lyrics-scroll-container');
  if (!container || container.clientHeight === 0) return;

  const topInset = Math.min(96, Math.max(32, container.clientHeight * 0.14));
  const bottomInset = Math.min(72, Math.max(24, container.clientHeight * 0.1));
  const availableHeight = Math.max(48, container.clientHeight - topInset - bottomInset);
  line.classList.add('is-fitting');
  line.style.setProperty('--lyric-line-fit-scale', '1');
  for (let attempt = 0; attempt < 5; attempt++) {
    const lineHeight = line.getBoundingClientRect().height;
    if (lineHeight <= availableHeight) break;
    const currentScale = Number.parseFloat(line.style.getPropertyValue('--lyric-line-fit-scale')) || 1;
    const nextScale = Math.max(0.32, currentScale * availableHeight / lineHeight * 0.96);
    if (nextScale === currentScale) break;
    line.style.setProperty('--lyric-line-fit-scale', String(nextScale));
  }
  line.classList.remove('is-fitting');
}

function refitActiveLyricLine() {
  lyricsLinesBox.querySelectorAll('.lyric-line-sync').forEach(fitLyricLineToViewport);
  if (activeLyricElement?.isConnected) {
    fitLyricLineToViewport(activeLyricElement);
  }
  if (state.isLyricsOpen && activeLyricElement?.isConnected && lyricsAutoScrollEnabled) {
    scrollLyricsLineIntoView(activeLyricElement);
  }
}

updateLyricsResponsiveScale();
window.addEventListener('resize', () => {
  updateLyricsResponsiveScale();
  requestAnimationFrame(refitActiveLyricLine);
});
if (typeof ResizeObserver !== 'undefined' && lyricsScrollContainer) {
  const lyricsResizeObserver = new ResizeObserver(() => {
    updateLyricsResponsiveScale();
    requestAnimationFrame(refitActiveLyricLine);
  });
  lyricsResizeObserver.observe(lyricsScrollContainer);
}

function clearLyricsFocusModeTimer() {
  if (lyricsFocusModeTimer !== null) {
    window.clearTimeout(lyricsFocusModeTimer);
    lyricsFocusModeTimer = null;
  }
}

function scheduleLyricsFocusMode() {
  clearLyricsFocusModeTimer();
  if (!state.isLyricsOpen || localStorage.getItem('pn_lyrics_focus_mode_enabled') !== 'true') {
    document.body.classList.remove('lyrics-focus-mode');
    document.body.classList.remove('lyrics-focus-mini-player-enabled');
    return;
  }
  const seconds = localStorage.getItem('pn_lyrics_focus_mode_timeout') === '10' ? 10 : 5;
  lyricsFocusModeTimer = window.setTimeout(() => {
    if (state.isLyricsOpen && localStorage.getItem('pn_lyrics_focus_mode_enabled') === 'true') {
      document.body.classList.add('lyrics-focus-mode');
      document.body.classList.toggle(
        'lyrics-focus-mini-player-enabled',
        localStorage.getItem('pn_lyrics_focus_mini_player_enabled') !== 'false'
      );
      // Rellenar la barra del mini-reproductor al entrar en modo foco
      updateSyncedLyricsProgress(getPlaybackPosition());
    }
  }, seconds * 1000);
}

function handleLyricsFocusModeActivity() {
  if (!state.isLyricsOpen) return;
  document.body.classList.remove('lyrics-focus-mode');
  document.body.classList.remove('lyrics-focus-mini-player-enabled');
  scheduleLyricsFocusMode();
}

function clearDragClasses() {
  document.querySelectorAll('.dragging, .table-dragging, .queue-dragging').forEach(el => {
    el.classList.remove('dragging', 'table-dragging', 'queue-dragging');
  });
  document.querySelectorAll('.drag-over, .table-drag-over, .queue-drag-over').forEach(el => {
    el.classList.remove('drag-over', 'table-drag-over', 'queue-drag-over');
  });
}

function cleanupDragState() {
  clearDragClasses();
  draggedTrackIndex = null;
  draggedQueueIndex = null;
  draggedPlaylistId = null;
  setTimeout(() => {
    isDragging = false;
  }, 100);
}

function canReorderTrackRows() {
  return state.trackSortMode === 'custom' &&
    (state.currentView === 'favorites' ||
      (state.currentView === 'playlist' && state.playlistTrackDragReorderEnabled)) &&
    draggedTrackIndex !== null;
}

function reorderTrackRows(targetRow, event) {
  if (!canReorderTrackRows()) return;
  const isFavorites = state.currentView === 'favorites';
  const playlist = state.currentView === 'playlist'
    ? state.playlists.find(item => item.id === state.currentPlaylistId)
    : null;
  const orderedTracks = isFavorites
    ? state.localMusicFiles.filter(song => song.isFavorite)
    : playlist?.songs;
  if (!orderedTracks || draggedTrackIndex < 0 || draggedTrackIndex >= orderedTracks.length) return;

  const sourceIndex = draggedTrackIndex;
  let targetIndex = targetRow
    ? Number(targetRow.dataset.sourceTrackIdx)
    : orderedTracks.length;
  if (!Number.isInteger(targetIndex) || targetIndex < 0) return;
  if (targetIndex === sourceIndex) return;
  if (sourceIndex < targetIndex) targetIndex -= 1;
  if (targetRow) {
    const rect = targetRow.getBoundingClientRect();
    if (event.clientY > rect.top + targetRow.offsetHeight / 2) targetIndex += 1;
  }
  targetIndex = Math.max(0, Math.min(orderedTracks.length - 1, targetIndex));
  if (sourceIndex === targetIndex) return;

  const [song] = orderedTracks.splice(sourceIndex, 1);
  orderedTracks.splice(targetIndex, 0, song);
  if (isFavorites) {
    const nonFavorites = state.localMusicFiles.filter(track => !track.isFavorite);
    state.localMusicFiles = [...orderedTracks, ...nonFavorites];
    localStorage.setItem(
      'pn_favorites_keys',
      JSON.stringify(orderedTracks.map(favoriteStorageKey).filter(Boolean))
    );
  } else {
    persistPlaylists();
  }
  void renderPlaylistDetailView();
}

function reorderPinnedPlaylists(sourceId, targetId = null, insertAfter = false) {
  const pinnedPlaylists = state.playlists.filter(playlist => playlist.isPinned !== false);
  const sourceIndex = pinnedPlaylists.findIndex(playlist => String(playlist.id) === String(sourceId));
  if (sourceIndex < 0) return;

  const [playlist] = pinnedPlaylists.splice(sourceIndex, 1);
  let targetIndex = targetId === null
    ? pinnedPlaylists.length
    : pinnedPlaylists.findIndex(item => String(item.id) === String(targetId));
  if (targetIndex < 0) return;
  if (insertAfter && targetId !== null) targetIndex++;
  pinnedPlaylists.splice(targetIndex, 0, playlist);

  let pinnedIndex = 0;
  state.playlists = state.playlists.map(item =>
    item.isPinned !== false ? pinnedPlaylists[pinnedIndex++] : item
  );
  persistPlaylists();
  renderPlaylistsUI();
}

